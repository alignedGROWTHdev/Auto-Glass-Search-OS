---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig, isConfigured } from '../data/siteData';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  noindex?: boolean;
}

const { 
  title, 
  description, 
  canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).href,
  ogType = "website",
  noindex = false
} = Astro.props;

const contactPoint = isConfigured(siteConfig.placeholders.phone) ? {
  "@type": "ContactPoint",
  "telephone": siteConfig.placeholders.phone,
  "contactType": "customer service"
} : undefined;

const breadcrumb = Astro.url.pathname !== "/" ? {
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Auto Glass Search OS",
      "item": siteConfig.siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": title.split("|")[0].trim(),
      "item": canonical
    }
  ]
} : undefined;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://autoglasssearchos.com/#organization",
      "name": siteConfig.name,
      "alternateName": "Auto Glass Search OS",
      "url": siteConfig.siteUrl,
      "description": siteConfig.description,
      "areaServed": {
        "@type": "Country",
        "name": "United States"
      },
      "knowsAbout": [
        "Auto Glass Search Strategy",
        "Windshield Replacement SEO",
        "Google Maps 3-Pack Optimization",
        "ADAS Camera Recalibration Visibility",
        "Auto Glass Paid Search and Google Ads",
        "AI-Assisted Search Operations",
        "Search Workflow Design and Governance"
      ],
      ...(contactPoint ? { "contactPoint": contactPoint } : {})
    },
    {
      "@type": "WebSite",
      "@id": "https://autoglasssearchos.com/#website",
      "url": siteConfig.siteUrl,
      "name": siteConfig.name,
      "description": siteConfig.tagline,
      "publisher": {
        "@id": "https://autoglasssearchos.com/#organization"
      }
    },
    ...(breadcrumb ? [breadcrumb] : [])
  ]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] btn btn--primary btn--sm">
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      const emitAnalyticsEvent = (eventName: string, detail: Record<string, string> = {}) => {
        const payload = { event: eventName, page_path: window.location.pathname, ...detail };
        window.dispatchEvent(new CustomEvent('agos:analytics', { detail: payload }));
        const analyticsWindow = window as typeof window & { dataLayer?: Record<string, string>[] };
        analyticsWindow.dataLayer?.push(payload);
      };

      document.addEventListener('click', (event) => {
        const target = (event.target as HTMLElement).closest<HTMLElement>('[data-analytics-event]');
        if (!target) return;
        emitAnalyticsEvent(target.dataset.analyticsEvent || 'interaction', {
          link_url: target instanceof HTMLAnchorElement ? target.href : '',
          link_text: target.textContent?.trim() || ''
        });
      });

      document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
        let started = false;
        form.addEventListener('focusin', () => {
          if (started) return;
          started = true;
          emitAnalyticsEvent('visibility_analysis_form_start');
        });
      });

      if (window.location.pathname.startsWith('/thank-you')) {
        emitAnalyticsEvent('thank_you_visit');
      }
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  /* Layout structure */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    font-family: var(--font-sans);
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
  }

  main {
    flex: 1;
  }

  /* Screen-reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .focus\:not-sr-only:focus {
    position: fixed;
    width: auto;
    height: auto;
    padding: revert;
    margin: revert;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
</style>
