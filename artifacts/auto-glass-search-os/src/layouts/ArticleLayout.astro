---
/**
 * ArticleLayout — owner guides under /resources/<slug>/.
 * Provides: navy title band with dates and author, prose column, "In this guide" contents,
 * related service link, closing CTA, and Article + (optional) FAQ schema.
 *
 * Usage:
 *   <ArticleLayout meta={articles.find(a => a.slug === "...")!} faqs={faqs} toc={[{id,label},...]}>
 *     ...content with <h2 id="...">...
 *   </ArticleLayout>
 */
import BaseLayout from './BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { articleSchema, faqSchema } from '../data/schema';
import { siteConfig, channelPages } from '../data/siteData';
import type { ArticleMeta } from '../data/articles';
import type { FaqItem } from '../components/FaqSection.astro';

interface Props {
  meta: ArticleMeta;
  faqs?: FaqItem[];
  toc?: { id: string; label: string }[];
  ogImage?: string;
}
const { meta, faqs = [], toc = [], ogImage } = Astro.props;
const pagePath = `/resources/${meta.slug}/`;
const fmt = (d: string) => new Date(d + "T12:00:00Z").toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const money = channelPages.find((c) => c.href === meta.moneyPage);
const extraSchema = [
  articleSchema({ pagePath, headline: meta.title, description: meta.description, datePublished: meta.published, dateModified: meta.reviewed ?? meta.published, keywords: meta.keywords, image: ogImage }),
  ...(faqs.length ? [faqSchema(faqs, pagePath)] : []),
];
---

<BaseLayout title={meta.seoTitle} description={meta.description} breadcrumbName={meta.title} ogType="article" ogImage={ogImage} extraSchema={extraSchema}>

  <header class="article-hero page-hero">
    <div class="container">
      <div class="article-hero__inner">
        <a href="/resources/" class="article-hero__crumb">Owner resources</a>
        <h1 class="article-hero__title text-balance">{meta.title}</h1>
        <p class="article-hero__desc">{meta.description}</p>
        <p class="article-hero__meta">
          By <a href="/about/">{siteConfig.entity.founderName}</a>, founder · Published {fmt(meta.published)}{meta.reviewed && meta.reviewed !== meta.published && <> · Reviewed {fmt(meta.reviewed)}</>} · {meta.readMinutes} min read
        </p>
        <p class="article-hero__qualifier">Written for auto glass business owners and managers — not a consumer repair guide.</p>
      </div>
    </div>
  </header>

  <div class="article-body">
    <div class="container article-grid">
      {toc.length > 0 && (
        <aside class="article-toc" aria-label="In this guide">
          <p class="article-toc__label">In this guide</p>
          <ol class="article-toc__list">
            {toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
          </ol>
          {money && (
            <div class="article-toc__money">
              <p class="article-toc__label">Related service</p>
              <a href={money.href}>{money.title} →</a>
            </div>
          )}
        </aside>
      )}
      <article class="article-prose">
        <slot />
      </article>
    </div>
  </div>

  {faqs.length > 0 && <FaqSection id="article-faq" heading="Questions owners ask" items={faqs} />}

  <ClosingCta
    id="article-cta"
    heading="See where your shop stands on this today."
    description="We review your market by hand and send a recorded video walkthrough of what we found and what to fix first. Free, no sales call required."
    ctaLabel={siteConfig.primaryCta}
  />
</BaseLayout>

<style>
  .article-hero { padding: 3rem 0 2.5rem; }
  .article-hero__inner { max-width: 52rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .article-hero__crumb { font-size: 0.875rem; font-weight: 600; color: var(--laser-cyan); text-decoration: none; }
  .article-hero__title { font-size: clamp(2rem, 3.4vw + 0.5rem, 3rem); line-height: 1.06; letter-spacing: -0.025em; margin: 0; }
  .article-hero__desc { font-size: 1.125rem; color: var(--text-secondary); line-height: 1.6; margin: 0; }
  .article-hero__meta { font-size: 0.875rem; color: var(--text-tertiary); margin: 0.25rem 0 0; }
  .article-hero__meta a { color: var(--text-secondary); }
  .article-hero__qualifier { font-size: 0.875rem; color: var(--text-tertiary); margin: 0; }

  .article-body { padding: 3rem 0 2rem; }
  .article-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
  @media (min-width: 1024px) { .article-grid { grid-template-columns: 16rem minmax(0, 46rem); gap: 4rem; } }

  .article-toc { position: sticky; top: 6rem; align-self: start; font-size: 0.9375rem; }
  .article-toc__label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-tertiary); margin: 0 0 0.5rem; }
  .article-toc__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .article-toc__list a { color: var(--text-secondary); text-decoration: none; }
  .article-toc__list a:hover { color: var(--laser-cyan); }
  .article-toc__money { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .article-toc__money a { font-weight: 600; text-decoration: none; }

  .article-prose { font-size: 1.0625rem; line-height: 1.7; color: var(--text-secondary); }
  .article-prose :global(h2) { font-size: clamp(1.5rem, 2vw + 0.5rem, 1.875rem); color: var(--text-primary); margin: 2.25rem 0 0.75rem; scroll-margin-top: 6rem; }
  .article-prose :global(h3) { font-size: 1.1875rem; color: var(--text-primary); margin: 1.5rem 0 0.5rem; }
  .article-prose :global(p) { margin: 0 0 1rem; }
  .article-prose :global(ul), .article-prose :global(ol) { margin: 0 0 1rem 1.25rem; padding: 0; }
  .article-prose :global(li) { margin-bottom: 0.375rem; }
  .article-prose :global(strong) { color: var(--text-primary); }
  .article-prose :global(a) { color: var(--laser-cyan); }
  .article-prose :global(.answer-box) { margin: 1.25rem 0 1.5rem; padding: 1rem 1.25rem; border-left: 3px solid var(--laser-cyan); background: var(--carbon-slate); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; color: var(--text-primary); }
  .article-prose :global(.answer-box p:last-child) { margin: 0; }
  .article-prose :global(table) { width: 100%; border-collapse: collapse; font-size: 0.9375rem; margin: 1rem 0 1.5rem; }
  .article-prose :global(th), .article-prose :global(td) { text-align: left; padding: 0.625rem 0.75rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  .article-prose :global(th) { color: var(--text-tertiary); font-size: 0.8125rem; font-family: var(--font-display); }
  .article-prose :global(.table-scroll) { overflow-x: auto; }
</style>
