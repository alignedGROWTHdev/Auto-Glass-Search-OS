---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteData';

const pageTitle = "Terms of Use | Auto Glass Growth";
const pageDescription = "Terms governing use of the Auto Glass Growth website and requests for visibility audits and marketing information.";
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbName="Terms of Use">
  <section class="legal" aria-labelledby="terms-heading">
    <div class="container">
      <div class="legal__inner">
        <header class="legal__header">
          <h1 id="terms-heading">Terms of Use</h1>
          <p class="legal__meta">
            Effective Date: {new Date().getFullYear()} &middot; Auto Glass Growth (Aligned Growth Digital)
          </p>
        </header>

        <div class="legal__body">
          <section aria-labelledby="terms-s1">
            <h2 id="terms-s1">1. Acceptance of These Terms</h2>
            <p>
              By using this website, you agree to these Terms of Use. If you do not agree, please do not use the website or submit its forms.
            </p>
          </section>

          <section aria-labelledby="terms-s2">
            <h2 id="terms-s2">2. Website Information</h2>
            <p>
              This website provides general information about search growth, websites, lead generation and AI systems for auto glass businesses. Content is provided for informational purposes and does not guarantee rankings, lead volume, revenue or other business results.
            </p>
          </section>

          <section aria-labelledby="terms-s3">
            <h2 id="terms-s3">3. Visibility Audit Requests</h2>
            <p>
              Submitting a visibility audit or contact form authorizes us to review the business information you provide and contact you about your request. A form submission does not create a client, partnership, fiduciary or other professional relationship. Any paid engagement requires a separate written agreement.
            </p>
          </section>

          <section aria-labelledby="terms-s4">
            <h2 id="terms-s4">4. Acceptable Use</h2>
            <p>
              You may not misuse this website, interfere with its operation, attempt unauthorized access, submit unlawful or misleading information, or use automated systems to abuse its forms or services.
            </p>
          </section>

          <section aria-labelledby="terms-s5">
            <h2 id="terms-s5">5. Intellectual Property</h2>
            <p>
              Unless otherwise stated, the website’s original text, branding, graphics and presentation are owned by Aligned Growth Digital or used with permission. You may not reproduce or commercially exploit them without prior written permission.
            </p>
          </section>

          <section aria-labelledby="terms-s6">
            <h2 id="terms-s6">6. Third-Party Services and Links</h2>
            <p>
              The website may use or link to third-party services. Those services operate under their own terms and privacy practices, and we are not responsible for third-party websites or services outside our control.
            </p>
          </section>

          <section aria-labelledby="terms-s7">
            <h2 id="terms-s7">7. Disclaimer and Limitation</h2>
            <p>
              The website is provided on an “as available” basis. To the extent permitted by law, we disclaim implied warranties and are not liable for indirect, incidental or consequential losses arising from use of, or inability to use, the website.
            </p>
          </section>

          <section aria-labelledby="terms-s8">
            <h2 id="terms-s8">8. Changes and Contact</h2>
            <p>
              We may update these terms by posting a revised version on this page. Questions may be directed to <a href={`mailto:${siteConfig.placeholders.email}`}>{siteConfig.placeholders.email}</a> or <a href={`tel:${siteConfig.placeholders.phone.replace(/[^\d+]/g, '')}`}>{siteConfig.placeholders.phone}</a>.
            </p>
          </section>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    padding: 5rem 0;
    background-color: var(--surface-00);
  }

  .legal__inner {
    max-width: var(--container-prose);
  }

  .legal__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .legal__header h1 {
    margin: 0;
  }

  .legal__meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    letter-spacing: 0.04em;
  }

  .legal__body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.75;
  }

  .legal__body section {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .legal__body h2 {
    margin: 0;
    color: var(--text-primary);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .legal__body p {
    margin: 0;
  }
</style>