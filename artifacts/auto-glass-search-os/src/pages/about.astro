---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteData';
import BrandMark from '../components/BrandMark.astro';

const pageTitle = "About Auto Glass Search OS | Founder Valentina Borda";
const pageDescription = "Learn about Auto Glass Search OS and founder Valentina Borda. Dedicated search and customer acquisition for established auto glass companies, under Aligned Growth Digital.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- Hero -->
  <section class="page-hero" aria-labelledby="about-heading">
    <div class="container">
      <div class="page-hero__content">
        <div class="page-hero__eyebrow-wrap">
          <span class="agos-brandmark" aria-hidden="true">
            <BrandMark size={20} />
          </span>
          <span class="eyebrow">Built From Real Search Experience</span>
        </div>
        <h1 id="about-heading" class="text-balance">
          About Auto Glass Search OS &amp; Founder Valentina Borda.
        </h1>
        <p class="page-hero__lead">
          Auto Glass Search OS is a specialized search and customer-acquisition company for auto glass businesses, founded by Valentina Borda under Aligned Growth Digital.
        </p>
      </div>
    </div>
  </section>

  <!-- Founder section -->
  <section class="section section--alt" aria-labelledby="why-ded-heading">
    <div class="container">
      <div class="about-grid">

        <!-- Sidebar card -->
        <aside class="founder-card glass-panel" aria-label="Founder profile">
          <div class="founder-card__avatar" aria-label="VB monogram" aria-hidden="true">VB</div>
          <div>
            <p class="founder-card__name">{siteConfig.founder}</p>
            <p class="founder-card__role eyebrow eyebrow--blue">{siteConfig.founderTitle}</p>
            <p class="founder-card__org eyebrow eyebrow--slate">{siteConfig.legalParent}</p>
          </div>
          <ul class="founder-card__credentials" role="list">
            <li class="check-item">10+ years across SEO, digital growth, eCommerce, and marketing strategy</li>
            <li class="check-item">Direct auto glass search experience</li>
            <li class="check-item">Specialist in high-intent local search and search-to-dispatch workflows</li>
          </ul>

          <div class="founder-card__contact">
            <a href="mailto:valentina@alignedgrowthdigital.com" data-analytics-event="email_click" class="founder-contact-link">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="1" y="2.5" width="10" height="7" rx="1.2" stroke="currentColor" stroke-width="1.2"/>
                <path d="M1 4l5 3.5L11 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              </svg>
              valentina@alignedgrowthdigital.com
            </a>
            <a href="tel:+15165211149" data-analytics-event="phone_click" class="founder-contact-link">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M2.5 1h2.5l1.25 3-1.75 1.25A6.5 6.5 0 0 0 7.75 8L9 6.25 12 7.5V10a.85.85 0 0 1-.85.85A9.5 9.5 0 0 1 1.15 1.85.85.85 0 0 1 2 1z" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              (516) 521-1149
            </a>
          </div>
        </aside>

        <!-- Body -->
        <div class="about-body">
          <h2 id="why-ded-heading">
            Specialized search. Built for auto glass.
          </h2>

          <p>
            Valentina Borda has 10+ years of experience across SEO, digital growth, eCommerce, and marketing strategy.
          </p>

          <p>
            Through direct work in auto glass search, she observed how fragmented customer acquisition had become: organic local search managed separately from Google Maps, paid search disconnected from call routing, AI search emerging with no clear operator strategy, and measurement rarely tied to actual booked jobs.
          </p>

          <p>
            Auto Glass Search OS was created under Aligned Growth Digital to connect those elements around one clear objective: turn search visibility into qualified leads and booked auto glass jobs. The approach covers high-intent paid search, organic local search, Google Maps, AI-assisted search, call routing to shop dispatchers, optional AI Voice CSR technology for after-hours and overflow coverage, and measurement tied to operational outcomes.
          </p>

          <p>
            AI now lets marketing teams accomplish more internally — but operators still need strategy, specialized systems, quality control, and domain expertise. That is why the engagement model supports both fully managed execution and team-enabled search systems where your team runs the operation with ongoing strategic support.
          </p>

          <div class="about-standards" role="note">
            <p>
              <strong class="about-standards__label">A straightforward operating standard:</strong>
              We do not publish fabricated client logos, invented performance claims, or unverifiable case studies. Measurement focuses on qualified calls, quote requests, and booked jobs where reliable data is available. Scope and approach are confirmed directly with every operator before any engagement begins.
            </p>
          </div>

          <div class="about-cta">
            <a href="/visibility-analysis/" data-analytics-event="primary_cta_click" class="btn btn--primary">
              Request a Visibility Analysis
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding-top: 4.5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(0,210,255,0.08);
    background-color: var(--obsidian);
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background: radial-gradient(ellipse at 80% 30%, rgba(30,64,175,0.08) 0%, transparent 65%);
    pointer-events: none;
  }

  .page-hero__content {
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
  }

  .page-hero__eyebrow-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .page-hero__lead {
    font-size: clamp(1rem, 1.25vw + 0.25rem, 1.125rem);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 42rem;
  }

  .section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    background-color: var(--obsidian);
  }

  .section--alt {
    background-color: var(--carbon-slate);
  }

  /* About layout */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: 19rem 1fr;
    }
  }

  /* Founder card */
  .founder-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: sticky;
    top: 5.5rem;
  }

  .founder-card__avatar {
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background-color: rgba(0, 210, 255, 0.08);
    border: 1px solid rgba(0, 210, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--laser-cyan);
    letter-spacing: 0.05em;
    box-shadow: 0 0 20px rgba(0, 210, 255, 0.1);
  }

  .founder-card__name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.375rem;
  }

  .founder-card__role,
  .founder-card__org {
    display: block;
    margin: 0;
    line-height: 1.7;
  }

  .founder-card__credentials {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid rgba(255,255,255,0.06);
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .founder-card__contact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .founder-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-tertiary);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color var(--transition-fast);
  }

  .founder-contact-link:hover {
    color: var(--laser-cyan);
  }

  .founder-contact-link svg {
    color: var(--laser-cyan);
    flex-shrink: 0;
  }

  /* About body */
  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.75;
  }

  .about-body h2 {
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
  }

  .about-standards {
    background-color: var(--carbon-slate-2);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    font-size: 0.875rem;
    color: var(--text-tertiary);
    line-height: 1.7;
  }

  .about-standards__label {
    color: var(--text-primary);
    font-weight: 600;
  }

  .about-cta {
    padding-top: 0.5rem;
  }
</style>
