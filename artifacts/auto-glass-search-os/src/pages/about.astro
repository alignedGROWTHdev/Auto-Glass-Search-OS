---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteData';

const pageTitle = "About Auto Glass Search OS | Founder Valentina Borda";
const pageDescription = "Learn about Auto Glass Search OS and founder Valentina Borda. Dedicated search operating systems for established auto glass companies under Aligned Growth Digital.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- Hero -->
  <section class="page-hero" aria-labelledby="about-heading">
    <div class="container">
      <div class="page-hero__content">
        <span class="eyebrow">Leadership &amp; Entity Governance</span>
        <h1 id="about-heading" class="text-balance">
          About Auto Glass Search OS &amp; Founder Valentina Borda.
        </h1>
        <p class="page-hero__lead">
          Auto Glass Search OS is a specialized vertical search and customer acquisition company founded by Valentina Borda under parent organization Aligned Growth Digital.
        </p>
      </div>
    </div>
  </section>

  <!-- Founder section -->
  <section class="section section--alt" aria-labelledby="why-ded-heading">
    <div class="container">
      <div class="about-grid">

        <!-- Sidebar card -->
        <aside class="founder-card" aria-label="Founder profile">
          <div class="founder-card__avatar" aria-hidden="true">VB</div>
          <div>
            <p class="founder-card__name">{siteConfig.founder}</p>
            <p class="founder-card__role eyebrow eyebrow--blue">Founder &amp; Managing Principal</p>
            <p class="founder-card__org eyebrow eyebrow--slate">{siteConfig.legalParent}</p>
          </div>
          <ul class="founder-card__credentials" role="list">
            <li class="check-item">10+ Years Digital Search &amp; Growth Strategy</li>
            <li class="check-item">Competitive Local Search Experience</li>
            <li class="check-item">Direct Auto Glass Search Strategy Experience</li>
          </ul>
        </aside>

        <!-- Body -->
        <div class="about-body">
          <h2 id="why-ded-heading">
            Why auto glass needs a dedicated operating system.
          </h2>

          <p>
            Valentina Borda has more than a decade of professional experience leading high-stakes digital growth, SEO architecture, eCommerce systems, and organic acquisition in highly competitive commercial environments.
          </p>

          <p>
            Through direct work on auto glass search initiatives, she saw the need for a more coordinated approach — one that connects technical foundations, local visibility, content, AI-assisted workflows, paid search, conversion paths, and measurement around the way auto glass customers actually search.
          </p>

          <p>
            Auto Glass Search OS was created under Aligned Growth Digital to provide that structure. It combines senior search expertise, implemented systems, AI-enabled workflows, human quality assurance, and ongoing strategy for the operating realities of windshield replacement, repair, ADAS recalibration, shop service, and mobile dispatch.
          </p>

          <div class="about-standards" role="note">
            <p>
              <strong class="about-standards__label">Proof &amp; accuracy standards:</strong>
              We do not publish fabricated client logos, case studies, credentials, or performance claims. Measurement prioritizes qualified calls, quote requests, booked jobs, and market outcomes when reliable client data is available.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background-color: var(--surface-00);
  }

  .page-hero__content {
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .page-hero__lead {
    font-size: clamp(1rem, 1.5vw + 0.25rem, 1.1875rem);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 42rem;
  }

  .section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background-color: var(--surface-00);
  }

  .section--alt {
    background-color: var(--surface-01);
  }

  /* About layout */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: 18rem 1fr;
    }
  }

  /* Founder card */
  .founder-card {
    background-color: var(--surface-02);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .founder-card__avatar {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background-color: rgba(49, 130, 246, 0.15);
    border: 1px solid rgba(49, 130, 246, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--blue);
    letter-spacing: 0.05em;
  }

  .founder-card__name {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.375rem;
  }

  .founder-card__role,
  .founder-card__org {
    display: block;
    margin: 0;
    line-height: 1.6;
  }

  .founder-card__credentials {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid rgba(255,255,255,0.07);
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* About body */
  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.75;
  }

  .about-body h2 {
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .about-standards {
    background-color: var(--surface-02);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    font-size: 0.875rem;
    color: var(--text-tertiary);
    line-height: 1.7;
  }

  .about-standards__label {
    color: var(--text-primary);
    font-weight: 600;
  }
</style>
