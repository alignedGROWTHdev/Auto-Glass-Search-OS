---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';

const pageTitle = "About Auto Glass Search OS | Search Strategy for Auto Glass";
const pageDescription = "Learn how Auto Glass Search OS helps established auto glass operators turn search visibility into qualified leads and booked jobs.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- Hero -->
  <section class="page-hero" aria-labelledby="about-heading">
    <div class="container">
      <div class="page-hero__content">
        <div class="page-hero__eyebrow-wrap">
          <span class="agos-brandmark" aria-hidden="true">
            <BrandMark size={20} />
          </span>
          <span class="eyebrow">Search Strategy for Auto Glass Operators</span>
        </div>
        <h1 id="about-heading" class="text-balance">
          About Auto Glass Search OS.
        </h1>
        <p class="page-hero__lead">
          Auto Glass Search OS is a specialized search and customer-acquisition company built for established auto glass operators.
        </p>
      </div>
    </div>
  </section>

  <!-- Company perspective -->
  <section class="section section--alt" aria-labelledby="why-ded-heading">
    <div class="container">
      <div class="about-body">
          <h2 id="why-ded-heading">
            Specialized search. Built for auto glass.
          </h2>

          <p>
            Our team brings 10+ years of experience across search, digital growth, eCommerce, and marketing strategy.
          </p>

          <p>
            We work from an operating perspective: customer acquisition is not a collection of disconnected channels. Organic local search, Google Maps, paid search, AI-assisted search, call routing, and measurement all need to support the same outcome—qualified leads and booked auto glass jobs.
          </p>

          <p>
            For established auto glass operators, Auto Glass Search OS connects those elements around that clear objective. Our approach covers high-intent paid search, organic local search, Google Maps, AI-assisted search, call routing to shop dispatchers, optional AI Voice CSR technology for after-hours and overflow coverage, and measurement tied to operational outcomes.
          </p>

          <p>
            AI now lets marketing teams accomplish more internally—but operators still need strategy, specialized systems, quality control, and domain expertise. Our engagement model supports both fully managed execution and team-enabled search systems, so your team can run the operation with ongoing strategic support.
          </p>

          <div class="about-standards" role="note">
            <p>
              <strong class="about-standards__label">A straightforward operating standard:</strong>
              We do not publish fabricated client logos, invented performance claims, or unverifiable case studies. Measurement focuses on qualified calls, quote requests, and booked jobs where reliable data is available. Scope and approach are confirmed directly with every operator before any engagement begins.
            </p>
          </div>

          <div class="about-cta">
            <a href="/visibility-analysis/" data-analytics-event="primary_cta_click" class="btn btn--primary">
              Request a Visibility Analysis
            </a>
          </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding-top: 4.5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(0,210,255,0.08);
    background-color: var(--obsidian);
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background: radial-gradient(ellipse at 80% 30%, rgba(30,64,175,0.08) 0%, transparent 65%);
    pointer-events: none;
  }

  .page-hero__content {
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
  }

  .page-hero__eyebrow-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .page-hero__lead {
    font-size: clamp(1rem, 1.25vw + 0.25rem, 1.125rem);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 42rem;
  }

  .section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    background-color: var(--obsidian);
  }

  .section--alt {
    background-color: var(--carbon-slate);
  }

  /* About body */
  .about-body {
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.75;
  }

  .about-body h2 {
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
  }

  .about-standards {
    background-color: var(--carbon-slate-2);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    font-size: 0.875rem;
    color: var(--text-tertiary);
    line-height: 1.7;
  }

  .about-standards__label {
    color: var(--text-primary);
    font-weight: 600;
  }

  .about-cta {
    padding-top: 0.5rem;
  }
</style>
