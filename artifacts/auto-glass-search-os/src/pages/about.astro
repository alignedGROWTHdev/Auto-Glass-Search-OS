---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteData';

const pageTitle = "About Auto Glass Search OS | Founder Valentina Borda";
const pageDescription = "Learn about Auto Glass Search OS and founder Valentina Borda. Dedicated search operating systems for established auto glass companies under Aligned Growth Digital.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="py-20 border-b border-white/10 bg-[#0A0E18]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-blue-950/80 border border-blue-500/30 text-xs font-mono text-blue-400">
        LEADERSHIP & ENTITY GOVERNANCE
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white font-heading">
        ABOUT AUTO GLASS SEARCH OS & <br />
        FOUNDER VALENTINA BORDA.
      </h1>
      <p class="text-lg text-slate-300 max-w-3xl leading-relaxed">
        Auto Glass Search OS is a specialized vertical search and customer acquisition company founded by Valentina Borda under parent organization Aligned Growth Digital.
      </p>
    </div>
  </section>

  <section class="py-20 border-b border-white/10 bg-[#0C1220]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start text-left">
        <div class="md:col-span-5 space-y-4">
          <div class="p-6 rounded-xl bg-[#0F1628] border border-white/10 space-y-4">
            <div class="w-14 h-14 rounded-full bg-blue-600/30 border border-blue-400 flex items-center justify-center text-blue-300 font-heading font-bold text-xl">
              VB
            </div>
            <div>
              <h2 class="text-xl font-bold text-white font-heading">{siteConfig.founder}</h2>
              <p class="text-xs font-mono text-blue-400">Founder & Managing Principal</p>
              <p class="text-xs font-mono text-slate-400">{siteConfig.legalParent}</p>
            </div>
            <div class="pt-4 border-t border-white/10 text-xs text-slate-300 space-y-2 font-mono">
              <p>• 10+ Years Digital Search & Growth Strategy</p>
               <p>• Competitive Local Search Experience</p>
               <p>• Direct Auto Glass Search Strategy Experience</p>
            </div>
          </div>
        </div>

        <div class="md:col-span-7 space-y-6 text-sm text-slate-300 leading-relaxed">
          <h3 class="text-2xl font-bold text-white font-heading">
            Why Auto Glass Needs a Dedicated Operating System
          </h3>
          <p>
            Valentina Borda has more than a decade of professional experience leading high-stakes digital growth, SEO architecture, eCommerce systems, and organic acquisition in highly competitive commercial environments.
          </p>
          <p>
            Through direct work on auto glass search initiatives, she saw the need for a more coordinated approach—one that connects technical foundations, local visibility, content, AI-assisted workflows, paid search, conversion paths, and measurement around the way auto glass customers actually search.
          </p>
          <p>
            Auto Glass Search OS was created under Aligned Growth Digital to provide that structure. It combines senior search expertise, implemented systems, AI-enabled workflows, human quality assurance, and ongoing strategy for the operating realities of windshield replacement, repair, ADAS recalibration, shop service, and mobile dispatch.
          </p>
          <div class="p-4 rounded-lg bg-[#0B101C] border border-white/10 text-xs font-mono text-slate-400">
            <span class="text-white font-semibold">Proof & accuracy standards:</span> We do not publish fabricated client logos, case studies, credentials, or performance claims. Measurement prioritizes qualified calls, quote requests, booked jobs, and market outcomes when reliable client data is available.
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
