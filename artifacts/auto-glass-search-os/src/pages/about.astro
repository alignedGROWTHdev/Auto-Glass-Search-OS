---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { siteConfig, channelPages } from '../data/siteData';

const pageTitle = "About Auto Glass Growth & Valentina Borda";
const pageDescription = "Auto Glass Growth is a specialized auto glass marketing, websites and lead generation initiative from Aligned Growth Digital, led by founder Valentina Borda.";

const aboutSchema = [
  {
    "@type": "AboutPage",
    "@id": new URL("/about/", siteConfig.siteUrl).href + "#aboutpage",
    "url": new URL("/about/", siteConfig.siteUrl).href,
    "name": pageTitle,
    "about": { "@id": siteConfig.entity.organizationId },
    "mainEntity": { "@id": siteConfig.entity.founderId },
  },
];

const systemPages = [
  {
    href: "/auto-glass-lead-generation/",
    title: "Auto Glass Lead Generation",
    description: "How the channels connect into one owned customer-acquisition system.",
  },
  ...channelPages,
];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbName="About" extraSchema={aboutSchema}>

  <!-- Hero -->
  <section class="page-hero" aria-labelledby="about-heading">
    <div class="container">
      <div class="page-hero__content">
        <div class="page-hero__eyebrow-wrap">
          <span class="agos-brandmark" aria-hidden="true">
            <BrandMark size={20} />
          </span>
          <span class="eyebrow">{siteConfig.category}</span>
        </div>
        <h1 id="about-heading" class="text-balance">
          About Auto Glass Growth and Valentina Borda
        </h1>
        <p class="page-hero__lead">
          {siteConfig.legalStatement} Led by founder Valentina Borda, it exists to help established auto glass companies capture more of the customer demand already happening in their markets and turn it into qualified calls, quote requests and booked jobs.
        </p>
      </div>
    </div>
  </section>

  <!-- Company perspective -->
  <section class="section section--alt" aria-labelledby="why-ded-heading">
    <div class="container">
      <div class="about-body">
          <h2 id="principle-heading">
            A simple principle
          </h2>

          <p>
            Auto Glass Growth is built around one idea: <strong>more traffic isn't the goal. More of the right customer demand turning into business is.</strong> Rankings, impressions and clicks are inputs. A driver with a cracked windshield in your service area who calls or requests a quote — and becomes a booked job — is the output everything is measured against.
          </p>

          <h2 id="why-ded-heading">
            Why a marketing practice built only around auto glass
          </h2>

          <p>
            Auto glass demand behaves unlike most local services. It is urgent, it is decided on a phone within minutes, it is shaped by insurance rules that differ by state, and it has been changed by ADAS calibration requirements on nearly every new vehicle. A generic marketing agency treats an auto glass shop like any other local business. That is where operators lose demand: to the shop that showed up first in Google Maps, answered the insurance question on its website, or was the only one that clearly said it recalibrates cameras.
          </p>

          <p>
            Auto Glass Growth was created as a dedicated initiative for that problem. It is a specialized auto glass growth initiative from Aligned Growth Digital rather than a separate agency, which means the auto glass work draws on a broader search and digital growth practice while staying focused on one industry's customers, searches and economics. The services are auto glass SEO, local SEO and Google Maps, Google Ads, websites, conversion optimization, AI search visibility, and analytics and measurement.
          </p>

          <h2 id="founder-heading">
            <span id="valentina-borda">Valentina Borda, founder</span>
          </h2>

          <p>
            Valentina Borda founded Aligned Growth Digital and leads Auto Glass Growth. Her background spans more than ten years across search, digital growth, eCommerce and marketing strategy. She works directly with each operator: the opportunity analysis, the strategy, and the quality control on what gets published or deployed are hers.
          </p>

          <p>
            Her operating view is simple: customer acquisition is not a collection of disconnected channels. Organic search, Google Maps, Google Ads, AI-assisted search, website conversion, and measurement all have to support the same outcome — qualified leads and booked auto glass jobs — or they end up competing for budget and hiding what actually works.
          </p>

          <h2 id="system-heading">
            The Auto Glass Growth OS
          </h2>

          <p>
            The Growth OS is our methodology — not software, not a platform, nothing a customer logs into. It is the framework we use to connect marketing, conversion and measurement into one customer-acquisition system: <strong>Found</strong> (capture high-intent demand through SEO, Google Maps, Google Ads and AI search visibility), <strong>Trusted</strong> (give customers reasons to choose you through the website, reviews, authority and clear service information), <strong>Chosen</strong> (reduce friction between intent and action through website CRO, landing pages, call pathways and quote-request UX), and <strong>Measured</strong> (understand which marketing activity creates qualified leads, appointments and booked jobs).
          </p>

          <p>
            Each channel reaches a driver at a different moment, and every one of them converts on the same website. When SEO, Local SEO, Google Ads, the website and conversion are handled by different vendors or treated as isolated tactics, the service pages built for organic never become the paid landing pages, the Google Business Profile drifts out of sync with the site, and no one can say what a qualified lead costs across the whole system. Connecting them means one set of business facts, one set of landing pages, one measurement model from search to booked job.
          </p>

          <h2 id="partners-heading">
            Where we recommend partners instead
          </h2>

          <p>
            When a growth bottleneck falls outside our core marketing and conversion services — for example, customers can't easily get a quote, find availability or receive a timely response — we may recommend specialized auto glass technology providers rather than pretending to build everything ourselves. Online quoting, scheduling and AI-assisted call handling are provided and supported separately by those third-party providers; we don't sell, own or operate them. Knowing when that kind of technology makes sense, and when the problem is really the website or the marketing, is part of understanding the auto glass customer-acquisition ecosystem.
          </p>

          <p>
            AI now lets marketing teams accomplish more internally, but operators still need strategy, quality control and domain expertise. The engagement model supports both fully managed execution and building the Growth OS with your team so your people can run it with ongoing strategic support.
          </p>

          <div class="about-standards" role="note">
            <p>
              <strong class="about-standards__label">A straightforward operating standard:</strong>
              We do not publish fabricated client logos, invented performance claims, or unverifiable case studies. Measurement focuses on qualified calls, quote requests, and booked jobs where reliable data is available. Scope and approach are confirmed directly with every operator before any engagement begins.
            </p>
          </div>

          <div class="about-cta">
            <a href="/visibility-analysis/" data-analytics-event="primary_cta_click" class="btn btn--primary">
              See Where You're Losing Jobs
            </a>
          </div>
      </div>
    </div>
  </section>

  <RelatedLinks
    id="about-system"
    eyebrow="Auto Glass Growth services"
    heading="Auto glass lead generation and the services that feed it."
    links={systemPages}
  />

</BaseLayout>

<style>
  .page-hero {
    padding-top: 4.5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(0,210,255,0.08);
    background-color: var(--obsidian);
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background: radial-gradient(ellipse at 80% 30%, rgba(30,64,175,0.08) 0%, transparent 65%);
    pointer-events: none;
  }

  .page-hero__content {
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
  }

  .page-hero__eyebrow-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .page-hero__lead {
    font-size: clamp(1rem, 1.25vw + 0.25rem, 1.125rem);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 42rem;
  }

  .section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    background-color: var(--obsidian);
  }

  .section--alt {
    background-color: var(--carbon-slate);
  }

  /* About body */
  .about-body {
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.75;
  }

  .about-body h2 {
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.25;
  }

  .about-body h2:first-child {
    margin-top: 0;
  }

  .about-standards {
    background-color: var(--carbon-slate-2);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    font-size: 0.875rem;
    color: var(--text-tertiary);
    line-height: 1.7;
  }

  .about-standards__label {
    color: var(--text-primary);
    font-weight: 600;
  }

  .about-cta {
    padding-top: 0.5rem;
  }
</style>
