---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Auto Glass Google Ads | Paid Search for Glass Companies";
const pageDescription = "Paid search strategy and management for auto glass companies focused on relevant replacement, repair, recalibration, and mobile-service demand.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="py-20 border-b border-white/10 bg-[#0A0E18]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-blue-950/80 border border-blue-500/30 text-xs font-mono text-blue-400">
        PAID SEARCH & CALL DISPATCH (PPC)
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white font-heading">
        HIGH-INTENT GOOGLE ADS: <br />
        ALIGN PAID SEARCH WITH SERVICE DEMAND.
      </h1>
      <p class="text-lg text-slate-300 max-w-3xl leading-relaxed">
        Auto glass search terms can overlap with general repair, tinting, residential glass, parts, and do-it-yourself research. We structure campaigns around the services, markets, schedules, and conversion paths the operator can actually support.
      </p>
      <div class="pt-2">
        <a
          href="/visibility-analysis/"
          data-analytics-event="primary_cta_click"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs uppercase tracking-wider transition-all"
        >
          <span>Audit Your Current Paid Search Campaigns</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 border-b border-white/10 bg-[#0C1220]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
        <div class="p-6 rounded-xl bg-[#0F1628] border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white font-heading">Search-Term Controls</h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            Build and maintain negative-keyword controls for irrelevant categories such as detailing, window regulators, home glass, tinting, parts, and do-it-yourself research.
          </p>
        </div>
        <div class="p-6 rounded-xl bg-[#0F1628] border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white font-heading">Call & Local Conversion Paths</h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            Emergency windshield buyers want to speak with a dispatcher right now. We prioritize call assets, mobile click-to-call banners, and direct phone conversion paths during shop operating hours.
          </p>
        </div>
        <div class="p-6 rounded-xl bg-[#0F1628] border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white font-heading">Booked Job Unit Economics</h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            Where call, booking, and point-of-sale data are available, reporting can connect ad spend with qualified calls, quote requests, and booked jobs—not just clicks and impressions.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
