---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AnswerBlock from '../components/AnswerBlock.astro';
import CapabilityGrid from '../components/CapabilityGrid.astro';
import ProseSection from '../components/ProseSection.astro';
import FaqSection from '../components/FaqSection.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { faqSchema, serviceSchema } from '../data/schema';
import ConversionPaths from '../components/ConversionPaths.astro';
import PartnerCallout from '../components/PartnerCallout.astro';

const pagePath = "/google-ads/";
const pageTitle = "Auto Glass Google Ads & PPC Agency | Qualified Lead Generation";
const pageDescription = "Auto glass PPC agency. Google Ads built around qualified leads, not clicks: campaign architecture, negative keywords, call tracking and cost per qualified lead.";

const capabilities = [
  {
    title: "Relevant Search Terms",
    body: "Use search terms and negative keywords to reduce spend on irrelevant categories such as general repair, residential glass, tinting, parts, window regulators, and do-it-yourself research.",
  },
  {
    title: "Calls & Quote Requests",
    body: "Make it easy for urgent customers to call or request a quote, with ads and landing pages aligned to your hours, service availability, and preferred contact path.",
  },
  {
    title: "Cost Per Qualified Lead",
    body: "Where reliable tracking data is available, reporting connects ad spend with qualified calls, quote requests, booked jobs, and cost per qualified lead — not just clicks and impressions.",
  },
];

const faqs = [
  {
    question: "Does Google Ads work for auto glass companies?",
    answer: "Yes, when campaigns are built around real service demand and measured on qualified calls rather than clicks. Auto glass searches are urgent and high-intent, which is good for paid search, but they also overlap with residential glass, tint, parts, and DIY research, so negative keyword control and call tracking decide whether the account produces booked jobs or wasted spend.",
  },
  {
    question: "How much should an auto glass shop spend on Google Ads?",
    answer: "It depends on your markets, the services you want to grow, competition, and your capacity to answer calls. Rather than a fixed number, we work back from what a qualified lead and a booked job are worth to your shop and what the account is actually producing per dollar. Budgets are scaled up where the cost per qualified lead supports it and pulled back where it does not.",
  },
  {
    question: "What is a good cost per lead for auto glass Google Ads?",
    answer: "There is no universal benchmark, because a rock chip repair lead and a windshield replacement with ADAS calibration lead are worth very different amounts. What matters is your cost per qualified lead by service and market, and where booking data is available, your cost per booked job. We report those numbers rather than quoting an industry average.",
  },
  {
    question: "Why do we get calls for house windows and window regulators?",
    answer: "Because Google matches auto glass ads to a wide range of glass and window searches unless the account actively excludes them. Residential glass, shower doors, tint, window regulators, parts, and DIY searches are common leaks. A well-maintained negative keyword list and tight match types stop most of it; ongoing search term review catches the rest.",
  },
  {
    question: "Should we run ads only during business hours?",
    answer: "Usually calls should be scheduled around when someone can answer, because an unanswered urgent call is a lead lost to the next result. If you have after-hours coverage — a dispatcher, an answering service, or an online quote path that gets a fast response — ads can run wider. We align schedules and campaign types with how your shop actually handles intake.",
  },
  {
    question: "How does Google Ads fit with SEO and Google Maps?",
    answer: "Google Ads captures existing demand immediately while organic and Maps visibility build, and it lets you target specific services and markets precisely. The landing pages built for SEO make paid clicks convert better, and strong organic and Maps presence lowers your dependence on paid over time. We manage them as one lead generation system with a shared view of cost per qualified lead.",
  },
];

const extraSchema = [
  serviceSchema({
    pagePath,
    name: "Google Ads for Auto Glass Companies",
    serviceType: "Paid search (PPC) management for auto glass companies",
    description: pageDescription,
    alternateName: ["Auto Glass PPC Agency", "Auto Glass Advertising"],
  }),
  faqSchema(faqs, pagePath),
];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbName="Google Ads for Auto Glass" extraSchema={extraSchema}>

  <PageHero
    id="google-ads"
    eyebrow="Paid Search for Auto Glass"
    heading="Google Ads for Auto Glass Companies Built Around Qualified Leads"
    lead="'Glass' searches also mean shower doors, tint, parts and DIY. We build your campaigns around the services and areas you can actually serve, drive calls directly to your shop, and measure spend against real leads and booked jobs — not clicks."
    ctaLabel="Get My Free Google Ads Audit"
    supportLine="Free · Manually reviewed · Video walkthrough, no sales call required"
  />

  <AnswerBlock id="ads-answer">
    Google Ads for auto glass companies works when campaigns are built around calls, not clicks: one campaign per service and market, ads that run when someone can answer the phone, a landing page with tap-to-call at the top, and a negative keyword list that removes tint, shower doors, parts and job seekers. The measure is cost per qualified lead by service — and where booking data allows, cost per booked job.
  </AnswerBlock>

  <CapabilityGrid id="ads-capabilities" heading="What auto glass Google Ads management covers" eyebrow="Core capabilities" cards={capabilities} />

  <ProseSection id="ads-objective" eyebrow="The objective" heading="Clicks are not the business objective. Qualified customer opportunities are.">
    <p>
      A Google Ads account can look healthy — lots of clicks, cheap clicks, plenty of "conversions" — while sending you calls from people who want shower doors, tint or a window regulator. For an auto glass shop, the only numbers that matter are real calls, quote requests, booked jobs, and what each one cost. Everything in the account is built and judged against those.
    </p>
    <p>
      Ads don't create windshield demand; the driver already has the crack. What ads do is put your shop in front of that driver today, for the exact services and areas you choose, while <a href="/auto-glass-seo/">organic search</a> and <a href="/auto-glass-local-seo/">Google Maps</a> build. That makes ads the fastest lever in <a href="/auto-glass-lead-generation/">auto glass lead generation</a> — and the easiest one to waste.
    </p>
  </ProseSection>

  <ProseSection id="campaign-architecture" eyebrow="Campaign architecture" heading="Campaigns built around how auto glass demand actually breaks down" alt>
    <p>
      Lumping every glass search into one campaign hides where the money goes. We separate demand so budget, bids, and messaging can follow value:
    </p>
    <ul class="prose-grid">
      <li><strong>Windshield replacement</strong> The core campaign, usually with the highest value per lead and its own ad copy and landing page.</li>
      <li><strong>Windshield and rock chip repair</strong> Lower ticket, high volume; often worth running with a controlled budget and repair-specific messaging.</li>
      <li><strong>Mobile auto glass</strong> "Mobile" and "come to me" searches with their own landing page explaining radius and scheduling.</li>
      <li><strong>ADAS calibration</strong> Growing demand from drivers and insurers, with messaging that states clearly what you calibrate and where.</li>
      <li><strong>Brand vs. non-brand</strong> Searches for your shop by name kept separate from generic searches, so reporting shows what paid search actually added.</li>
      <li><strong>Geographic targeting</strong> Campaigns or ad groups per market, matched to shop draw and mobile radius, so a driver two hours away is not clicking your ad.</li>
    </ul>
  </ProseSection>

  <ProseSection id="negative-keywords" eyebrow="Negative keyword control" heading="Keeping spend on real auto glass demand">
    <p>
      The word "glass" leaks. Left alone, auto glass campaigns attract home glass, shower and table glass, tint, headlight and mirror parts, window regulators, repair kits and job seekers. We keep block lists built for auto glass, use match types on purpose, and review search terms on a schedule so new leaks get caught early. The result is a lower cost per real lead without cutting your budget.
    </p>
  </ProseSection>

  <ProseSection id="call-campaigns" eyebrow="Calls, hours, and landing pages" heading="Call-focused campaigns, operating hours, and landing pages that convert on a phone" alt>
    <p>
      Most auto glass leads from ads are phone calls. So campaigns are built for calls: call-focused ad formats, ads that run when your people can answer, and after-hours handling that matches how your shop really covers the phone. Landing pages are the other half: a fast page for that one service, tap-to-call at the top, service area and hours visible, insurance and ADAS questions answered, and a short quote form for drivers who'd rather not call.
    </p>
  </ProseSection>

  <ProseSection id="ads-conversion-model" eyebrow="The conversion model" heading="Click → Call → Response → Booked Job. Or Click → Quote Request → Response → Booked Job.">
    <p>
      A paid click still has to turn into a call or a quote. Every campaign is built around one of the two paths below, and the landing page, ad schedule and tracking follow from that. Building and tuning that landing page is part of the service — the same <a href="/auto-glass-websites/">website and conversion work</a> that makes every paid click worth more.
    </p>
    <ConversionPaths />
    <p>
      If the bottleneck behind the click is operational — quoting, scheduling or call handling — rather than the page, we may recommend a third-party solution. That technology is not part of the Google Ads service.
    </p>
    <PartnerCallout compact />
  </ProseSection>

  <ProseSection id="ads-tracking" eyebrow="Conversion tracking and measurement" alt heading="Cost per qualified lead, and booked jobs where the data exists">
    <p>
      Every campaign is tracked to calls, quote requests and tap-to-call. Call tracking records how long each call lasted and, if you allow it, the call itself for review. That lets us separate real leads from wrong numbers and vendors and report a true cost per lead by service and market. Where your shop can share scheduling or invoice data, we report booked jobs and cost per booked job and set budgets on that. Where it can't, we say so instead of guessing from clicks.
    </p>
  </ProseSection>

  <RelatedLinks
    id="ads-related"
    heading="Google Ads is one part of the system."
    links={[
      { href: "/auto-glass-lead-generation/", title: "Auto Glass Lead Generation", description: "How Ads, SEO, Maps, AI search, and conversion connect into one owned acquisition system." },
      { href: "/auto-glass-seo/", title: "Auto Glass SEO", description: "The service pages that double as high-converting paid search landing pages." },
      { href: "/auto-glass-local-seo/", title: "Auto Glass Local SEO & Google Maps", description: "The Map Pack presence that urgent nearby searches convert from." },
      { href: "/visibility-analysis/", title: "Opportunity Analysis", description: "See where paid search could capture demand you are missing today." },
    ]}
    alt
  />

  <FaqSection id="ads-faq" heading="Auto glass Google Ads questions" items={faqs} />

  <ClosingCta
    id="ads-cta"
    heading="Find out what your ad spend is actually producing."
    description="Request a complimentary, manually reviewed analysis of your paid search opportunity — including wasted spend on irrelevant searches — alongside Google Maps, organic search, AI visibility, and conversion friction."
    ctaLabel="Get My Free Google Ads Audit"
  />

</BaseLayout>
