---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Auto Glass Google Ads | Paid Search for Glass Companies";
const pageDescription = "Paid search strategy and management for auto glass companies focused on relevant replacement, repair, recalibration, and mobile-service demand.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- Hero -->
  <section class="page-hero" aria-labelledby="google-ads-heading">
    <div class="container">
      <div class="page-hero__content">
        <span class="eyebrow">Paid Search for Auto Glass</span>
        <h1 id="google-ads-heading" class="text-balance">
          Google Ads for high-intent auto glass searches.
        </h1>
        <p class="page-hero__lead">
          Auto glass searches can overlap with general repair, tinting, residential glass, parts, and do-it-yourself research. We structure campaigns around the services and locations your company can support.
        </p>
        <div class="page-hero__cta">
          <a
            href="/visibility-analysis/"
            data-analytics-event="primary_cta_click"
            class="btn btn--primary btn--lg"
          >
            Audit Your Current Paid Search Campaigns
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Capability cards -->
  <section class="section section--alt" aria-labelledby="ads-capabilities-heading">
    <div class="container">
      <h2 id="ads-capabilities-heading" class="sr-only">Google Ads Capabilities</h2>
      <div class="cap-grid">

        <article class="card">
          <div class="card__top">
            <span class="stage-badge" aria-hidden="true">01</span>
            <h3 class="card__title">Relevant Search Terms</h3>
          </div>
          <p class="card__body">
            Use search terms and negative keywords to reduce spend on irrelevant categories such as detailing, window regulators, home glass, tinting, parts, and do-it-yourself research.
          </p>
        </article>

        <article class="card">
          <div class="card__top">
            <span class="stage-badge" aria-hidden="true">02</span>
            <h3 class="card__title">Calls &amp; Quote Requests</h3>
          </div>
          <p class="card__body">
            Make it easy for urgent customers to call or request a quote, with ads and landing pages aligned to your hours, service availability, and preferred contact path.
          </p>
        </article>

        <article class="card">
          <div class="card__top">
            <span class="stage-badge" aria-hidden="true">03</span>
            <h3 class="card__title">Cost Per Acquisition</h3>
          </div>
          <p class="card__body">
            Where reliable tracking data are available, reporting can connect ad spend with qualified calls, quote requests, booked jobs, and cost per acquisition—not just clicks and impressions.
          </p>
        </article>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background-color: var(--surface-00);
  }

  .page-hero__content {
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-hero__lead {
    font-size: clamp(1rem, 1.5vw + 0.25rem, 1.1875rem);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 42rem;
  }

  .page-hero__cta {
    padding-top: 0.5rem;
  }

  .section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background-color: var(--surface-00);
  }

  .section--alt {
    background-color: var(--surface-01);
  }

  .cap-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .cap-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .card {
    background-color: var(--surface-02);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 200ms;
  }

  .card:hover {
    border-color: rgba(49,130,246,0.3);
  }

  .card__top {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .card__title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.35;
    padding-top: 0.125rem;
  }

  .card__body {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
