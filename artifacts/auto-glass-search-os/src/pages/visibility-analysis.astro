---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, isConfigured } from '../data/siteData';

const pageTitle = "Complimentary Search + AI Visibility Analysis | Auto Glass Search OS";
const pageDescription = "Find out who's winning the auto glass searches in your market. Request a complimentary search and AI visibility analysis for your auto glass company.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left Col: Offer Value Proposition -->
        <div class="lg:col-span-5 space-y-6 text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-blue-950/80 border border-blue-500/30 text-xs font-mono text-blue-400">
            COMPLIMENTARY EXECUTIVE ANALYSIS
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white font-heading leading-tight">
            FIND OUT WHO'S WINNING THE AUTO GLASS SEARCHES IN YOUR MARKET.
          </h1>

          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            Get a complimentary analysis showing how your auto glass company appears across Google Search, Google Maps, and emerging AI search experiences—and where competitors may be capturing jobs you're missing.
          </p>

          <div class="p-5 rounded-xl bg-[#0D1424] border border-white/10 space-y-3">
            <h2 class="text-xs font-mono uppercase tracking-wider text-blue-400 font-semibold">
              What Your Analysis Examines:
            </h2>
            <ul class="text-xs space-y-2 text-slate-300 font-mono">
              <li class="flex items-start gap-2">
                <span class="text-emerald-400">✓</span>
                <span>Google Maps 3-Pack rank across key local zip codes</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-400">✓</span>
                <span>Organic visibility for windshield, repair, mobile service, and ADAS queries</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-400">✓</span>
                <span>AI-assisted discovery signals across ChatGPT, Perplexity, and Google AI Overviews</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-400">✓</span>
                <span>Competitor presence across priority services and local search surfaces</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-400">✓</span>
                <span>Mobile landing page conversion friction review</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Right Col: High-Converting Qualified Lead Form -->
        <div class="lg:col-span-7">
          <div class="p-6 sm:p-8 rounded-2xl bg-[#0C1220] border border-white/15 shadow-2xl relative">
            <div class="pb-6 mb-6 border-b border-white/10 text-left">
              <h2 class="text-xl font-bold text-white font-heading">
                Request Your Market Visibility Analysis
              </h2>
              <p class="text-xs text-slate-400 mt-1">
                Online form delivery is not active yet. Request the analysis directly using the contact options below.
              </p>
            </div>
            <div class="space-y-4">
              <a
                href={`mailto:${siteConfig.placeholders.email}?subject=Search%20%2B%20AI%20Visibility%20Analysis`}
                data-analytics-event="email_click"
                class="flex w-full items-center justify-center rounded bg-blue-600 px-6 py-4 text-center text-xs font-bold uppercase tracking-wider text-white transition-colors hover:bg-blue-500"
              >
                Request Your Analysis by Email →
              </a>
              {isConfigured(siteConfig.placeholders.phone) && (
                <a
                  href={`tel:${siteConfig.placeholders.phone.replace(/[^\d+]/g, '')}`}
                  data-analytics-event="phone_click"
                  class="flex w-full items-center justify-center rounded border border-white/15 bg-[#0D1424] px-6 py-4 text-center text-xs font-bold uppercase tracking-wider text-slate-100 transition-colors hover:border-blue-500/50 hover:text-blue-300"
                >
                  Call {siteConfig.placeholders.phone}
                </a>
              )}
              <p class="text-center text-xs font-mono text-slate-400">
                The analysis is conducted manually. Scope and timing are confirmed directly before work begins.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>
</BaseLayout>
