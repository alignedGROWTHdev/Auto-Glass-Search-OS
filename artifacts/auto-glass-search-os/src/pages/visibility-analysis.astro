---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import BrandMark from '../components/BrandMark.astro';

const pageTitle = "Auto Glass Marketing Audit | Free Opportunity Analysis";
const pageDescription = "Find out who's winning the auto glass searches in your market. A free, manually reviewed audit of Maps, organic, paid and AI search gaps — and where you lose leads.";
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbName="Opportunity Analysis">
  <section class="analysis-page" aria-labelledby="analysis-heading">
    <div class="container">
      <div class="analysis-grid">

        <!-- Left: Value proposition -->
        <div class="analysis-value">
          <div class="analysis-eyebrow-wrap">
            <span class="agos-brandmark" aria-hidden="true">
              <BrandMark size={26} />
            </span>
            <span class="eyebrow">Search + Customer Acquisition Opportunity Analysis</span>
          </div>

          <h1 id="analysis-heading" class="text-balance">
            Find out who's winning the auto glass searches in your market.
          </h1>

          <p class="analysis-value__lead">
            Get a complimentary, manually reviewed analysis of how your auto glass company appears across Google Search, Google Maps, paid search, and AI-assisted search — where competitors are capturing the windshield replacement, repair, and ADAS calibration demand you are missing, and what it would take to turn that demand into qualified leads.
          </p>

          <div class="analysis-checklist" aria-label="What your analysis examines">
            <p class="analysis-checklist__label eyebrow eyebrow--blue">What your analysis evaluates:</p>
            <ul class="analysis-checklist__list" role="list">
              <li class="check-item">Search visibility — organic gaps for windshield replacement, repair, mobile service and ADAS calibration</li>
              <li class="check-item">Google Maps visibility — where the Map Pack shows competitors instead of you</li>
              <li class="check-item">Competitor visibility across your priority services and markets</li>
              <li class="check-item">Paid search opportunity, including wasted spend on irrelevant searches where an account exists</li>
              <li class="check-item">AI visibility across relevant AI-assisted search experiences</li>
              <li class="check-item">Website UX and conversion friction — the reasons a driver who found you did not act</li>
              <li class="check-item">Call pathway and quote-request pathway — click-to-call accessibility and whether a driver can request a quote without unnecessary back-and-forth</li>
              <li class="check-item">Mobile conversion — speed, layout and tap targets on the device most auto glass searches happen on</li>
              <li class="check-item">Measurement — whether calls, forms and booked jobs can be attributed to channels today</li>
            </ul>
            <p class="analysis-checklist__note">
              Where operational or technology limitations appear to create conversion friction, recommendations may include specialized third-party technology. The analysis does not include or sell that technology.
            </p>
          </div>

          <div class="analysis-value__promise">
            <div class="promise-item">
              <span class="promise-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 7l3.5 3.5L12 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Manually reviewed, not automated</span>
            </div>
            <div class="promise-item">
              <span class="promise-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 7l3.5 3.5L12 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Confidential — not shared with competitors</span>
            </div>
            <div class="promise-item">
              <span class="promise-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 7l3.5 3.5L12 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>No obligation — scope confirmed before any engagement</span>
            </div>
          </div>

          <div class="analysis-value__contact">
            <p class="contact-label eyebrow">Prefer to reach us directly?</p>
            <div class="contact-links">
              <a href="tel:+15165211149" data-analytics-event="phone_click" class="contact-link">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M3 1h3l1.5 3.5-2 1.5A8 8 0 0 0 9 9.5l1.5-2L14 9v3a1 1 0 0 1-1 1A11 11 0 0 1 2 2a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                (516) 521-1149
              </a>
            </div>
          </div>

        </div>

        <!-- Right: Form -->
        <div class="analysis-form-panel">
          <div class="analysis-form-card">
            <header class="analysis-form-card__header">
              <h2 class="analysis-form-card__title">Request Your Opportunity Analysis</h2>
              <p class="analysis-form-card__subtitle">
                Tell us about your operation and markets. Every analysis is reviewed manually by Valentina Borda and the Auto Glass Growth team — not generated automatically.
              </p>
            </header>

            <LeadForm />
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .analysis-page {
    padding-top: 4.5rem;
    padding-bottom: 6rem;
    background-color: var(--obsidian);
    min-height: 80dvh;
    position: relative;
    overflow: hidden;
  }

  /* Background accent */
  .analysis-page::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 60%;
    background: radial-gradient(ellipse at 80% 20%, rgba(30,64,175,0.1) 0%, transparent 60%);
    pointer-events: none;
  }

  .analysis-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .analysis-grid {
      grid-template-columns: 5fr 7fr;
      gap: 5rem;
    }
  }

  /* Value col */
  .analysis-value {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .analysis-eyebrow-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .analysis-value__lead {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.72;
  }

  .analysis-checklist {
    background-color: var(--carbon-slate-2);
    border: 1px solid rgba(0, 210, 255, 0.1);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .analysis-checklist__label {
    margin: 0;
  }

  .analysis-checklist__note {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    line-height: 1.55;
    margin: 0.875rem 0 0;
  }

  .analysis-checklist__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  /* Promise bar */
  .analysis-value__promise {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.25rem 1.5rem;
    background: var(--fleet-amber-dim);
    border: 1px solid var(--fleet-amber-border);
    border-radius: var(--radius-lg);
  }

  .promise-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .promise-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--fleet-amber-dim);
    border: 1px solid var(--fleet-amber-border);
    color: var(--fleet-amber);
    flex-shrink: 0;
  }

  /* Direct contact */
  .analysis-value__contact {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .contact-label {
    color: var(--text-tertiary);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
    letter-spacing: 0.02em;
  }

  .contact-link:hover {
    color: var(--laser-cyan);
  }

  .contact-link svg {
    color: var(--laser-cyan);
    flex-shrink: 0;
  }

  /* Form panel */
  .analysis-form-panel {
    position: sticky;
    top: 5.5rem;
  }

  .analysis-form-card {
    background-color: var(--carbon-slate-2);
    border: 1px solid rgba(0, 210, 255, 0.12);
    border-radius: var(--radius-2xl);
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    box-shadow: 0 8px 48px rgba(0,0,0,0.35), 0 0 0 1px rgba(0,210,255,0.05);
  }

  @media (min-width: 640px) {
    .analysis-form-card { padding: 2.5rem; }
  }

  .analysis-form-card__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .analysis-form-card__title {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .analysis-form-card__subtitle {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    line-height: 1.6;
    margin: 0;
  }
</style>
