---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, isConfigured } from '../data/siteData';

const pageTitle = "Complimentary Search + AI Visibility Analysis | Auto Glass Search OS";
const pageDescription = "Find out who's winning the auto glass searches in your market. Request a complimentary search and AI visibility analysis for your auto glass company.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="analysis-page" aria-labelledby="analysis-heading">
    <div class="container">
      <div class="analysis-grid">

        <!-- Left: Value prop -->
        <div class="analysis-value">
          <span class="eyebrow">Complimentary Executive Analysis</span>

          <h1 id="analysis-heading" class="text-balance">
            Find out who's winning the auto glass searches in your market.
          </h1>

          <p class="analysis-value__lead">
            Get a complimentary, manually reviewed analysis of how your auto glass company appears across Google Search, Google Maps, and AI-assisted search—and where competitors may be capturing jobs you are missing.
          </p>

          <div class="analysis-checklist" aria-label="What your analysis examines">
            <p class="analysis-checklist__label eyebrow eyebrow--blue">What your analysis examines:</p>
            <ul class="analysis-checklist__list" role="list">
              <li class="check-item">Google Maps visibility in your market</li>
              <li class="check-item">Organic visibility for windshield replacement, repair, mobile service, and ADAS recalibration</li>
              <li class="check-item">AI search visibility across relevant AI-assisted search experiences</li>
              <li class="check-item">Competitor presence across priority services and local search surfaces</li>
              <li class="check-item">Website conversion friction</li>
              <li class="check-item">Relevant paid-search opportunities, where applicable</li>
            </ul>
          </div>
        </div>

        <!-- Right: Form / contact -->
        <div class="analysis-form-panel">
          <div class="analysis-form-card">
            <header class="analysis-form-card__header">
              <h2 class="analysis-form-card__title">Request Your Market Visibility Analysis</h2>
              <p class="analysis-form-card__note">
                This page does not yet have a form-delivery integration. Please request your manually reviewed analysis by email or phone below.
              </p>
            </header>

            <div class="analysis-form-card__contacts">
              <a
                href={`mailto:${siteConfig.placeholders.email}?subject=Search%20%2B%20AI%20Visibility%20Analysis`}
                data-analytics-event="email_click"
                class="btn btn--primary btn--full btn--lg"
              >
                Request Your Analysis by Email
              </a>

              {isConfigured(siteConfig.placeholders.phone) && (
                <a
                  href={`tel:${siteConfig.placeholders.phone.replace(/[^\d+]/g, '')}`}
                  data-analytics-event="phone_click"
                  class="btn btn--secondary btn--full btn--lg"
                >
                  Call {siteConfig.placeholders.phone}
                </a>
              )}

              <p class="analysis-form-card__meta">
                Every analysis is reviewed manually. Scope and timing are confirmed directly before work begins.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .analysis-page {
    padding-top: 5rem;
    padding-bottom: 6rem;
    background-color: var(--surface-00);
    min-height: 80dvh;
  }

  .analysis-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .analysis-grid {
      grid-template-columns: 5fr 7fr;
      gap: 5rem;
    }
  }

  /* Value col */
  .analysis-value {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .analysis-value__lead {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .analysis-checklist {
    background-color: var(--surface-02);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .analysis-checklist__label {
    margin: 0;
  }

  .analysis-checklist__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  /* Form card */
  .analysis-form-panel {
    position: sticky;
    top: 6rem;
  }

  .analysis-form-card {
    background-color: var(--surface-02);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius-2xl);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .analysis-form-card { padding: 2.5rem; }
  }

  .analysis-form-card__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .analysis-form-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .analysis-form-card__note {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    line-height: 1.6;
    margin: 0;
  }

  .analysis-form-card__contacts {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .analysis-form-card__meta {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    letter-spacing: 0.04em;
    line-height: 1.7;
    margin: 0;
  }
</style>
