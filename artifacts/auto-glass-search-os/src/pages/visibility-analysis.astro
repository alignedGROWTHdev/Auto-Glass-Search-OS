---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import BrandMark from '../components/BrandMark.astro';
import { siteConfig } from '../data/siteData';
import FaqSection from '../components/FaqSection.astro';
import { faqSchema } from '../data/schema';

const pageTitle = "Auto Glass Marketing Audit | Free Opportunity Analysis";
const pageDescription = "See who's winning the auto glass searches in your market. A free, manually reviewed audit of Maps, organic, paid and AI gaps — and where you lose leads.";

const faqs = [
  { question: "What is the Free Growth Analysis?", answer: "A hand-reviewed look at how your auto glass shop shows up when drivers search — Google, the map results, paid ads and AI answers — and where drivers who find you drop off before calling or requesting a quote. You get three or four specific findings with screenshots, and the fixes we'd make first." },
  { question: "What does it cost?", answer: "Nothing. There is no charge and no obligation. You get a recorded video walkthrough of what we found, and a call happens only if you want one." },
  { question: "How long does it take?", answer: "A person reviews every request. You get your recorded video walkthrough within 2–3 business days." },
  { question: "What does a finding look like?", answer: "Specific and verifiable. For example: which shop holds the top map result for 'windshield replacement' in your city and how many more reviews they have than you, or how many taps it takes a driver to find your phone number on a phone." },
  { question: "Who is it for?", answer: "Established auto glass shops — one location or many, in-shop or mobile — that want more of the right jobs and want to know which marketing is producing them. We don't work with lead resellers." },
  { question: "Do you sell leads?", answer: "No. We don't sell leads or software. Your analysis is yours and nobody else sees it. If we work together, the website, listing, ads and every call they produce belong to you." },
];
const extraSchema = [faqSchema(faqs, "/visibility-analysis/")];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbName="Free Growth Analysis" extraSchema={extraSchema}>
  <section class="analysis-page" aria-labelledby="analysis-heading">
    <div class="container">
      <div class="analysis-grid">

        <!-- Left: Value proposition -->
        <div class="analysis-value">
          <div class="analysis-eyebrow-wrap">
            <span class="agos-brandmark" aria-hidden="true">
              <BrandMark size={26} />
            </span>
            <span class="eyebrow">Free auto glass marketing analysis</span>
          </div>

          <h1 id="analysis-heading" class="analysis-heading text-balance">
            See who's winning the auto glass searches in your market.
          </h1>

          <p class="analysis-value__lead">
            A free, hand-reviewed look at where your shop shows up — and where a competitor is getting the calls instead. A recorded video walkthrough within 2–3 business days. No sales call required.
          </p>

          <ol class="analysis-steps" aria-label="What happens next">
            <li><b>1.</b> Tell us about your shop. About a minute.</li>
            <li><b>2.</b> We review your market by hand — Maps, search, ads, AI answers, your website and your phone.</li>
            <li><b>3.</b> Within 2–3 business days you get a recorded video walkthrough: what we found, what to fix first, and an honest read on fit.</li>
          </ol>

          <div id="scope" class="analysis-checklist" aria-label="What your analysis examines">
            <p class="analysis-checklist__label eyebrow eyebrow--blue">Everything we review:</p>
            <ul class="analysis-checklist__list" role="list">
              <li class="check-item">Google search — where you rank for windshield replacement, repair, mobile service and ADAS calibration, and who ranks above you</li>
              <li class="check-item">Google Maps — whether you are in the top three map results, and who is there instead</li>
              <li class="check-item">Competitors — which shops are winning your services and markets, and why</li>
              <li class="check-item">Google Ads — the opportunity, and wasted spend on searches that aren't auto glass if you already run ads</li>
              <li class="check-item">AI answers — whether Google's AI and ChatGPT mention your shop when a driver asks</li>
              <li class="check-item">Your website — the reasons a driver who found you didn't call or request a quote</li>
              <li class="check-item">Call and quote paths — how many taps to reach you, and whether a driver can get a quote without a runaround</li>
              <li class="check-item">Mobile — speed and layout on the phone, where most auto glass searches happen</li>
              <li class="check-item">Tracking — whether you can tell today which channel produced each call, form and booked job</li>
            </ul>
            <p class="analysis-checklist__note">
              If the bottleneck is operational — missed calls, quoting or scheduling — we'll say so, and AI voice or quoting technology from our dedicated partners can be part of the plan. The analysis itself doesn't include or sell that technology.
            </p>
          </div>

          <div class="analysis-value__promise">
            <div class="promise-item">
              <span class="promise-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 7l3.5 3.5L12 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Manually reviewed, not automated</span>
            </div>
            <div class="promise-item">
              <span class="promise-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 7l3.5 3.5L12 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Confidential — not shared with competitors</span>
            </div>
            <div class="promise-item">
              <span class="promise-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 7l3.5 3.5L12 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>No obligation — findings first, a call only if you want one</span>
            </div>
          </div>

          <div class="analysis-value__contact">
            <p class="contact-label eyebrow">Prefer to reach us directly?</p>
            <div class="contact-links">
              <a href={`tel:${siteConfig.placeholders.phone.replace(/[^\d+]/g, '')}`} data-analytics-event="phone_click" class="contact-link">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M3 1h3l1.5 3.5-2 1.5A8 8 0 0 0 9 9.5l1.5-2L14 9v3a1 1 0 0 1-1 1A11 11 0 0 1 2 2a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {siteConfig.placeholders.phone}
              </a>
              <a href={`mailto:${siteConfig.placeholders.email}`} data-analytics-event="email_click" class="contact-link">
                {siteConfig.placeholders.email}
              </a>
            </div>
          </div>

        </div>

        <!-- Right: Form -->
        <div class="analysis-form-panel">
          <div class="analysis-form-card">
            <header class="analysis-form-card__header">
              <h2 class="analysis-form-card__title">Request Your Free Growth Analysis</h2>
              <p class="analysis-form-card__subtitle">
                Tell us about your shop and markets. A person reviews every request, and your recorded video walkthrough arrives within 2–3 business days.
              </p>
            </header>

            <LeadForm />
          </div>
        </div>

      </div>
    </div>
  </section>

  <FaqSection id="analysis-faq" heading="Questions about the analysis" items={faqs} />
</BaseLayout>

<style>
  .analysis-heading {
    font-size: clamp(2rem, 3vw + 0.5rem, 2.875rem);
    line-height: 1.08;
  }

  .analysis-steps {
    list-style: none;
    margin: 0;
    padding: 1rem 1.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-lg);
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .analysis-steps b {
    color: var(--laser-cyan);
    font-family: var(--font-display);
    margin-right: 0.35rem;
  }

  .analysis-page {
    padding-top: 4.5rem;
    padding-bottom: 6rem;
    background-color: var(--obsidian);
    min-height: 80dvh;
    position: relative;
    overflow: hidden;
  }

  /* Background accent */
  .analysis-page::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 60%;
    background: radial-gradient(ellipse at 80% 20%, rgba(30,64,175,0.1) 0%, transparent 60%);
    pointer-events: none;
  }

  .analysis-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .analysis-grid {
      grid-template-columns: 5fr 7fr;
      gap: 5rem;
    }
  }

  /* Value col */
  .analysis-value {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .analysis-eyebrow-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .analysis-value__lead {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.72;
  }

  .analysis-checklist {
    background-color: var(--carbon-slate-2);
    border: 1px solid rgba(0, 210, 255, 0.1);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .analysis-checklist__label {
    margin: 0;
  }

  .analysis-checklist__note {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    line-height: 1.55;
    margin: 0.875rem 0 0;
  }

  .analysis-checklist__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  /* Promise bar */
  .analysis-value__promise {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.25rem 1.5rem;
    background: var(--fleet-amber-dim);
    border: 1px solid var(--fleet-amber-border);
    border-radius: var(--radius-lg);
  }

  .promise-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .promise-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--fleet-amber-dim);
    border: 1px solid var(--fleet-amber-border);
    color: var(--fleet-amber);
    flex-shrink: 0;
  }

  /* Direct contact */
  .analysis-value__contact {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .contact-label {
    color: var(--text-tertiary);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
    letter-spacing: 0.02em;
  }

  .contact-link:hover {
    color: var(--laser-cyan);
  }

  .contact-link svg {
    color: var(--laser-cyan);
    flex-shrink: 0;
  }

  /* Form panel */
  .analysis-form-panel {
    position: sticky;
    top: 5.5rem;
  }

  .analysis-form-card {
    background-color: var(--carbon-slate-2);
    border: 1px solid rgba(0, 210, 255, 0.12);
    border-radius: var(--radius-2xl);
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    box-shadow: 0 8px 48px rgba(0,0,0,0.35), 0 0 0 1px rgba(0,210,255,0.05);
  }

  @media (min-width: 640px) {
    .analysis-form-card { padding: 2.5rem; }
  }

  .analysis-form-card__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .analysis-form-card__title {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .analysis-form-card__subtitle {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    line-height: 1.6;
    margin: 0;
  }
</style>
