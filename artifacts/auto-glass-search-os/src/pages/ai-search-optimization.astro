---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "AI Search Visibility for Auto Glass | AEO & GEO";
const pageDescription = "Improve the clarity and corroboration of your auto glass business across AI-assisted discovery, Google AI Overviews, and conversational search.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="py-20 border-b border-white/10 bg-[#0A0E18]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-blue-950/80 border border-blue-500/30 text-xs font-mono text-blue-400">
        GENERATIVE ENGINE OPTIMIZATION (GEO / AEO)
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white font-heading">
        AI SEARCH VISIBILITY: <br />
        BUILD CLEARER SIGNALS FOR AI-ASSISTED DISCOVERY.
      </h1>
      <p class="text-lg text-slate-300 max-w-3xl leading-relaxed">
        Drivers can now encounter auto glass companies through conversational search and AI-generated summaries as well as traditional results. We help operators improve the entity clarity, service information, and corroborating signals these systems may use.
      </p>
      <div class="pt-2">
        <a
          href="/visibility-analysis/"
          data-analytics-event="primary_cta_click"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs uppercase tracking-wider transition-all"
        >
          <span>Assess Your AI Search Visibility</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 border-b border-white/10 bg-[#0C1220]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
        <div class="p-6 rounded-xl bg-[#0F1628] border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white font-heading">Entity Clarity & Knowledge Graphs</h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            AI systems need consistent, corroborated information about your business, services, locations, service areas, and documented qualifications where applicable.
          </p>
        </div>
        <div class="p-6 rounded-xl bg-[#0F1628] border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white font-heading">Structured Machine Readability</h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            Publishing clear, semantic HTML and rich schema markup detailing ADAS calibration capabilities, mobile dispatch policies, and OEM glass sourcing so crawlers don't have to guess.
          </p>
        </div>
        <div class="p-6 rounded-xl bg-[#0F1628] border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white font-heading">Third-Party Consensus & Proof</h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            Consistent information across your website and reputable third-party sources gives search and AI systems clearer evidence when they summarize relevant auto glass providers.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
