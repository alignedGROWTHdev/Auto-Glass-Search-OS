---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "AI Search Visibility for Auto Glass | AEO & GEO";
const pageDescription = "Improve the clarity and corroboration of your auto glass business across AI-assisted discovery, Google AI Overviews, and conversational search.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- Hero -->
  <section class="page-hero" aria-labelledby="ai-search-heading">
    <div class="container">
      <div class="page-hero__content">
        <span class="eyebrow">AI Search Visibility</span>
        <h1 id="ai-search-heading" class="text-balance">
          AI Search Visibility for Auto Glass Companies.
        </h1>
        <p class="page-hero__lead">
          Customers are increasingly encountering businesses and recommendations through AI-assisted search. We help make your business, services, locations, and expertise easier for search and AI systems to understand and corroborate.
        </p>
        <div class="page-hero__cta">
          <a
            href="/visibility-analysis/"
            data-analytics-event="primary_cta_click"
            class="btn btn--primary btn--lg"
          >
            Assess Your AI Search Visibility
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Capability cards -->
  <section class="section section--alt" aria-labelledby="ai-capabilities-heading">
    <div class="container">
      <h2 id="ai-capabilities-heading" class="sr-only">AI Search Capabilities</h2>
      <div class="cap-grid">

        <article class="card">
          <div class="card__top">
            <span class="stage-badge" aria-hidden="true">01</span>
            <h3 class="card__title">Clear Business Information</h3>
          </div>
          <p class="card__body">
            Keep information about your business, services, locations, service areas, and qualifications consistent and easy to verify.
          </p>
        </article>

        <article class="card">
          <div class="card__top">
            <span class="stage-badge" aria-hidden="true">02</span>
            <h3 class="card__title">Clear Website Content</h3>
          </div>
          <p class="card__body">
            Use clear website content and relevant structured data to explain services such as ADAS recalibration, mobile service, and OEM or aftermarket glass when offered.
          </p>
        </article>

        <article class="card">
          <div class="card__top">
            <span class="stage-badge" aria-hidden="true">03</span>
            <h3 class="card__title">Consistent Information &amp; Proof</h3>
          </div>
          <p class="card__body">
            Consistent information across your website and reputable third-party sources gives search and AI systems clearer evidence when they summarize relevant auto glass providers.
          </p>
        </article>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background-color: var(--surface-00);
  }

  .page-hero__content {
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-hero__lead {
    font-size: clamp(1rem, 1.5vw + 0.25rem, 1.1875rem);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 42rem;
  }

  .page-hero__cta {
    padding-top: 0.5rem;
  }

  .section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background-color: var(--surface-00);
  }

  .section--alt {
    background-color: var(--surface-01);
  }

  .cap-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .cap-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .card {
    background-color: var(--surface-02);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 200ms;
  }

  .card:hover {
    border-color: rgba(49,130,246,0.3);
  }

  .card__top {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .card__title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.35;
    padding-top: 0.125rem;
  }

  .card__body {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
