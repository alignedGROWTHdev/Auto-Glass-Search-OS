---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CapabilityGrid from '../components/CapabilityGrid.astro';
import ProseSection from '../components/ProseSection.astro';
import FaqSection from '../components/FaqSection.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { faqSchema, serviceSchema } from '../data/schema';

const pagePath = "/ai-search-optimization/";
const pageTitle = "AI Search Optimization for Auto Glass | AEO & GEO";
const pageDescription = "AI search optimization (AEO/GEO) for auto glass companies. Clear business information, structured data, and corroboration for AI-assisted discovery, built on SEO.";

const capabilities = [
  {
    title: "Clear Business Information",
    body: "Keep information about your business, services, locations, service areas, and qualifications consistent and easy to verify.",
  },
  {
    title: "Clear Website Content",
    body: "Use clear website content and relevant structured data to explain services such as ADAS recalibration, mobile service, and OEM or aftermarket glass when offered.",
  },
  {
    title: "Consistent Information & Proof",
    body: "Consistent information across your website and reputable third-party sources gives search and AI systems clearer evidence when they summarize relevant auto glass providers.",
  },
];

const faqs = [
  {
    question: "What is AI search optimization for auto glass companies?",
    answer: "AI search optimization — sometimes called answer engine optimization (AEO) or generative engine optimization (GEO) — is the work of making your business, services, locations, and credentials clear and consistent enough that AI-assisted search systems such as Google AI Overviews, ChatGPT, and Gemini can understand and corroborate them when a driver asks for an auto glass shop nearby.",
  },
  {
    question: "Can you get our shop recommended by ChatGPT or included in Google AI Overviews?",
    answer: "No one can guarantee that, and we do not. AI systems change frequently and their outputs are not controlled by any business or agency. What we can do is improve the clarity, consistency, and third-party corroboration of your business information — the inputs those systems rely on — and measure how your visibility changes over time.",
  },
  {
    question: "Is AI search optimization a replacement for SEO?",
    answer: "No. AI search optimization sits on top of good SEO and entity fundamentals. Depending on the platform and query, AI-assisted search experiences may use or surface information from websites, search indexes, business profiles, reviews and other third-party sources. A shop with weak organic visibility, an inconsistent listing, or thin service pages has little for an AI system to find or trust. Auto glass SEO and local SEO come first; AI search optimization extends them.",
  },
  {
    question: "Why does ADAS calibration matter for AI search?",
    answer: "Drivers and insurers increasingly ask AI assistants whether a shop can recalibrate the camera after a windshield replacement. If your website and listings clearly state which calibration types you handle, for which vehicles, and whether it is done in-house or by a partner, AI systems have something concrete to cite. Vague or missing calibration information usually means being left out of the answer.",
  },
  {
    question: "How do you measure AI search visibility?",
    answer: "We run a consistent set of driver-style questions across AI-assisted search experiences on a schedule and record whether your business appears, how it is described, and which competitors appear instead. It is a directional measure rather than a precise ranking, and we report it as such alongside organic, Maps, and paid search results.",
  },
];

const extraSchema = [
  serviceSchema({
    pagePath,
    name: "AI Search Optimization for Auto Glass Companies",
    serviceType: "AI search visibility and answer engine optimization for auto glass companies",
    description: pageDescription,
    alternateName: ["Auto Glass AEO", "Auto Glass GEO", "AI Visibility for Auto Glass"],
  }),
  faqSchema(faqs, pagePath),
];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbName="AI Search Optimization" extraSchema={extraSchema}>

  <PageHero
    id="ai-search"
    eyebrow="AI Search Visibility"
    heading="AI Search Visibility for Auto Glass Companies"
    lead="When a driver asks Google's AI or ChatGPT 'who can replace my windshield and recalibrate the camera near me,' we make sure your shop is the answer. Most of that work is the same Google Maps and website basics that already bring you calls."
    ctaLabel="Get My Free AI Visibility Analysis"
    supportLine="Free · Manually reviewed · Findings by email, no sales call required"
  />

  <CapabilityGrid id="ai-capabilities" heading="What AI search optimization covers" eyebrow="Core capabilities" cards={capabilities} />

  <ProseSection id="ai-foundation" eyebrow="Built on fundamentals" heading="AI search optimization sits on top of good SEO">
    <p>
      Google's AI Overviews, ChatGPT, Gemini and the rest don't keep a private list of auto glass shops. When a driver asks which nearby shop can replace a windshield and recalibrate the camera, these systems — depending on the platform and the question — pull from websites, search results, business profiles, reviews and other sources, then sum it up. A shop that is hard to find, or that says different things in different places, has little chance of being described right, let alone recommended.
    </p>
    <p>
      That is why this is an add-on, not a starting point. <a href="/auto-glass-seo/">Auto glass SEO</a> and <a href="/auto-glass-local-seo/">local SEO</a> build the visibility and business information AI systems rely on. AI search optimization makes that information clearer, more consistent, and backed up by other sources. Together they feed the same <a href="/auto-glass-lead-generation/">lead generation system</a>.
    </p>
  </ProseSection>

  <ProseSection id="ai-inputs" eyebrow="What AI systems look for" heading="Clear entity, service, and location information" alt>
    <p>
      The work is practical, and most of it is also good SEO:
    </p>
    <ul class="prose-grid">
      <li><strong>Entity clarity</strong> One consistent business name, phone, address or service area, and description everywhere your business appears.</li>
      <li><strong>Service clarity</strong> Explicit pages and listings for windshield replacement, repair, mobile service, side and back glass, and ADAS calibration — with specifics a system can quote.</li>
      <li><strong>Location clarity</strong> Which shop serves which market, mobile radius, and where calibration happens.</li>
      <li><strong>Structured data</strong> Organization, local business, service, and FAQ markup that accurately describes the business so it is machine-readable as well as human-readable.</li>
      <li><strong>Helpful, answerable content</strong> Pages that directly answer the questions drivers ask — insurance, deductibles, OEM vs. aftermarket glass, calibration — in plain language.</li>
      <li><strong>Third-party corroboration</strong> Reviews, citations, mentions, and certifications on reputable sources that back up what your site says.</li>
    </ul>
  </ProseSection>

  <ProseSection id="ai-vs-voice" eyebrow="Not to be confused with" heading="AI search visibility is not AI call handling" alt>
    <p>
      Two different things share the word "AI" on this site. <strong>AI search optimization</strong> — this page — is our service for getting found: helping AI search tools understand and trust your business so drivers find you. <strong>AI call answering</strong> is a separate kind of software, sold and supported by third-party auto glass technology providers, that some shops use to answer calls after hours or when the phones are busy. We don't sell or run it. If missed calls are the problem, we may point you to a provider. One helps drivers find you; the other is about what happens when they call.
    </p>
  </ProseSection>

  <ProseSection id="ai-measurement" eyebrow="Measurement and expectations" heading="What we measure, and what we do not promise">
    <p>
      We don't guarantee ChatGPT recommendations, a spot in Google's AI Overviews, or any ranking in AI answers. Those systems change often and no business controls them. What we do is ask a fixed set of driver-style questions on a schedule, record whether and how your shop shows up, and report the trend next to your organic, Maps and ads results. It is a directional read on AI visibility that guides the rest of the work — not a promise.
    </p>
  </ProseSection>

  <RelatedLinks
    id="ai-related"
    heading="AI search is one part of the system."
    links={[
      { href: "/auto-glass-seo/", title: "Auto Glass SEO", description: "The organic foundation AI search optimization builds on — start here." },
      { href: "/auto-glass-lead-generation/", title: "Auto Glass Lead Generation", description: "How SEO, Maps, Ads, AI search, and conversion connect into one owned acquisition system." },
      { href: "/auto-glass-local-seo/", title: "Auto Glass Local SEO & Google Maps", description: "The Google Business Profile and reviews AI systems draw on." },
      { href: "/visibility-analysis/", title: "Opportunity Analysis", description: "See how your business appears across search, Maps, and AI today." },
    ]}
    alt
  />

  <FaqSection id="ai-faq" heading="AI search optimization questions" items={faqs} />

  <ClosingCta
    id="ai-cta"
    heading="See how search and AI systems describe your shop today."
    description="Request a complimentary, manually reviewed analysis covering AI search visibility alongside Google Maps gaps, organic search gaps, competitor coverage, paid search opportunity, and conversion friction."
    ctaLabel="Get My Free AI Visibility Analysis"
  />

</BaseLayout>
