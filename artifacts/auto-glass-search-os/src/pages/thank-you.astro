---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, isConfigured } from '../data/siteData';

const pageTitle = "Thank You | Auto Glass Search OS";
const pageDescription = "We have received your auto glass visibility analysis request.";
---

<BaseLayout title={pageTitle} description={pageDescription} noindex>
  <section class="thankyou" aria-labelledby="thankyou-heading">
    <div class="container">
      <div class="thankyou__inner">

        <div class="thankyou__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M5 14l6 6L23 8" stroke="var(--blue)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <span class="eyebrow">Analysis Request Confirmed</span>

        <h1 id="thankyou-heading" class="text-balance">
          We've received your details.
        </h1>

        <p class="thankyou__body">
          If you reached this page after submitting a configured form, your request is in review. Auto Glass Search OS evaluates search coverage, local visibility, competitive signals, AI discovery, and conversion opportunities manually.
        </p>

        {isConfigured(siteConfig.placeholders.calendlyUrl) && (
          <div class="thankyou__schedule">
            <h2 class="thankyou__schedule-title">
              Optional: Schedule a direct 15-minute review.
            </h2>
            <p class="thankyou__schedule-desc">
              Prefer to walk through the search data live with Valentina Borda?
            </p>
            <a
              href={siteConfig.placeholders.calendlyUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-analytics-event="scheduling_click"
              class="btn btn--primary"
            >
              Select a Review Time on Calendar
            </a>
          </div>
        )}

        <a href="/" class="thankyou__back">
          Return to Auto Glass Search OS Overview
        </a>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thankyou {
    padding-top: 6rem;
    padding-bottom: 6rem;
    min-height: 70dvh;
    display: flex;
    align-items: center;
    background-color: var(--surface-00);
  }

  .thankyou__inner {
    max-width: 36rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .thankyou__icon {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background-color: rgba(52, 201, 138, 0.12);
    border: 1px solid rgba(52, 201, 138, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thankyou__body {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 30rem;
  }

  .thankyou__schedule {
    width: 100%;
    background-color: var(--surface-02);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    text-align: left;
  }

  .thankyou__schedule-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.4;
  }

  .thankyou__schedule-desc {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  .thankyou__back {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color var(--transition-fast);
  }

  .thankyou__back::before {
    content: '← ';
  }

  .thankyou__back:hover {
    color: var(--text-primary);
  }
</style>
