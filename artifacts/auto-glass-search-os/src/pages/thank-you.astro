---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteData';

const pageTitle = "Thank You | Auto Glass Growth";
const pageDescription = "Your auto glass opportunity analysis request has been received.";
---

<BaseLayout title={pageTitle} description={pageDescription} noindex>
  <section class="thankyou" aria-labelledby="thankyou-heading">
    <div class="container">
      <div class="thankyou__inner">

        <!-- Confirmation icon -->
        <div class="thankyou__icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4.5 13l6 6L21.5 7" stroke="var(--laser-cyan)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <span class="eyebrow">Analysis Request Received</span>

        <h1 id="thankyou-heading" class="text-balance">
          Your request is in review.
        </h1>

        <p class="thankyou__body">
          The Auto Glass Growth team manually reviews every opportunity analysis request — examining your Google Maps gaps, organic search gaps, competitor coverage, paid search opportunity, AI visibility, website conversion friction, and quote and booking pathways. You will receive a direct response with your findings and the lead generation opportunities we see.
        </p>

        <!-- Next steps -->
        <div class="thankyou__next" aria-label="Next steps">
          <p class="thankyou__next-label eyebrow">What happens next</p>
          <ol class="thankyou__steps" role="list">
            <li class="thankyou__step">
              <span class="thankyou__step-num" aria-hidden="true">01</span>
              <div>
                <strong>Manual review begins.</strong>
                <span> Your market, competitive landscape, and current visibility across search surfaces are examined individually.</span>
              </div>
            </li>
            <li class="thankyou__step">
              <span class="thankyou__step-num" aria-hidden="true">02</span>
              <div>
                <strong>We confirm scope if needed.</strong>
                <span> If anything about your markets or services needs clarifying, we reach out by email first so the analysis reflects your shop.</span>
              </div>
            </li>
            <li class="thankyou__step">
              <span class="thankyou__step-num" aria-hidden="true">03</span>
              <div>
                <strong>Your video walkthrough arrives.</strong>
                <span> Within 2–3 business days you get a recorded walkthrough of what we found and what to fix first — confidential, no obligation. A discovery call happens only if you want one.</span>
              </div>
            </li>
          </ol>
        </div>

        <!-- Direct contact -->
        <div class="thankyou__contact">
          <p class="thankyou__contact-label">Need to reach us directly in the meantime?</p>
          <div class="thankyou__contact-links">
            <a
              href={`tel:${siteConfig.placeholders.phone.replace(/[^\d+]/g, '')}`}
              data-analytics-event="phone_click"
              class="thankyou__contact-link"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M3 1h3l1.5 3.5-2 1.5A8 8 0 0 0 9 9.5l1.5-2L14 9v3a1 1 0 0 1-1 1A11 11 0 0 1 2 2a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {siteConfig.placeholders.phone}
            </a>
            <a
              href={`mailto:${siteConfig.placeholders.email}`}
              data-analytics-event="email_click"
              class="thankyou__contact-link"
            >
              {siteConfig.placeholders.email}
            </a>
          </div>
        </div>

        <a href="/" class="thankyou__back">
          Return to Auto Glass Growth
        </a>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thankyou {
    padding-top: 6rem;
    padding-bottom: 6rem;
    min-height: 75dvh;
    display: flex;
    align-items: center;
    background-color: var(--obsidian);
    position: relative;
    overflow: hidden;
  }

  .thankyou::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    pointer-events: none;
  }

  .thankyou__inner {
    max-width: 40rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
    position: relative;
  }

  .thankyou__icon {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background-color: var(--laser-cyan-dim);
    border: 1px solid var(--laser-cyan-border);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 24px var(--laser-cyan-dim);
  }

  .thankyou__body {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.72;
    max-width: 34rem;
  }

  /* Next steps */
  .thankyou__next {
    width: 100%;
    background-color: var(--carbon-slate-2);
    border: 1px solid var(--laser-cyan-dim);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    text-align: left;
  }

  .thankyou__next-label {
    margin: 0;
    color: var(--text-tertiary);
  }

  .thankyou__steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .thankyou__step {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .thankyou__step strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .thankyou__step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    min-width: 2rem;
    border-radius: var(--radius);
    background: var(--laser-cyan-dim);
    border: 1px solid rgba(0, 210, 255, 0.2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--laser-cyan);
    flex-shrink: 0;
  }

  /* Direct contact */
  .thankyou__contact {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    width: 100%;
  }

  .thankyou__contact-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0;
  }

  .thankyou__contact-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  @media (min-width: 480px) {
    .thankyou__contact-links {
      flex-direction: row;
      justify-content: center;
    }
  }

  .thankyou__contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
    background: var(--carbon-slate-2);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .thankyou__contact-link:hover {
    color: var(--laser-cyan);
    border-color: var(--laser-cyan-border);
  }

  .thankyou__contact-link svg {
    color: var(--laser-cyan);
    flex-shrink: 0;
  }

  .thankyou__back {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .thankyou__back::before {
    content: '←';
    color: var(--laser-cyan);
  }

  .thankyou__back:hover {
    color: var(--text-primary);
  }
</style>
