---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "404 Page Not Found | Auto Glass Search OS";
const pageDescription = "The requested page could not be located on Auto Glass Search OS.";
---

<BaseLayout title={pageTitle} description={pageDescription} noindex>
  <section class="notfound" aria-labelledby="notfound-heading">
    <div class="container">
      <div class="notfound__inner">
        <span class="notfound__code" aria-hidden="true">404</span>
        <h1 id="notfound-heading" class="notfound__title">Page Not Found</h1>
        <p class="notfound__body">
          The requested URL does not exist or has been relocated within the search architecture.
        </p>
        <a href="/" class="btn btn--primary">
          Return to Overview
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-top: 8rem;
    padding-bottom: 8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70dvh;
    background-color: var(--surface-00);
    text-align: center;
  }

  .notfound__inner {
    max-width: 28rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .notfound__code {
    font-family: var(--font-mono);
    font-size: 5rem;
    font-weight: 500;
    color: var(--blue);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .notfound__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .notfound__body {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }
</style>
