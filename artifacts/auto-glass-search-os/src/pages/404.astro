---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "404 Page Not Found | Auto Glass Search OS";
const pageDescription = "The requested page could not be located on Auto Glass Search OS.";
---

<BaseLayout title={pageTitle} description={pageDescription} noindex>
  <div class="py-32 flex items-center justify-center text-center">
    <div class="max-w-md mx-auto px-4 space-y-6">
      <div class="text-6xl font-extrabold text-blue-500 font-heading">404</div>
      <h1 class="text-2xl font-bold text-white font-heading">PAGE NOT FOUND</h1>
      <p class="text-sm text-slate-300">
        The requested URL does not exist or has been relocated within the search architecture.
      </p>
      <div>
        <a
          href="/"
          class="inline-block px-6 py-3 rounded bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs uppercase tracking-wider transition-all"
        >
          Return to Overview
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
