---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Auto Glass SEO | Organic Search Infrastructure for Auto Glass Companies";
const pageDescription = "Service and market-level organic search systems for auto glass companies covering windshield replacement, repair, mobile service, and ADAS recalibration.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- Hero -->
  <section class="page-hero" aria-labelledby="seo-heading">
    <div class="container">
      <div class="page-hero__content">
        <span class="eyebrow">Auto Glass SEO</span>
        <h1 id="seo-heading" class="text-balance">
          Auto Glass SEO for the services and markets that drive demand.
        </h1>
        <p class="page-hero__lead">
          We build organic visibility for windshield replacement, windshield repair, rock chip repair, mobile auto glass, ADAS recalibration, and other services your company provides.
        </p>
        <div class="page-hero__cta">
          <a
            href="/visibility-analysis/"
            data-analytics-event="primary_cta_click"
            class="btn btn--primary btn--lg"
          >
            Analyze Your Organic Search Footprint
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Capability cards -->
  <section class="section section--alt" aria-labelledby="seo-capabilities-heading">
    <div class="container">
      <h2 id="seo-capabilities-heading" class="sr-only">SEO Capabilities</h2>
      <div class="cap-grid">

        <article class="card">
          <div class="card__top">
            <span class="stage-badge" aria-hidden="true">01</span>
            <h3 class="card__title">Clear Service Pages</h3>
          </div>
          <p class="card__body">
            Create clear, useful pages for the services customers search for, from windshield replacement and rock chip repair to side glass and ADAS recalibration.
          </p>
          <ul class="cap-list" role="list">
            <li class="check-item">Windshield replacement and repair pages</li>
            <li class="check-item">ADAS recalibration information</li>
            <li class="check-item">Rock chip repair and other glass services</li>
          </ul>
        </article>

        <article class="card">
          <div class="card__top">
            <span class="stage-badge" aria-hidden="true">02</span>
            <h3 class="card__title">Clean Site Structure &amp; Technical SEO</h3>
          </div>
          <p class="card__body">
            Keep site structure, internal links, headings, and technical SEO clear so search engines can find and understand your services, locations, and business information.
          </p>
          <ul class="cap-list" role="list">
            <li class="check-item">Crawlable service and location pages</li>
            <li class="check-item">Relevant structured data where useful</li>
            <li class="check-item">Clear internal linking and heading structure</li>
          </ul>
        </article>

        <article class="card">
          <div class="card__top">
            <span class="stage-badge" aria-hidden="true">03</span>
            <h3 class="card__title">Helpful Insurance &amp; Warranty Information</h3>
          </div>
          <p class="card__body">
            Drivers may have questions about insurance claims, deductibles, glass options, workmanship, and warranty terms. Accurate, state-appropriate explanations can reduce uncertainty before a call or quote request.
          </p>
          <ul class="cap-list" role="list">
            <li class="check-item">Clear insurance claim information</li>
            <li class="check-item">Workmanship and warranty details</li>
            <li class="check-item">Fleet &amp; Commercial Service Guides</li>
          </ul>
        </article>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background-color: var(--surface-00);
  }

  .page-hero__content {
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-hero__lead {
    font-size: clamp(1rem, 1.5vw + 0.25rem, 1.1875rem);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 42rem;
  }

  .page-hero__cta {
    padding-top: 0.5rem;
  }

  .section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background-color: var(--surface-00);
  }

  .section--alt {
    background-color: var(--surface-01);
  }

  .cap-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .cap-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .card {
    background-color: var(--surface-02);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 200ms;
  }

  .card:hover {
    border-color: rgba(49,130,246,0.3);
  }

  .card__top {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .card__title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.35;
    padding-top: 0.125rem;
  }

  .card__body {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .cap-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    border-top: 1px solid rgba(255,255,255,0.06);
    padding-top: 0.875rem;
    margin-top: 0.25rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
