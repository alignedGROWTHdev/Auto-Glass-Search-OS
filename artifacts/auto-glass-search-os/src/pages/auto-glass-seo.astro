---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Auto Glass SEO | Organic Search Infrastructure for Auto Glass Companies";
const pageDescription = "Service and market-level organic search systems for auto glass companies covering windshield replacement, repair, mobile service, and ADAS recalibration.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="py-20 border-b border-white/10 bg-[#0A0E18]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-blue-950/80 border border-blue-500/30 text-xs font-mono text-blue-400">
        ORGANIC SEARCH INFRASTRUCTURE
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white font-heading">
        AUTO GLASS SEO: <br />
        ENGINEERED FOR VEHICLE & SERVICE-LEVEL DEMAND.
      </h1>
      <p class="text-lg text-slate-300 max-w-3xl leading-relaxed">
        Auto Glass Search OS organizes technical foundations, service content, market coverage, and internal linking around the questions drivers ask before choosing a windshield replacement, repair, mobile service, or recalibration provider.
      </p>
      <div class="pt-2">
        <a
          href="/visibility-analysis/"
          data-analytics-event="primary_cta_click"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs uppercase tracking-wider transition-all"
        >
          <span>Analyze Your Organic Search Footprint</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 border-b border-white/10 bg-[#0C1220]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
        <div class="p-6 rounded-xl bg-[#0F1628] border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white font-heading">Service-Level Page Architecture</h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            Important auto glass services need clear, accurate coverage: OEM and aftermarket options, windshield replacement, door and back glass, side glass, chip repair, and recalibration processes.
          </p>
          <ul class="text-xs font-mono text-slate-400 space-y-1.5">
            <li>✓ Windshield Replacement Hubs</li>
            <li>✓ ADAS Recalibration Service Content</li>
            <li>✓ Rock Chip & Crack Stabilization</li>
          </ul>
        </div>

        <div class="p-6 rounded-xl bg-[#0F1628] border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white font-heading">Schema & Machine Accessibility</h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            Use relevant structured data, semantic HTML, canonical URLs, and clear entity relationships so search engines and AI discovery systems can interpret the business without client-side rendering barriers.
          </p>
          <ul class="text-xs font-mono text-slate-400 space-y-1.5">
            <li>✓ Strict HTML-First Indexation</li>
            <li>✓ Service & Entity Schema Support</li>
            <li>✓ Clean Canonical & Heading Topology</li>
          </ul>
        </div>

        <div class="p-6 rounded-xl bg-[#0F1628] border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white font-heading">Insurance & Warranty Authority</h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            Drivers may have questions about insurance claims, deductibles, glass options, workmanship, and warranty terms. Accurate, state-appropriate explanations can reduce uncertainty before a call or quote request.
          </p>
          <ul class="text-xs font-mono text-slate-400 space-y-1.5">
            <li>✓ State Insurance Claim Explanations</li>
            <li>✓ Workmanship & Leak Warranty Signals</li>
            <li>✓ Fleet & Commercial Service Guides</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
