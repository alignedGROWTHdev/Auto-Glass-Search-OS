---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Auto Glass Local SEO | Google Maps SEO for Windshield Replacement";
const pageDescription = "Improve Google Maps and local search visibility for windshield replacement, repair, ADAS recalibration, shop locations, and mobile service areas.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="py-20 border-b border-white/10 bg-[#0A0E18]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-blue-950/80 border border-blue-500/30 text-xs font-mono text-blue-400">
        GOOGLE MAPS 3-PACK & SERVICE AREA DOMINANCE
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white font-heading">
        LOCAL SEO & GOOGLE MAPS: <br />
        CAPTURE HIGH-URGENCY NEARBY DRIVERS.
      </h1>
      <p class="text-lg text-slate-300 max-w-3xl leading-relaxed">
        Drivers with urgent glass needs often compare nearby businesses across Google Maps, reviews, service details, and company websites before they call. Auto Glass Search OS coordinates those local discovery signals across your shop locations and mobile service areas.
      </p>
      <div class="pt-2">
        <a
          href="/visibility-analysis/"
          data-analytics-event="primary_cta_click"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs uppercase tracking-wider transition-all"
        >
          <span>Get Your Local Visibility Analysis</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 border-b border-white/10 bg-[#0C1220]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
        <div class="p-6 rounded-xl bg-[#0F1628] border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white font-heading">Google Business Profile Alignment</h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            Primary and secondary category calibration (Auto Glass Shop, Windshield Repair Service), service catalogue completeness, and photo evidence from actual shop bays and mobile dispatch vans.
          </p>
        </div>
        <div class="p-6 rounded-xl bg-[#0F1628] border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white font-heading">Review Velocity & Sentiment Engine</h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            Build an ethical review-request process that helps real customers describe the service they received in their own words, while your team monitors recurring trust and service themes.
          </p>
        </div>
        <div class="p-6 rounded-xl bg-[#0F1628] border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white font-heading">Multi-Location & Service Area Grids</h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            Coordinate location and service-area pages with the markets your shops and mobile teams can genuinely serve, without creating thin or duplicative local content.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
