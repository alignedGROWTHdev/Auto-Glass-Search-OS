---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Auto Glass Local SEO | Google Maps SEO for Windshield Replacement";
const pageDescription = "Improve Google Maps and local search visibility for windshield replacement, repair, ADAS recalibration, shop locations, and mobile service areas.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- Hero -->
  <section class="page-hero" aria-labelledby="local-seo-heading">
    <div class="container">
      <div class="page-hero__content">
        <span class="eyebrow">Google Maps &amp; Local Search</span>
        <h1 id="local-seo-heading" class="text-balance">
          Local SEO &amp; Google Maps: Help nearby customers find you.
        </h1>
        <p class="page-hero__lead">
          Drivers with urgent glass needs compare nearby businesses across Google Maps, reviews, service details, and company websites before they call. We help make your business easier to find in the locations and service areas you genuinely serve.
        </p>
        <div class="page-hero__cta">
          <a
            href="/visibility-analysis/"
            data-analytics-event="primary_cta_click"
            class="btn btn--primary btn--lg"
          >
            Get Your Local Visibility Analysis
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Capability cards -->
  <section class="section section--alt" aria-labelledby="local-capabilities-heading">
    <div class="container">
      <h2 id="local-capabilities-heading" class="sr-only">Local SEO Capabilities</h2>
      <div class="cap-grid">

        <article class="card">
          <div class="card__top">
            <span class="stage-badge" aria-hidden="true">01</span>
            <h3 class="card__title">Google Business Profile Alignment</h3>
          </div>
          <p class="card__body">
            Keep your categories, services, hours, contact details, and photos accurate so customers have the information they need to contact your business.
          </p>
        </article>

        <article class="card">
          <div class="card__top">
            <span class="stage-badge" aria-hidden="true">02</span>
            <h3 class="card__title">Reviews That Build Trust</h3>
          </div>
          <p class="card__body">
            Build an ethical review-request process that helps real customers describe the service they received in their own words, while your team monitors recurring trust and service themes.
          </p>
        </article>

        <article class="card">
          <div class="card__top">
            <span class="stage-badge" aria-hidden="true">03</span>
            <h3 class="card__title">Locations &amp; Service Areas</h3>
          </div>
          <p class="card__body">
            Coordinate location and service-area pages with the markets you genuinely serve, without creating thin or repetitive local content.
          </p>
        </article>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background-color: var(--surface-00);
  }

  .page-hero__content {
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-hero__lead {
    font-size: clamp(1rem, 1.5vw + 0.25rem, 1.1875rem);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 42rem;
  }

  .page-hero__cta {
    padding-top: 0.5rem;
  }

  .section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background-color: var(--surface-00);
  }

  .section--alt {
    background-color: var(--surface-01);
  }

  .cap-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .cap-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .card {
    background-color: var(--surface-02);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 200ms;
  }

  .card:hover {
    border-color: rgba(49,130,246,0.3);
  }

  .card__top {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .card__title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.35;
    padding-top: 0.125rem;
  }

  .card__body {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
