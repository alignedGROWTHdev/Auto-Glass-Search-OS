---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, isConfigured } from '../data/siteData';

const pageTitle = "Privacy Policy | Auto Glass Search OS";
const pageDescription = "Privacy policy for Auto Glass Search OS B2B lead generation and market visibility diagnostics.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-left space-y-8">
      <div>
        <h1 class="text-3xl font-extrabold text-white font-heading">
          Privacy Policy
        </h1>
        <p class="text-xs font-mono text-slate-400 mt-2">
          Effective Date: {new Date().getFullYear()} · Operating Entity: {siteConfig.legalParent}
        </p>
      </div>

      <div class="space-y-6 text-sm text-slate-300 leading-relaxed border-t border-white/10 pt-6">
        <section class="space-y-2">
          <h2 class="text-lg font-bold text-white font-heading">1. Introduction</h2>
          <p>
            Auto Glass Search OS ("we", "us", or "our"), operated by {siteConfig.legalParent}, provides search acquisition and marketing systems for commercial auto glass operators. This Privacy Policy describes how we collect, use, and protect information submitted via our website and visibility analysis forms.
          </p>
        </section>

        <section class="space-y-2">
          <h2 class="text-lg font-bold text-white font-heading">2. Information We Collect</h2>
          <p>
            We collect business contact information submitted voluntarily through our visibility analysis and contact forms, including name, business email address, direct phone number, company name, website URL, monthly marketing spend ranges, and primary market coverage.
          </p>
        </section>

        <section class="space-y-2">
          <h2 class="text-lg font-bold text-white font-heading">3. How We Use Information</h2>
          <p>
            Submitted data is used exclusively to conduct manual search and competitive visibility diagnostics, communicate analysis findings, provide requested advisory services, and coordinate client engagements. We do not sell or rent commercial lead data to third parties.
          </p>
        </section>

        <section class="space-y-2">
          <h2 class="text-lg font-bold text-white font-heading">4. Contact</h2>
          <p>
            For inquiries regarding this privacy statement, please contact {siteConfig.placeholders.email}{isConfigured(siteConfig.placeholders.address) ? ` or write to our parent operating office at ${siteConfig.placeholders.address}` : ''}.
          </p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
