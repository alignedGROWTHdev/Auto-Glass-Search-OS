---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteData';

const pageTitle = "Privacy Policy | Auto Glass Growth";
const pageDescription = "Privacy policy for Auto Glass Growth, an auto glass marketing, websites and lead generation initiative from Aligned Growth Digital.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="privacy" aria-labelledby="privacy-heading">
    <div class="container">
      <div class="privacy__inner">

        <header class="privacy__header">
          <h1 id="privacy-heading">Privacy Policy</h1>
          <p class="privacy__meta">
            Effective Date: {new Date().getFullYear()} &middot; Auto Glass Growth (Aligned Growth Digital)
          </p>
        </header>

        <div class="privacy__body">

          <section aria-labelledby="privacy-s1">
            <h2 id="privacy-s1">1. Introduction</h2>
            <p>
              Auto Glass Growth, a specialized auto glass growth initiative from Aligned Growth Digital ("we", "us", or "our"), provides search acquisition and marketing systems for commercial auto glass operators. This Privacy Policy describes how we collect, use, and protect information submitted via our website and visibility analysis forms.
            </p>
          </section>

          <section aria-labelledby="privacy-s2">
            <h2 id="privacy-s2">2. Information We Collect</h2>
            <p>
              We collect business contact information submitted voluntarily through our visibility analysis and contact forms, including name, business email address, direct phone number, company name, website URL, monthly marketing spend ranges, primary market coverage, and advertising attribution information such as GCLID and campaign parameters.
            </p>
          </section>

          <section aria-labelledby="privacy-s3">
            <h2 id="privacy-s3">3. How We Use Information</h2>
            <p>
              Submitted data is used exclusively to conduct manual search and competitive visibility diagnostics, communicate analysis findings, provide requested advisory services, and coordinate client engagements. We do not sell or rent commercial lead data to third parties.
            </p>
          </section>

          <section aria-labelledby="privacy-s4">
            <h2 id="privacy-s4">4. Contact</h2>
            <p>
              For inquiries regarding this privacy statement, please call Auto Glass Growth at <a href={`tel:${siteConfig.placeholders.phone.replace(/[^\d+]/g, '')}`} data-analytics-event="phone_click">{siteConfig.placeholders.phone}</a> or email <a href={`mailto:${siteConfig.placeholders.email}`} data-analytics-event="email_click">{siteConfig.placeholders.email}</a>.
            </p>
          </section>

        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .privacy {
    padding-top: 5rem;
    padding-bottom: 5rem;
    background-color: var(--surface-00);
  }

  .privacy__inner {
    max-width: var(--container-prose);
  }

  .privacy__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .privacy__meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    letter-spacing: 0.04em;
    margin: 0;
  }

  .privacy__body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.75;
  }

  .privacy__body section {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .privacy__body h2 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .privacy__body p {
    margin: 0;
  }
</style>
