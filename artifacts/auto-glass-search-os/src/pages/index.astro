---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSystemVisual from '../components/HeroSystemVisual.astro';
import JourneySystem from '../components/JourneySystem.astro';
import ConversionPaths from '../components/ConversionPaths.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import PartnerCallout from '../components/PartnerCallout.astro';
import { siteConfig, credibilityPoints, services } from '../data/siteData';
import { serviceSchema } from '../data/schema';

const pageTitle = "Auto Glass Marketing Agency | Websites, SEO & Leads";
const pageDescription = "Auto Glass Growth: auto glass marketing, websites and lead generation for established auto glass companies. Turn more customer demand into calls, quotes and booked jobs.";

const homeSchema = [
  serviceSchema({
    pagePath: "/",
    name: "Auto Glass Marketing, Websites & Lead Generation",
    serviceType: "Auto glass marketing agency services: SEO, Google Maps, Google Ads, website design, conversion optimization, AI search visibility, analytics and measurement",
    description: pageDescription,
    alternateName: ["Auto Glass Marketing Agency", "Auto Glass Digital Marketing", "Marketing for Auto Glass Companies"],
  }),
];

// Where qualified demand gets lost — the problem section.
const leaks = [
  { tag: "Not found", body: "Competitors appear first in Search or Maps for windshield replacement, mobile service or ADAS calibration in your market." },
  { tag: "Not trusted", body: "The driver finds you, but chooses someone else — better reviews, a stronger website, clearer insurance, warranty and ADAS answers." },
  { tag: "Conversion friction", body: "The website or landing experience makes the next step unnecessarily difficult, especially on a phone: no obvious call button, a long form, missing service information." },
  { tag: "Response / process friction", body: "The business generates demand, but operational response — after hours, overflow, quoting, scheduling — creates a bottleneck and the driver moves on." },
  { tag: "No measurement", body: "Marketing produces activity, but you can't determine which channels create qualified opportunities or booked jobs, or what each costs." },
];

// Business economics factors.
const economics = [
  "Service area and mobile radius",
  "Mobile vs. in-shop mix",
  "Windshield replacement vs. repair",
  "ADAS calibration capability",
  "Insurance vs. cash-pay mix",
  "Operational capacity",
  "Scheduling availability",
  "Market competition",
];

const analysisScope = [
  "Search", "Maps", "Competitors", "Ads", "AI visibility", "Website UX", "Conversion friction", "Call pathway", "Quote-request pathway", "Mobile conversion", "Measurement",
];
---

<BaseLayout title={pageTitle} description={pageDescription} extraSchema={homeSchema}>

  <!-- ════════════════════════════════════════════
       1. HERO
       ════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container">
      <div class="hero__layout">

        <div class="hero__content fade-up">
          <span class="eyebrow" aria-label={siteConfig.category}>
            <span class="status-dot" aria-hidden="true"></span>
            {siteConfig.category}
          </span>

          <h1 id="hero-heading" class="hero__heading text-balance">
            Turn More Customer Demand
            <span class="hero__heading-accent">Into Booked Jobs.</span>
          </h1>

          <p class="hero__lead">
            Auto Glass Growth helps established auto glass companies capture high-intent demand through SEO, Google Maps, paid search and AI discovery — then turn more of that demand into qualified calls, quote requests and measurable business opportunities.
          </p>

          <p class="hero__mechanism">
            <strong>The Auto Glass Growth OS</strong> is our auto glass marketing methodology — a framework for connecting discovery, trust, conversion and measurement, not software. <span class="hero__descriptor">{siteConfig.channelDescriptor}</span>
          </p>

          <div class="hero__actions fade-up fade-up--delay-1">
            <a href="/visibility-analysis/" data-analytics-event="primary_cta_click" class="btn btn--primary btn--lg">
              {siteConfig.primaryCta}
            </a>
            <a href="#journey" data-analytics-event="secondary_cta_click" class="btn btn--secondary btn--lg">
              See How the Growth OS Works
            </a>
          </div>

          <p class="hero__qualifier">
            {siteConfig.primaryCtaOffer} &middot; Manually reviewed &middot; No obligation
          </p>
        </div>

        <div class="hero__visual fade-up fade-up--delay-2">
          <HeroSystemVisual />
        </div>

      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       2. CREDIBILITY / SPECIALIZATION STRIP
       ════════════════════════════════════════════ -->
  <section class="cred" aria-label="Why Auto Glass Growth">
    <div class="container">
      <ul class="cred__list" role="list">
        {credibilityPoints.map((c) => (
          <li class="cred__item">
            <span class="cred__label">{c.label}</span>
            <span class="cred__detail">{c.detail}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       3. WHERE QUALIFIED DEMAND GETS LOST
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="leaks-heading">
    <div class="container">
      <div class="leaks">
        <div class="leaks__intro">
          <span class="eyebrow eyebrow--amber">The problem</span>
          <span class="cyan-rule"></span>
          <h2 id="leaks-heading" class="section-heading text-balance">Where auto glass companies lose customer demand.</h2>
          <p class="section-lead">
            Drivers with a cracked windshield decide in minutes, on a phone. The demand in your market is already there. Most of it is lost at one of five points — usually more than one.
          </p>
          <p class="leaks__note">
            Auto Glass Growth directly addresses the marketing and conversion issues. For operational or technology bottlenecks outside our services, we may recommend specialized third-party providers.
          </p>
        </div>
        <ol class="leaks__grid" role="list">
          {leaks.map((l, i) => (
            <li class="leak" role="listitem">
              <span class="leak__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="leak__tag">{l.tag}</span>
              <p class="leak__body">{l.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       4. THE GROWTH OS METHODOLOGY (FOUND → TRUSTED → CHOSEN → MEASURED)
       ════════════════════════════════════════════ -->
  <section id="journey" class="section section--journey" aria-labelledby="journey-heading">
    <div class="container">
      <div class="section-header section-header--wide">
        <span class="eyebrow">The Auto Glass Growth OS &middot; our methodology</span>
        <span class="cyan-rule"></span>
        <h2 id="journey-heading" class="section-heading text-balance">One methodology across the whole customer journey.</h2>
        <p class="section-lead">
          Found &rarr; Trusted &rarr; Chosen &rarr; Measured. The Growth OS is how we connect marketing, conversion and measurement — a framework, not a platform you log into — built around the moments where a driver becomes your customer or someone else's.
        </p>
      </div>
      <JourneySystem />
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       5. AUTO GLASS GROWTH SERVICES
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="modules-heading">
    <div class="container">
      <div class="modules">
        <div class="modules__intro">
          <span class="eyebrow">Auto Glass Growth services</span>
          <span class="cyan-rule"></span>
          <h2 id="modules-heading" class="section-heading text-balance">What we actually do for auto glass companies.</h2>
          <p class="section-lead">
            Seven services, run as one methodology. The pages built for SEO become the landing pages for Ads, the business information that wins Maps is what AI search corroborates, and every channel converts on a website we build or optimize to rank and convert.
          </p>
          <a href="/auto-glass-lead-generation/" data-analytics-event="leadgen_learn_more" class="btn btn--secondary">
            How it generates leads you own &rarr;
          </a>
        </div>
        <ol class="modules__list" role="list">
          {services.map((m) => (
            <li class="module" role="listitem">
              <span class="module__num" aria-hidden="true">{m.num}</span>
              <div class="module__body">
                <h3 class="module__title">{m.title}</h3>
                <p class="module__desc">{m.body}</p>
                <a href={m.href} class="module__link" data-analytics-event="module_link_click">{m.cta} &rarr;</a>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       6. CONVERSION: CLICK OR CALL
       ════════════════════════════════════════════ -->
  <section class="section section--paths" aria-labelledby="paths-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow eyebrow--amber">Chosen &middot; conversion optimization</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="paths-heading" class="section-heading text-balance">Whether they click or call, give them a clear path to book.</h2>
        <p class="section-lead">
          Visibility is wasted if the driver hits a dead end. Our conversion work shapes both paths: landing pages, click-to-call, quote-request UX, service and insurance information, and the customer journey from first tap to scheduled job.
        </p>
      </div>
      <ConversionPaths />
      <ul class="paths-caps" role="list" aria-label="Auto Glass Growth conversion services">
        <li class="check-item">Website CRO</li>
        <li class="check-item">Landing pages</li>
        <li class="check-item">Call pathways &amp; click-to-call</li>
        <li class="check-item">Quote-request UX</li>
        <li class="check-item">Customer journey optimization</li>
      </ul>
      <div class="paths-partner">
        <PartnerCallout compact />
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       7. BUSINESS ECONOMICS
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="economics-heading">
    <div class="container">
      <div class="econ">
        <div class="econ__copy">
          <span class="eyebrow">Built around your operation</span>
          <span class="cyan-rule"></span>
          <h2 id="economics-heading" class="section-heading text-balance">The goal isn't maximum traffic. It's the right demand your operation can profitably serve.</h2>
          <p class="section-lead">
            A rock chip repair, a same-day replacement with ADAS calibration, and a fleet account are different jobs with different margins. Growth OS strategy starts with how your business actually runs, then shapes which searches, services and markets to capture — and which to leave alone.
          </p>
          <ul class="econ__factors" role="list" aria-label="Factors the strategy considers">
            {economics.map((f) => <li>{f}</li>)}
          </ul>
          <p class="econ__note">
            We don't sell leads, and we don't sell software. We build the marketing, website and conversion system — your site, Maps listing, ads and brand — that generates inquiries, so every one of them belongs to you.
          </p>
        </div>
        <div class="econ__visual">
          <ImagePlaceholder
            label="Auto glass technician performing an ADAS windshield camera calibration (or mobile windshield replacement on site)"
            spec="Landscape, 1200×900. Real technician or shop photo, not stock. Used at ~560px wide."
            aspect="4 / 3"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       8. ENGAGEMENT MODELS
       ════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="engagement-models-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">Engagement models</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="engagement-models-heading" class="section-heading text-balance">Two ways to work with Auto Glass Growth.</h2>
      </div>
      <div class="models-grid">
        <article class="card model-card model-card--primary">
          <header class="model-card__header">
            <div class="model-card__header-top">
              <h3 class="model-card__title">Fully Managed Growth</h3>
              <span class="model-card__badge">Recommended</span>
            </div>
            <span class="model-card__mode eyebrow eyebrow--blue">We run it for you.</span>
          </header>
          <p class="model-card__body">
            A specialized external team runs customer acquisition across SEO, Google Maps, Google Ads, your website, conversion and measurement — while your dispatchers stay focused on booking jobs.
          </p>
          <ul class="model-card__list" role="list">
            <li class="arrow-item">Strategy, execution and quality control</li>
            <li class="arrow-item">Conversion and booking pathway coordination</li>
            <li class="arrow-item">Reporting on qualified leads, appointments and booked jobs</li>
          </ul>
          <a href="/visibility-analysis/" data-analytics-event="managed_search_os_interest" class="btn btn--primary">
            {siteConfig.primaryCta} &rarr;
          </a>
        </article>

        <article class="card model-card">
          <header class="model-card__header">
            <div class="model-card__header-top">
              <h3 class="model-card__title">Growth OS + Your Team</h3>
            </div>
            <span class="model-card__mode eyebrow">We build it with your team.</span>
          </header>
          <p class="model-card__body">
            For operators who want stronger in-house capability: we build the Growth OS workflows with your team, then provide ongoing strategy, quality control and support as your markets grow.
          </p>
          <ul class="model-card__list" role="list">
            <li class="arrow-item">Search systems and reusable workflows your team operates</li>
            <li class="arrow-item">Ongoing strategy and quality control</li>
            <li class="arrow-item">The same measurement model, run internally</li>
          </ul>
          <a href="/visibility-analysis/" data-analytics-event="search_os_team_interest" class="btn btn--secondary">
            Start With an Analysis &rarr;
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       9. FOUNDER / TRUST
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="founder-heading">
    <div class="container">
      <div class="founder">
        <div class="founder__photo">
          <ImagePlaceholder
            label="Founder headshot — Valentina Borda"
            spec="Portrait, 800×1000, natural light, neutral or shop background. Used at ~360px wide."
            aspect="4 / 5"
          />
        </div>
        <div class="founder__copy">
          <span class="eyebrow">Founder-led</span>
          <span class="cyan-rule"></span>
          <h2 id="founder-heading" class="section-heading text-balance">A specialist who works directly with each operator.</h2>
          <p class="founder__name">Valentina Borda <span class="founder__role">Founder, Aligned Growth Digital &middot; leads Auto Glass Growth</span></p>
          <p class="section-lead">
            {siteConfig.legalStatement} Valentina brings more than ten years across search, digital growth, eCommerce and marketing strategy, and she personally owns the opportunity analysis, the strategy, and quality control on what gets published or deployed.
          </p>
          <p class="founder__standard">
            <strong>A plain operating standard:</strong> no fabricated client logos, invented performance claims or unverifiable case studies — and when a growth bottleneck falls outside our core marketing and conversion services, we may recommend specialized auto glass technology providers rather than pretending to build everything ourselves.
          </p>
          <a href="/about/" class="module__link" data-analytics-event="founder_about_click">About Valentina and the company &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       10. FINAL CTA
       ════════════════════════════════════════════ -->
  <section class="section section--cta" aria-labelledby="final-cta-heading">
    <div class="container">
      <div class="final-cta">
        <span class="eyebrow">{siteConfig.primaryCtaOffer}</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="final-cta-heading" class="final-cta__heading text-balance">
          See where your market is leaking opportunity.
        </h2>
        <p class="final-cta__desc">
          A complimentary, manually reviewed analysis of your auto glass market. We look at who's winning the searches you should own, and where drivers who find you don't become jobs.
        </p>
        <ul class="final-cta__scope" role="list" aria-label="What the analysis covers">
          {analysisScope.map((s) => <li>{s}</li>)}
        </ul>
        <a href="/visibility-analysis/" data-analytics-event="primary_cta_click" class="btn btn--primary btn--lg">
          {siteConfig.primaryCta}
        </a>
        <p class="final-cta__note">
          Manually reviewed &middot; Confidential &middot; No obligation
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Shared section scaffolding ─────────────── */
  .section {
    padding-top: 5.5rem;
    padding-bottom: 5.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    background-color: var(--obsidian);
  }

  .section--alt {
    background-color: var(--carbon-slate);
  }

  .section--journey {
    background-color: var(--obsidian);
    background-image: radial-gradient(ellipse at 50% 0%, rgba(0,210,255,0.06) 0%, transparent 55%);
  }

  .section--paths {
    background-color: var(--obsidian);
    background-image: radial-gradient(ellipse at 85% 20%, rgba(245,158,11,0.07) 0%, transparent 55%);
  }

  .section--cta {
    background-color: var(--obsidian);
    background-image: radial-gradient(ellipse at 50% 100%, rgba(30,64,175,0.22) 0%, transparent 60%);
    text-align: center;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
    max-width: 46rem;
  }

  .section-header--wide { max-width: 52rem; }

  .section-header--center {
    margin-inline: auto;
    text-align: center;
    align-items: center;
  }

  .section-heading {
    font-size: clamp(1.75rem, 2.8vw + 0.5rem, 2.625rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 0;
  }

  .section-lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* ── 1. Hero ─────────────────────────────────── */
  .hero {
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
    border-bottom: 1px solid rgba(0,210,255,0.08);
    background-color: var(--obsidian);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 60%;
    height: 100%;
    background: radial-gradient(ellipse at 70% 30%, rgba(30,64,175,0.14) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
  }

  @media (min-width: 1024px) {
    .hero__layout {
      grid-template-columns: 56fr 44fr;
      gap: 4rem;
    }
  }

  .hero__layout > * {
    min-width: 0;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 40rem;
  }

  .hero__heading {
    font-size: clamp(2.25rem, 4.5vw + 0.5rem, 3.75rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0;
  }

  .hero__heading-accent {
    color: var(--laser-cyan);
    display: block;
    text-shadow: 0 0 40px rgba(0, 210, 255, 0.25);
  }

  .hero__lead {
    font-size: clamp(1rem, 1.25vw + 0.5rem, 1.1875rem);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .hero__mechanism {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
    padding: 0.875rem 1.125rem;
    border-left: 2px solid var(--laser-cyan);
    background: rgba(0,210,255,0.04);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  }

  .hero__mechanism strong { color: var(--text-primary); }

  .hero__descriptor {
    display: block;
    margin-top: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--laser-cyan);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .hero__qualifier {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    margin: 0;
    line-height: 1.6;
  }

  .hero__visual {
    position: relative;
  }

  /* ── 2. Credibility strip ────────────────────── */
  .cred {
    background-color: var(--carbon-slate);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 1.5rem 0;
  }

  .cred__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem 2rem;
  }

  @media (min-width: 640px) {
    .cred__list { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .cred__list { grid-template-columns: repeat(5, 1fr); }
  }

  .cred__item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-left: 0.875rem;
    border-left: 2px solid var(--laser-cyan-border);
  }

  .cred__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .cred__detail {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    line-height: 1.5;
  }

  /* ── 3. Leaks ────────────────────────────────── */
  .leaks {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .leaks {
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .leaks__intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 1024px) {
    .leaks__intro { position: sticky; top: 6rem; }
  }

  .leaks__note {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    line-height: 1.6;
    margin: 0;
    padding-top: 0.25rem;
  }

  .leaks__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
  }

  @media (min-width: 640px) {
    .leaks__note {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    line-height: 1.6;
    margin: 0;
    padding-top: 0.25rem;
  }

  .leaks__grid { grid-template-columns: repeat(2, 1fr); }
  }

  .leak {
    position: relative;
    padding: 1.25rem;
    background: rgba(11,15,25,0.55);
    border: 1px solid rgba(255,255,255,0.07);
    border-left: 3px solid var(--fleet-amber);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .leak__num {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-tertiary);
  }

  .leak__tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fleet-amber);
  }

  .leak__body {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* ── 5. Modules ──────────────────────────────── */
  .modules {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .modules {
