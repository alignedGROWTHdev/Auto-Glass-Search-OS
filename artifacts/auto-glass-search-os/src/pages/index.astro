---
import BaseLayout from '../layouts/BaseLayout.astro';
import { methodologyStages, searchIntentMatrix } from '../data/siteData';

const pageTitle = "Auto Glass Search OS | Search & Customer Acquisition for Auto Glass Companies";
const pageDescription = "Turn search visibility into booked auto glass jobs. Auto Glass Search OS helps established auto glass companies win customer demand across Google Search, Google Maps, and AI-powered discovery.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- ════════════════════════════════════════════
       HERO — 60/40 split
       ════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container">
      <div class="hero__layout">

        <!-- Left 60 -->
        <div class="hero__content fade-up">

          <span class="eyebrow" aria-label="Specialized Auto Glass Search and Customer Acquisition">
            <span class="status-dot" aria-hidden="true"></span>
            Specialized Auto Glass Search &amp; Customer Acquisition
          </span>

          <h1 id="hero-heading" class="hero__heading text-balance">
            Turn Search Visibility Into<br />
            <span class="hero__heading-accent">Booked Auto Glass Jobs.</span>
          </h1>

          <p class="hero__lead">
            Auto Glass Search OS helps established auto glass operators convert high-intent paid search and organic local search into qualified calls, quote requests, and booked jobs — with calls routing directly to shop dispatchers and optional AI Voice CSR technology for after-hours and overflow.
          </p>

          <div class="hero__signals" role="list" aria-label="Core service signals">
            <div class="hero__signal" role="listitem">
              <span class="hero__signal-dot" aria-hidden="true"></span>
              <span>High-intent paid search + organic local SEO</span>
            </div>
            <div class="hero__signal" role="listitem">
              <span class="hero__signal-dot" aria-hidden="true"></span>
              <span>Calls routed directly to shop dispatchers</span>
            </div>
            <div class="hero__signal" role="listitem">
              <span class="hero__signal-dot" aria-hidden="true"></span>
              <span>Optional AI Voice CSR for after-hours &amp; overflow</span>
            </div>
            <div class="hero__signal" role="listitem">
              <span class="hero__signal-dot" aria-hidden="true"></span>
              <span>Mobile route clustering + in-shop ADAS calibration bays</span>
            </div>
          </div>

          <div class="hero__actions fade-up fade-up--delay-1">
            <a
              href="/visibility-analysis/"
              data-analytics-event="primary_cta_click"
              class="btn btn--primary btn--lg"
            >
              Get Your Visibility Analysis
            </a>
            <a
              href="#search-methodology"
              data-analytics-event="secondary_cta_click"
              class="btn btn--secondary btn--lg"
            >
              See How It Works
            </a>
          </div>

          <p class="hero__qualifier">
            Built for established auto glass companies investing seriously in growth.
          </p>

        </div>

        <!-- Right 40 — ecosystem visual -->
        <div class="hero__visual fade-up fade-up--delay-2" aria-hidden="true">
          <div class="hero__img-frame">
            <div class="hero__img-hud hero__img-hud--tl" aria-hidden="true">
              <span class="hud-label">SEARCH OS</span>
              <span class="hud-dot"></span>
            </div>
            <div class="hero__img-hud hero__img-hud--br" aria-hidden="true">
              <span class="hud-dot hud-dot--amber"></span>
              <span class="hud-label hud-label--amber">ACTIVE</span>
            </div>
            <!-- Corner calibration marks -->
            <svg class="hero__corner hero__corner--tl" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M1 9 L1 1 L9 1" stroke="rgba(0,210,255,0.7)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <svg class="hero__corner hero__corner--tr" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M17 9 L17 1 L9 1" stroke="rgba(0,210,255,0.7)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <svg class="hero__corner hero__corner--bl" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M1 9 L1 17 L9 17" stroke="rgba(0,210,255,0.7)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <svg class="hero__corner hero__corner--br" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M17 9 L17 17 L9 17" stroke="rgba(0,210,255,0.7)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <img
              src="/auto_glass_search_ecosystem_aligned.webp"
              alt="The Auto Glass Search Ecosystem"
              class="hero__img"
              width="960"
              height="540"
              loading="eager"
              decoding="async"
            />
          </div>
          <p class="hero__visual-note">
            Conceptual ecosystem illustration. Interface figures are illustrative, not client performance claims.
          </p>

          <!-- Flow labels below image -->
          <div class="hero__flow" aria-label="Service flow">
            <span class="hero__flow-step">Search</span>
            <span class="hero__flow-arrow" aria-hidden="true">→</span>
            <span class="hero__flow-step">Call</span>
            <span class="hero__flow-arrow" aria-hidden="true">→</span>
            <span class="hero__flow-step">Dispatch</span>
            <span class="hero__flow-arrow" aria-hidden="true">→</span>
            <span class="hero__flow-step hero__flow-step--accent">Booked Job</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       CUSTOMER SEARCH PROBLEM
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="search-reality-heading">
    <div class="container">

      <div class="section__header section__header--center">
        <span class="eyebrow">The Customer Search Reality</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="search-reality-heading" class="text-balance">
          Your customers are searching right now.
        </h2>
        <p class="section__lead">
          Auto glass is often an urgent purchase. After windshield damage, drivers move quickly across search results, Maps, reviews, websites, insurance information, and phone calls — deciding whom to trust in minutes.
        </p>
      </div>

      <div class="grid-3">
        <article class="card">
          <div class="card__top">
            <div class="stage-badge" aria-label="Point 01">01</div>
            <h3 class="card__title">The Urgent Local Query</h3>
          </div>
          <p class="card__body">
            Drivers query "windshield replacement near me same day" or "mobile auto glass repair [city]." High-intent paid search and optimized local listings help more of that demand reach your dispatchers.
          </p>
        </article>

        <article class="card">
          <div class="card__top">
            <div class="stage-badge" aria-label="Point 02">02</div>
            <h3 class="card__title">AI-Assisted Discovery</h3>
          </div>
          <p class="card__body">
            Drivers ask AI search: "Which nearby auto glass shops provide ADAS recalibration?" Clear, structured business and service information — including in-shop calibration bay details — gives these systems better information to understand your operation.
          </p>
        </article>

        <article class="card">
          <div class="card__top">
            <div class="stage-badge" aria-label="Point 03">03</div>
            <h3 class="card__title">The Dispatch Decision</h3>
          </div>
          <p class="card__body">
            Urgent auto glass decisions move to a phone call fast. Calls route directly to your shop dispatchers, with optional specialized AI Voice CSR technology supporting after-hours, overflow, and weekend intake.
          </p>
        </article>
      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════════
       SERVICE FLOW / ECOSYSTEM
       ════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="ecosystem-heading">
    <div class="container">

      <div class="section__header">
        <span class="eyebrow">The Search-to-Job Pipeline</span>
        <span class="cyan-rule"></span>
        <h2 id="ecosystem-heading" class="text-balance">
          Connect search signals to customer calls and booked jobs.
        </h2>
        <p class="section__sub">
          High-intent search &rarr; local Maps visibility &rarr; AI discovery &rarr; call routing &rarr; mobile dispatch &rarr; ADAS calibration &rarr; measured outcomes.
        </p>
      </div>

      <div class="pipeline" role="list" aria-label="Service pipeline">

        <div class="pipeline__step" role="listitem">
          <div class="pipeline__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/>
              <path d="M10 7v3l2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="pipeline__content">
            <span class="pipeline__label eyebrow">01. Organic + Paid</span>
            <span class="pipeline__name">High-Intent Search</span>
            <span class="pipeline__desc">Google Ads and call-focused campaigns can use a 5,000+ negative-keyword control library when account scope warrants, alongside organic local search</span>
          </div>
        </div>

        <div class="pipeline__connector" aria-hidden="true"></div>

        <div class="pipeline__step" role="listitem">
          <div class="pipeline__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 10a7 7 0 1 1 14 0 7 7 0 0 1-14 0z" stroke="currentColor" stroke-width="1.5"/>
              <path d="M10 6v4l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="pipeline__content">
            <span class="pipeline__label eyebrow">02. Maps</span>
            <span class="pipeline__name">Local Maps &amp; 3-Pack</span>
            <span class="pipeline__desc">Visibility for nearby customers searching for immediate service</span>
          </div>
        </div>

        <div class="pipeline__connector" aria-hidden="true"></div>

        <div class="pipeline__step" role="listitem">
          <div class="pipeline__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="5" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M7 9h6M7 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="pipeline__content">
            <span class="pipeline__label eyebrow">03. AI Search</span>
            <span class="pipeline__name">AI Discovery</span>
            <span class="pipeline__desc">Structured service and ADAS calibration data for AI-assisted search results</span>
          </div>
        </div>

        <div class="pipeline__connector" aria-hidden="true"></div>

        <div class="pipeline__step" role="listitem">
          <div class="pipeline__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 4h10l1 5H4L5 4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <circle cx="7.5" cy="15.5" r="1.5" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="13.5" cy="15.5" r="1.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M4 9v4h12V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="pipeline__content">
            <span class="pipeline__label eyebrow">04. Call + Dispatch</span>
            <span class="pipeline__name">Direct Dispatcher Routing</span>
            <span class="pipeline__desc">Calls route to your shop dispatchers; AI Voice CSR covers after-hours &amp; overflow</span>
          </div>
        </div>

        <div class="pipeline__connector" aria-hidden="true"></div>

        <div class="pipeline__step pipeline__step--final" role="listitem">
          <div class="pipeline__icon pipeline__icon--accent" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 10l4 4 8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="pipeline__content">
            <span class="pipeline__label eyebrow eyebrow--amber">05. Measured</span>
            <span class="pipeline__name pipeline__name--accent">Booked Jobs</span>
            <span class="pipeline__desc">Qualified calls, quote requests, and booked jobs — tracked where data allows</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════════
       TWO ENGAGEMENT MODELS
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="engagement-models-heading">
    <div class="container">

      <div class="section__header section__header--center">
        <span class="eyebrow">Engagement Models</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="engagement-models-heading" class="text-balance">
          Two ways to work with us.
        </h2>
        <p class="section__lead">
          Choose managed execution or work with us to build the search systems and workflows your team can use long-term.
        </p>
      </div>

      <div class="models-grid">
        <!-- Managed Search OS -->
        <article class="card model-card model-card--primary">
          <header class="model-card__header">
            <div class="model-card__header-top">
              <h3 class="model-card__title">Managed Search OS</h3>
              <span class="model-card__badge">Recommended</span>
            </div>
            <span class="model-card__mode eyebrow eyebrow--blue">We run it for you.</span>
          </header>
          <p class="card__body">
            For established auto glass companies that want a specialized external team leading strategy and execution across search, Maps, AI search, paid search, and conversion — while your dispatchers stay focused on booking jobs.
          </p>
          <ul class="model-card__list" role="list">
            <li class="arrow-item">High-intent paid search and organic local SEO</li>
            <li class="arrow-item">Google Maps management and local signals</li>
            <li class="arrow-item">AI search optimization and structured data</li>
            <li class="arrow-item">Call routing strategy and dispatch coordination</li>
            <li class="arrow-item">Measurement tied to qualified leads and booked jobs</li>
          </ul>
          <a href="/visibility-analysis/" data-analytics-event="managed_search_os_interest" class="btn btn--primary">
            Get Your Visibility Analysis &rarr;
          </a>
        </article>

        <!-- Search OS + Team -->
        <article class="card model-card">
          <header class="model-card__header">
            <div class="model-card__header-top">
              <h3 class="model-card__title">Search OS + Team</h3>
            </div>
            <span class="model-card__mode eyebrow">We build it with your team.</span>
          </header>
          <p class="card__body">
            For companies that want to build stronger internal search capability. We create practical workflows and AI-enabled systems with your team, then provide ongoing strategy, quality control, and support as your markets grow.
          </p>
          <ul class="model-card__list" role="list">
            <li class="arrow-item">Search systems and reusable workflows</li>
            <li class="arrow-item">AI-enabled processes your team operates</li>
            <li class="arrow-item">Mobile route clustering and fleet coordination frameworks</li>
            <li class="arrow-item">Ongoing strategy, quality control, and support</li>
          </ul>
          <a href="/visibility-analysis/" data-analytics-event="search_os_team_interest" class="btn btn--secondary">
            Get Your Visibility Analysis &rarr;
          </a>
        </article>
      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════════
       METHODOLOGY: FOUND → TRUSTED → CHOSEN → MEASURED
       ════════════════════════════════════════════ -->
  <section id="search-methodology" class="section" aria-labelledby="methodology-heading">
    <div class="container">

      <div class="section__header section__header--center">
        <span class="eyebrow">How We Work</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="methodology-heading" class="text-balance">
          Found &rarr; Trusted &rarr; Chosen &rarr; Measured
        </h2>
        <p class="section__lead">
          A four-stage discipline that connects search activity with qualified calls, booked jobs, and trackable outcomes.
        </p>
      </div>

      <div class="grid-4" role="list" aria-label="Methodology stages">
        {methodologyStages.map((stage) => (
          <article class="card stage-card" role="listitem">
            <header class="stage-card__header">
              <span class="stage-card__title">{stage.title}</span>
              <span class="stage-tag" aria-label={`Stage ${stage.step}`}>
                {stage.step}
              </span>
            </header>
            <span class="eyebrow eyebrow--blue stage-card__subtitle">{stage.subtitle}</span>
            <p class="card__body">{stage.description}</p>
            <div class="stage-card__metrics">
              <span class="stage-card__metrics-label">Focus areas</span>
              <ul class="stage-card__metrics-list" role="list">
                {stage.signals.map((s) => (
                  <li class="check-item">{s}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════════
       SEARCH INTENT MATRIX
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="intent-matrix-heading">
    <div class="container">

      <div class="section__header">
        <span class="eyebrow">Customer Search Needs</span>
        <span class="cyan-rule"></span>
        <h2 id="intent-matrix-heading" class="text-balance">
          Different searches. Different information needs.
        </h2>
        <p class="section__sub">
          Search behavior changes based on the driver's urgency, service need, and insurance question.
        </p>
      </div>

      <div class="table-scroll" role="region" aria-label="Search intent matrix" tabindex="0">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Customer Query Intent</th>
              <th scope="col">Sample Driver Search</th>
              <th scope="col">Primary Discovery Surface</th>
              <th scope="col">How They Contact You</th>
              <th scope="col">Likely Service Need</th>
            </tr>
          </thead>
          <tbody>
            {searchIntentMatrix.map((item) => (
              <tr>
                <td class="intent-cell--primary">{item.queryType}</td>
                <td class="intent-cell--query">{item.sampleQuery}</td>
                <td>{item.primarySurface}</td>
                <td class="intent-cell--muted">{item.conversionMechanism}</td>
                <td class="intent-cell--value">{item.targetValue}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════════
       MEASUREMENT
       ════════════════════════════════════════════ -->
  <section class="section section--measure" aria-labelledby="measurement-heading">
    <div class="container">
      <div class="measure-inner">
        <span class="eyebrow">Revenue Accountability</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="measurement-heading" class="text-balance">
          Measure booked jobs, not just rankings.
        </h2>
        <p class="measure-body">
          Where reliable call, quote, booking, and revenue data are available, measurement connects search activity with qualified inquiries and booked jobs — not just rankings or traffic numbers. Operational clarity starts with knowing which searches are producing revenue.
        </p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       IDEAL CLIENT PROFILE
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="icp-heading">
    <div class="container">
      <div class="icp-card">
        <div class="icp-card__content">
          <div class="icp-card__left">
            <span class="eyebrow">Partnership Profile</span>
            <span class="cyan-rule"></span>
            <h2 id="icp-heading" class="text-balance">
              Built for auto glass operators ready to scale.
            </h2>
            <p class="icp-card__desc">
              Auto Glass Search OS is designed for established companies that want to improve how they are found online and how search converts into qualified customer inquiries — across in-shop service, mobile dispatch, and ADAS calibration bays.
            </p>
          </div>
          <div class="icp-card__right">
            <ul class="icp-card__list" role="list">
              <li class="check-item">Established auto glass business with a track record</li>
              <li class="check-item">In-shop service, mobile fleet, or both</li>
              <li class="check-item">In-house ADAS calibration capability or partnership</li>
              <li class="check-item">Clear services and geographic markets to grow</li>
              <li class="check-item">A team ready to improve search performance</li>
              <li class="check-item">Seriously investing in sustainable customer acquisition</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       FINAL CTA
       ════════════════════════════════════════════ -->
  <section class="section section--cta" aria-labelledby="final-cta-heading">
    <div class="container">
      <div class="final-cta">
        <span class="eyebrow">Opportunity Diagnostic</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="final-cta-heading" class="final-cta__heading text-balance">
          See where competitors are capturing jobs you're missing.
        </h2>
        <p class="final-cta__desc">
          Request a complimentary, manually reviewed visibility analysis for your auto glass operation. We examine Google Maps visibility, organic search coverage, AI search presence, competitive positioning, paid search opportunities, and website conversion friction.
        </p>
        <a
          href="/visibility-analysis/"
          data-analytics-event="primary_cta_click"
          class="btn btn--primary btn--lg"
        >
          Get Your Search + AI Visibility Analysis
        </a>
        <p class="final-cta__note">
          Manually reviewed &middot; Confidential opportunity analysis &middot; No obligation
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────── */
  .hero {
    padding-top: 4.5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(0,210,255,0.08);
    background-color: var(--obsidian);
    position: relative;
    overflow: hidden;
  }

  /* Subtle radial glow behind hero */
  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 60%;
    height: 100%;
    background: radial-gradient(ellipse at 70% 30%, rgba(30,64,175,0.12) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
  }

  @media (min-width: 1024px) {
    .hero__layout {
      grid-template-columns: 58fr 42fr;
      gap: 4rem;
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 56rem;
  }

  .hero__heading {
    font-size: clamp(2.5rem, 5.5vw + 0.5rem, 4.25rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .hero__heading-accent {
    color: var(--laser-cyan);
    display: block;
    text-shadow: 0 0 40px rgba(0, 210, 255, 0.25);
  }

  .hero__lead {
    font-size: clamp(1rem, 1.25vw + 0.5rem, 1.1875rem);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 46rem;
  }

  /* Service signals */
  .hero__signals {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem;
    background: rgba(19, 27, 46, 0.7);
    border: 1px solid rgba(0, 210, 255, 0.12);
    border-radius: var(--radius-xl);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hero__signal {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  .hero__signal-dot {
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 50%;
    background-color: var(--laser-cyan);
    flex-shrink: 0;
    opacity: 0.7;
  }

