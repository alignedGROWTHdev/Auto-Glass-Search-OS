---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSystemVisual from '../components/HeroSystemVisual.astro';
import JourneySystem from '../components/JourneySystem.astro';
import ConversionPaths from '../components/ConversionPaths.astro';
import PartnerCallout from '../components/PartnerCallout.astro';
import { siteConfig, trustStrip, services } from '../data/siteData';
import { serviceSchema, faqSchema } from '../data/schema';

const pageTitle = "Auto Glass Marketing Agency | Websites, SEO & Leads";
const pageDescription = "Auto glass marketing, websites and lead generation for established auto glass companies. Turn more customer demand into qualified calls, quotes and booked jobs.";

// Three things an owner needs to understand in the first screen.
const outcomes = [
  { title: "Get found", body: "Show up in the top map results, on page one, in Google Ads and in AI answers when a driver in your area needs windshield repair, replacement, mobile service or ADAS calibration.", how: "Auto Glass SEO · Local SEO & Map Pack · Google Ads · AI search" },
  { title: "Get chosen", body: "Give that driver a reason to pick you over the shop above or below you: a fast site, strong reviews, and clear answers on insurance and warranty.", how: "Websites · Reviews · Trust signals" },
  { title: "Get booked — and know what worked", body: "One tap to call, a short quote form, and every call and quote tracked back to the channel that produced it, so you know what's creating jobs.", how: "Conversion optimization · Call & form tracking · Reporting" },
];

// Where shops lose jobs — four points, in plain terms.
const leaks = [
  { tag: "They never see you", body: "A competitor holds the top three map results and page one for windshield replacement or ADAS calibration in your market. The driver calls them." },
  { tag: "They see you and pick someone else", body: "Fewer reviews, a slow or dated website, no clear answer on insurance or warranty. The decision takes thirty seconds." },
  { tag: "They want you but can't reach you", body: "Three taps to find a phone number, a long form, no hours or service area on the page. Or the call goes to voicemail and they move on." },
  { tag: "You can't tell what's working", body: "Money goes out to marketing every month, but nobody can say which channel produced the jobs on this week's schedule." },
];

// Seven services grouped under three pillars an owner would use.
const pillars = [
  { title: "Capture the demand you want", body: "Be visible when local drivers need the services you can profitably deliver.", services: services.filter(x => ["01","02","03","06"].includes(x.num)) },
  { title: "Turn attention into calls and quotes", body: "Give drivers clear reasons to choose you and a simple next step.", services: services.filter(x => ["04","05"].includes(x.num)) },
  { title: "Know what becomes booked work", body: "Connect marketing to calls, quotes, appointments and jobs — and what each cost.", services: services.filter(x => ["07"].includes(x.num)) },
];

// Homepage FAQ — the questions owners ask before they fill out the form.
const faqs = [
  { question: "Does Auto Glass Growth sell leads?", answer: "No. We don't sell leads and we don't sell software. We build and run the marketing, website and conversion system that brings drivers to your business — your website, your Google listing, your ads. Every call and quote request is yours." },
  { question: "Do you provide online quoting, scheduling or AI call answering?", answer: "No. Those are specialized technologies provided and supported separately by third-party auto glass technology providers. If we find that a bottleneck is operational — customers can't get a quote or a timely response — we can point you to a provider, but that technology is not part of our services." },
  { question: "What is the Auto Glass Growth OS?", answer: "It's the name for how we work, not software you have to learn: get found, get chosen, get booked, and measure what worked. The same four steps organize everything we do across SEO, Google Maps, Google Ads, your website and reporting." },
  { question: "What does the free Growth Analysis include?", answer: "A manual review of your market: who holds the top map results and page one for your core searches, how your reviews and website compare with the shops beating you, whether you appear in AI answers, and where drivers who find you drop off before calling or requesting a quote. You get written findings, not a sales call." },
];

const homeSchema = [
  serviceSchema({
    pagePath: "/",
    name: "Auto Glass Marketing, Websites & Lead Generation",
    serviceType: "Auto glass marketing agency services: SEO, Google Maps, Google Ads, website design, conversion optimization, AI search visibility, analytics and measurement",
    description: pageDescription,
    alternateName: ["Auto Glass Marketing Agency", "Auto Glass Digital Marketing", "Marketing for Auto Glass Companies"],
  }),
  faqSchema(faqs, "/"),
];
---

<BaseLayout title={pageTitle} description={pageDescription} extraSchema={homeSchema}>

  <!-- ════════════════════════════════════════════
       1. HERO
       ════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container">
      <div class="hero__layout">

        <div class="hero__content fade-up">
          <span class="eyebrow" aria-label={siteConfig.category}>
            <span class="status-dot" aria-hidden="true"></span>
            {siteConfig.category}
          </span>

          <h1 id="hero-heading" class="hero__heading text-balance">
            Auto Glass Marketing That Turns
            <span class="hero__heading-accent">More Customer Demand Into Booked Jobs.</span>
          </h1>

          <p class="hero__lead">
            We help auto glass shops show up when drivers need windshield repair, replacement, mobile service or ADAS calibration — and turn more of those searches into calls, quote requests and booked work.
          </p>

          <p class="hero__mechanism">
            <strong>The Auto Glass Growth OS</strong> is simply how we do it: get found, get chosen, get booked, and know what worked. A method, not software you have to learn. <span class="hero__descriptor">{siteConfig.channelDescriptor}</span>
          </p>

          <div class="hero__actions fade-up fade-up--delay-1">
            <a href="/visibility-analysis/" data-analytics-event="primary_cta_click" class="btn btn--primary btn--lg">
              {siteConfig.primaryCta}
            </a>
            <a href="#how-it-works" data-analytics-event="secondary_cta_click" class="btn btn--secondary btn--lg">
              See How It Works
            </a>
          </div>

          <p class="hero__qualifier">
            See exactly where you're losing jobs to competitors &middot; Manually reviewed &middot; No obligation &middot; No cost
          </p>
        </div>

        <div class="hero__visual fade-up fade-up--delay-2">
          <HeroSystemVisual />
        </div>

      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       2. TRUST STRIP (three points)
       ════════════════════════════════════════════ -->
  <section class="cred" aria-label="Why Auto Glass Growth">
    <div class="container">
      <ul class="cred__list" role="list">
        {trustStrip.map((c) => (
          <li class="cred__item">
            <span class="cred__label">{c.label}</span>
            <span class="cred__detail">{c.detail}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       3. THREE OUTCOMES
       ════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="outcomes-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">What you get</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="outcomes-heading" class="section-heading text-balance">Get found. Get chosen. Get booked.</h2>
        <p class="section-lead">
          The demand in your market is already there. Drivers are searching today. Our job is to make sure more of them find you, pick you and reach you — and that you can see it happening.
        </p>
      </div>
      <ol class="outcomes" role="list">
        {outcomes.map((o, i) => (
          <li class="outcome" role="listitem">
            <span class="outcome__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="outcome__title">{o.title}</h3>
            <p class="outcome__body">{o.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       4. WHERE SHOPS LOSE JOBS
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="leaks-heading">
    <div class="container">
      <div class="leaks">
        <div class="leaks__intro">
          <span class="eyebrow eyebrow--amber">The problem</span>
          <span class="cyan-rule"></span>
          <h2 id="leaks-heading" class="section-heading text-balance">Where auto glass shops lose jobs.</h2>
          <p class="section-lead">
            A driver catches a rock on the highway at 7:40 a.m. In the parking lot at work she searches "windshield replacement near me." Three shops show up on the map. She taps the one with the most reviews and calls. If that isn't you, that job was gone before you knew it existed.
          </p>
          <p class="section-lead">
            Most shops lose jobs at one of four points. Usually more than one.
          </p>
          <a href="/visibility-analysis/" class="leaks__cta" data-analytics-event="leaks_cta_click">Find out which ones are costing you jobs &rarr;</a>
        </div>
        <ol class="leaks__grid" role="list">
          {leaks.map((l, i) => (
            <li class="leak" role="listitem">
              <span class="leak__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="leak__tag">{l.tag}</span>
              <p class="leak__body">{l.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       5. MID-PAGE CTA — what the analysis shows you
       ════════════════════════════════════════════ -->
  <section class="section section--midcta" aria-labelledby="midcta-heading">
    <div class="container">
      <div class="midcta">
        <div class="midcta__copy">
          <span class="eyebrow">Free Growth Analysis</span>
          <span class="cyan-rule"></span>
          <h2 id="midcta-heading" class="section-heading text-balance">See where you're losing jobs — and what to fix first.</h2>
          <p class="section-lead">We look at your market by hand and send you the findings. No sales call required to get them.</p>
        </div>
        <div class="midcta__panel">
          <ul class="midcta__list" role="list" aria-label="What the analysis tells you">
            <li class="check-item">Which competitors show up instead of you, and for which searches</li>
            <li class="check-item">Where drivers drop off before calling or requesting a quote</li>
            <li class="check-item">The three or four fixes most likely to create more booked jobs</li>
          </ul>
          <a href="/visibility-analysis/" data-analytics-event="primary_cta_click" class="btn btn--primary btn--lg btn--full">
            {siteConfig.primaryCta}
          </a>
          <p class="midcta__note">Manually reviewed &middot; Confidential &middot; No obligation &middot; <a href="/visibility-analysis/#scope">See everything we review</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       6. HOW IT WORKS — the Growth OS, once
       ════════════════════════════════════════════ -->
  <section id="how-it-works" class="section section--journey" aria-labelledby="journey-heading">
    <div class="container">
      <div class="section-header section-header--wide">
        <span class="eyebrow">The Auto Glass Growth OS &middot; how we work</span>
        <span class="cyan-rule"></span>
        <h2 id="journey-heading" class="section-heading text-balance">How a driver becomes your customer — and how we make sure it's you.</h2>
        <p class="section-lead">
          Found &rarr; Trusted &rarr; Chosen &rarr; Measured. Four steps, in the order a driver actually goes through them. Every service we offer fits one of these steps, so nothing is done for its own sake.
        </p>
      </div>
      <JourneySystem />
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       7. THREE PILLARS (seven services)
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="pillars-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">Auto Glass Growth services</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="pillars-heading" class="section-heading text-balance">What we actually do for auto glass companies.</h2>
        <p class="section-lead">
          Seven services, three jobs. The pages we build for search become the landing pages for your ads. The business information that wins the Map Pack is what AI answers repeat. It all lands on one website built to turn a visit into a call.
        </p>
      </div>
      <div class="pillars">
        {pillars.map((p) => (
          <article class="pillar card">
            <h3 class="pillar__title">{p.title}</h3>
            <p class="pillar__body">{p.body}</p>
            <ul class="pillar__services" role="list">
              {p.services.map((m) => (
                <li>
                  <a href={m.href} class="pillar__service" data-analytics-event="module_link_click">
                    <span class="pillar__service-name">{m.title} &rarr;</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <div class="pillars__foot">
        <a href="/auto-glass-lead-generation/" data-analytics-event="leadgen_learn_more" class="btn btn--secondary">
          How it all works together as lead generation &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       8. CLICK OR CALL — how it turns into work
       ════════════════════════════════════════════ -->
  <section class="section section--paths" aria-labelledby="paths-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow eyebrow--amber">How it turns into work for your shop</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="paths-heading" class="section-heading text-balance">Whether they click or call, give them a clear path to book.</h2>
        <p class="section-lead">
          Showing up is wasted if the driver hits a dead end. We build both paths — the page they land on, the call button, the short quote form — and track each one to a booked job. Your team and the systems you choose handle the response and scheduling.
        </p>
      </div>
      <ConversionPaths />
      <div class="paths-partner">
        <PartnerCallout compact />
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       9. ENGAGEMENT MODELS
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="engagement-models-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">Two ways to work together</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="engagement-models-heading" class="section-heading text-balance">Two ways to work with Auto Glass Growth.</h2>
        <p class="section-lead">The goal isn't maximum traffic. It's the right demand your operation can profitably serve.</p>
      </div>
      <div class="models-grid">
        <article class="card model-card model-card--primary">
          <header class="model-card__header">
            <div class="model-card__header-top">
              <h3 class="model-card__title">Fully Managed Growth</h3>
              <span class="model-card__badge">Recommended</span>
            </div>
            <span class="model-card__mode eyebrow eyebrow--blue">We run it for you.</span>
          </header>
          <p class="model-card__body">
            We run your search, Maps, ads, website, conversion and reporting as your outside marketing team. Your people stay focused on answering the phone and booking jobs.
          </p>
          <ul class="model-card__list" role="list">
            <li class="arrow-item">Strategy, execution and quality control</li>
            <li class="arrow-item">Reporting on qualified leads, appointments and booked jobs</li>
          </ul>
          <a href="/visibility-analysis/" data-analytics-event="managed_search_os_interest" class="btn btn--primary">
            {siteConfig.primaryCta} &rarr;
          </a>
        </article>

        <article class="card model-card">
          <header class="model-card__header">
            <div class="model-card__header-top">
              <h3 class="model-card__title">Growth OS + Your Team</h3>
            </div>
            <span class="model-card__mode eyebrow">We build it with your team.</span>
          </header>
          <p class="model-card__body">
            Have someone in-house who handles marketing? We set up the system with them, then stay on for strategy, quality control and support as you add markets.
          </p>
          <ul class="model-card__list" role="list">
            <li class="arrow-item">Search systems and reusable workflows your team operates</li>
            <li class="arrow-item">The same measurement model, run internally</li>
          </ul>
          <a href="/visibility-analysis/" data-analytics-event="search_os_team_interest" class="btn btn--secondary">
            Start With an Analysis &rarr;
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       11. FAQ
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="home-faq-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Common questions</span>
        <span class="cyan-rule"></span>
        <h2 id="home-faq-heading" class="section-heading text-balance">Questions owners ask before they fill out the form.</h2>
      </div>
      <div class="home-faq__layout">
        <div class="home-faq">
          {faqs.map((f) => (
            <details class="home-faq__item">
              <summary class="home-faq__q">{f.question}</summary>
              <p class="home-faq__a">{f.answer}</p>
            </details>
          ))}
        </div>
        <div class="home-faq__photo">
            <img
              src="/auto-glass-adas-calibration.webp"
              alt="Auto glass technician calibrating a windshield-mounted driver assistance camera"
              width="1448"
              height="1086"
              loading="lazy"
              decoding="async"
            />
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       12. FINAL CTA
       ════════════════════════════════════════════ -->
  <section class="section section--cta" aria-labelledby="final-cta-heading">
    <div class="container">
      <div class="final-cta">
        <span class="eyebrow">Free Growth Analysis</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="final-cta-heading" class="final-cta__heading text-balance">
          See where you're losing jobs — and how to win them back.
        </h2>
        <p class="final-cta__desc">
          We review your market by hand: who's winning the searches you should own, where drivers who find you don't become jobs, and what to fix first. You get written findings by email. No sales call required.
        </p>
        <a href="/visibility-analysis/" data-analytics-event="primary_cta_click" class="btn btn--primary btn--lg">
          {siteConfig.primaryCta}
        </a>
        <p class="final-cta__note">
          Manually reviewed &middot; Confidential &middot; No obligation &middot; <a href="/visibility-analysis/#scope">See everything we review</a>
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Shared section scaffolding ─────────────── */
  .section {
    padding-top: 5.5rem;
    padding-bottom: 5.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    background-color: var(--obsidian);
  }

  .section--alt {
    background-color: var(--carbon-slate);
  }

  .section--journey {
    background-color: var(--obsidian);
    background-image: radial-gradient(ellipse at 50% 0%, rgba(0,210,255,0.06) 0%, transparent 55%);
  }

  .section--paths {
    background-color: var(--obsidian);
    background-image: radial-gradient(ellipse at 85% 20%, rgba(245,158,11,0.07) 0%, transparent 55%);
  }

  .section--cta {
    background-color: var(--obsidian);
    background-image: radial-gradient(ellipse at 50% 100%, rgba(30,64,175,0.22) 0%, transparent 60%);
    text-align: center;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
    max-width: 46rem;
  }

  .section-header--wide { max-width: 52rem; }

  .section-header--center {
    margin-inline: auto;
    text-align: center;
    align-items: center;
  }

  .section-heading {
    font-size: clamp(1.75rem, 2.8vw + 0.5rem, 2.625rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 0;
  }

  .section-lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* ── 1. Hero ─────────────────────────────────── */
  .hero {
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
    border-bottom: 1px solid rgba(0,210,255,0.08);
    background-color: var(--obsidian);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 60%;
    height: 100%;
    background: radial-gradient(ellipse at 70% 30%, rgba(30,64,175,0.14) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
  }

  @media (min-width: 1024px) {
    .hero__layout {
      grid-template-columns: 56fr 44fr;
      gap: 4rem;
    }
  }

  .hero__layout > * {
    min-width: 0;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 44rem;
  }

  .hero__heading {
    font-size: clamp(2.1rem, 3.6vw + 0.5rem, 3.25rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0;
  }

  .hero__heading-accent {
    color: var(--laser-cyan);
    display: block;
    text-shadow: 0 0 40px rgba(0, 210, 255, 0.25);
  }

  .hero__lead {
    font-size: clamp(1rem, 1.25vw + 0.5rem, 1.1875rem);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .hero__mechanism {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
    padding: 0.875rem 1.125rem;
    border-left: 2px solid var(--laser-cyan);
    background: rgba(0,210,255,0.04);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  }

  .hero__mechanism strong { color: var(--text-primary); }

  @media (max-width: 767px) {
    .hero__mechanism { display: none; }
  }

  .hero__descriptor {
    display: block;
    margin-top: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--laser-cyan);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .hero__qualifier {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    margin: 0;
    line-height: 1.6;
  }

  .hero__visual {
    position: relative;
  }

  /* ── 2. Credibility strip ────────────────────── */
  .cred {
    background-color: var(--carbon-slate);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 1.5rem 0;
  }

  .cred__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem 2rem;
  }

  @media (min-width: 640px) {
    .cred__list { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .cred__list { grid-template-columns: repeat(3, 1fr); }
  }

  .cred__item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-left: 0.875rem;
    border-left: 2px solid var(--laser-cyan-border);
  }

  .cred__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .cred__detail {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    line-height: 1.5;
  }

  /* ── 3. Leaks ────────────────────────────────── */
  .leaks {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

