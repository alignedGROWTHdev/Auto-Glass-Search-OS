---
import BaseLayout from '../layouts/BaseLayout.astro';
import { methodologyStages, searchIntentMatrix } from '../data/siteData';

const pageTitle = "Auto Glass Search OS | Search & Customer Acquisition for Auto Glass Companies";
const pageDescription = "Turn search into booked auto glass jobs. Auto Glass Search OS helps established auto glass companies win customer demand across Google Search, Google Maps, and AI-powered discovery.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- ════════════════════════════════════════════
       HERO
       ════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container">
      <div class="hero__content">

        <span class="eyebrow eyebrow--blue" aria-label="Specialized Auto Glass Search and Customer Acquisition">
          <span class="status-dot" aria-hidden="true"></span>
          Specialized Auto Glass Search &amp; Customer Acquisition
        </span>

        <h1 id="hero-heading" class="hero__heading text-balance">
          Turn Search Into<br />
          <span class="hero__heading-accent">Booked Auto Glass Jobs.</span>
        </h1>

        <p class="hero__lead">
          Auto Glass Search OS helps established auto glass companies win customer demand across Google Search, Google Maps, and AI-powered discovery.
        </p>

        <p class="hero__sub">
          SEO, local 3-pack visibility, AI search optimization, and call conversion — built specifically for independent and regional auto glass operators.
        </p>

        <div class="hero__actions">
          <a
            href="/visibility-analysis/"
            data-analytics-event="primary_cta_click"
            class="btn btn--primary btn--lg"
          >
            Get Your Visibility Analysis
          </a>
          <a
            href="#search-methodology"
            data-analytics-event="secondary_cta_click"
            class="btn btn--secondary btn--lg"
          >
            See How It Works
          </a>
        </div>

        <p class="hero__qualifier">
          Built for established auto glass companies investing seriously in growth.
        </p>

      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       CUSTOMER SEARCH PROBLEM
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="search-reality-heading">
    <div class="container">

      <div class="section__header section__header--center">
        <span class="eyebrow" aria-hidden="true">The Customer Search Reality</span>
        <h2 id="search-reality-heading" class="text-balance">
          Your customers are searching right now.
        </h2>
        <p class="section__lead">
          Auto glass is often an urgent purchase. After windshield damage, drivers move quickly across search results, Maps, reviews, websites, insurance information, and phone calls while deciding whom to trust.
        </p>
      </div>

      <div class="grid-3">
        <article class="card">
          <div class="stage-badge" aria-label="Point 01">01</div>
          <h3 class="card__title">The Urgent Local Query</h3>
          <p class="card__body">
            Drivers query "windshield replacement near me same day" or "mobile auto glass repair [city]." Limited visibility across local results can move that opportunity toward another provider.
          </p>
        </article>

        <article class="card">
          <div class="stage-badge" aria-label="Point 02">02</div>
          <h3 class="card__title">Emerging AI &amp; Synthesis Prompts</h3>
          <p class="card__body">
            Vehicle owners ask AI-assisted search experiences questions such as "Which nearby auto glass shops provide ADAS recalibration?" Clear entity, service, and location information helps these systems interpret available options.
          </p>
        </article>

        <article class="card">
          <div class="stage-badge" aria-label="Point 03">03</div>
          <h3 class="card__title">Instant Phone Call Decision</h3>
          <p class="card__body">
            Many urgent auto glass decisions move to a phone call or quote request. Clear information about service availability, insurance support, mobile coverage, and warranties reduces friction in that decision.
          </p>
        </article>
      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════════
       SEARCH ECOSYSTEM
       ════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="ecosystem-heading">
    <div class="container">

      <div class="section__header">
        <span class="eyebrow">The Customer Search Layer</span>
        <h2 id="ecosystem-heading" class="text-balance">
          A unified engine across every search surface.
        </h2>
        <p class="section__sub">
          Google Search &rarr; Google Maps &rarr; AI Search &rarr; Reviews + Authority &rarr; Website / Calls &rarr; Booked Jobs.
        </p>
      </div>

      <div class="surface-grid" role="list" aria-label="Search surfaces">
        <div class="surface-tile" role="listitem">
          <span class="surface-tile__label eyebrow">01. Organic</span>
          <span class="surface-tile__name">Google Search</span>
          <span class="surface-tile__desc">Windshield &amp; ADAS Pillars</span>
        </div>
        <div class="surface-tile" role="listitem">
          <span class="surface-tile__label eyebrow">02. Maps</span>
          <span class="surface-tile__name">Google 3-Pack</span>
          <span class="surface-tile__desc">Proximity &amp; Geo-Radius</span>
        </div>
        <div class="surface-tile" role="listitem">
          <span class="surface-tile__label eyebrow">03. AI Search</span>
          <span class="surface-tile__name">ChatGPT / GEO</span>
          <span class="surface-tile__desc">Entity Recommendations</span>
        </div>
        <div class="surface-tile" role="listitem">
          <span class="surface-tile__label eyebrow">04. Trust</span>
          <span class="surface-tile__name">Reviews &amp; Authority</span>
          <span class="surface-tile__desc">Insurance &amp; Warranty</span>
        </div>
        <div class="surface-tile" role="listitem">
          <span class="surface-tile__label eyebrow">05. Conversion</span>
          <span class="surface-tile__name">Direct Phone Calls</span>
          <span class="surface-tile__desc">Mobile Dispatch Quotes</span>
        </div>
        <div class="surface-tile surface-tile--final" role="listitem">
          <span class="surface-tile__label eyebrow">06. Measured</span>
          <span class="surface-tile__name surface-tile__name--accent">Booked Jobs</span>
          <span class="surface-tile__desc surface-tile__desc--success">Revenue Attribution</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════════
       TWO WAYS TO OPERATE
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="engagement-models-heading">
    <div class="container">

      <div class="section__header section__header--center">
        <span class="eyebrow">Engagement Models</span>
        <h2 id="engagement-models-heading" class="text-balance">
          One Search OS. Two ways to operate it.
        </h2>
        <p class="section__lead">
          You don't have to choose between outsourcing search forever and trying to build an AI-powered search operation internally without senior expertise. We provide both paths.
        </p>
      </div>

      <div class="models-grid">
        <!-- Managed -->
        <article class="card model-card">
          <header class="model-card__header">
            <h3 class="model-card__title">Managed Search OS</h3>
            <span class="model-card__mode eyebrow eyebrow--blue">We run it for you.</span>
          </header>
          <p class="card__body">
            Our highest-touch engagement. Designed for established auto glass companies that want a specialized external search team responsible for strategy and execution across Google, Maps, AI, and conversion.
          </p>
          <ul class="model-card__list" role="list">
            <li class="arrow-item">End-to-end SEO &amp; Maps management</li>
            <li class="arrow-item">AI search visibility monitoring</li>
            <li class="arrow-item">Measurement centered on booked-job outcomes</li>
          </ul>
          <a href="/visibility-analysis/" data-analytics-event="managed_search_os_interest" class="btn btn--ghost">
            Get Your Analysis &rarr;
          </a>
        </article>

        <!-- Team -->
        <article class="card model-card">
          <header class="model-card__header">
            <h3 class="model-card__title">Search OS + Team</h3>
            <span class="model-card__mode eyebrow">We build it with your team.</span>
          </header>
          <p class="card__body">
            Designed for companies that want to develop internal search capability. We build the workflows, reusable AI instructions, knowledge systems, QA processes, and governance that help your team execute with ongoing senior support.
          </p>
          <ul class="model-card__list" role="list">
            <li class="arrow-item">System design &amp; technical architecture</li>
            <li class="arrow-item">Reusable AI instructions &amp; workflows</li>
            <li class="arrow-item">Senior strategy, QA, &amp; ongoing advisory</li>
          </ul>
          <a href="/visibility-analysis/" data-analytics-event="search_os_team_interest" class="btn btn--ghost">
            Get Your Analysis &rarr;
          </a>
        </article>
      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════════
       METHODOLOGY (FOUND → TRUSTED → CHOSEN → MEASURED)
       ════════════════════════════════════════════ -->
  <section id="search-methodology" class="section" aria-labelledby="methodology-heading">
    <div class="container">

      <div class="section__header section__header--center">
        <span class="eyebrow">Core Operating System</span>
        <h2 id="methodology-heading" class="text-balance">
          The 4-Stage Methodology
        </h2>
        <p class="section__lead">
          Search OS coordinates strategy, execution, workflows, human quality assurance, and measurement across the customer journey instead of treating each search channel as an isolated task.
        </p>
      </div>

      <div class="grid-4" role="list" aria-label="Methodology stages">
        {methodologyStages.map((stage) => (
          <article class="card stage-card" role="listitem">
            <header class="stage-card__header">
              <span class="stage-card__title">{stage.title}</span>
              <span class="stage-tag" aria-label={`Stage ${stage.step}`}>
                Stage {stage.step}
              </span>
            </header>
            <span class="eyebrow eyebrow--blue stage-card__subtitle">{stage.subtitle}</span>
            <p class="card__body">{stage.description}</p>
            <div class="stage-card__metrics">
              <span class="stage-card__metrics-label">Operational Metrics</span>
              <ul class="stage-card__metrics-list" role="list">
                {stage.signals.map((s) => (
                  <li class="check-item">{s}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════════
       SEARCH INTENT MATRIX
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="intent-matrix-heading">
    <div class="container">

      <div class="section__header">
        <span class="eyebrow">Search Intent Calibration</span>
        <h2 id="intent-matrix-heading" class="text-balance">
          Not all auto glass searches are created equal.
        </h2>
        <p class="section__sub">
          Different customer queries indicate completely different buying urgency, commercial value, and conversion paths:
        </p>
      </div>

      <div class="table-scroll" role="region" aria-label="Search intent matrix" tabindex="0">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Customer Query Intent</th>
              <th scope="col">Sample Driver Search</th>
              <th scope="col">Primary Discovery Surface</th>
              <th scope="col">Conversion Architecture</th>
              <th scope="col">Target Job Value</th>
            </tr>
          </thead>
          <tbody>
            {searchIntentMatrix.map((item) => (
              <tr>
                <td class="intent-cell--primary">{item.queryType}</td>
                <td class="intent-cell--query">{item.sampleQuery}</td>
                <td>{item.primarySurface}</td>
                <td class="intent-cell--muted">{item.conversionMechanism}</td>
                <td class="intent-cell--value">{item.targetValue}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════════
       MEASUREMENT
       ════════════════════════════════════════════ -->
  <section class="section section--measure" aria-labelledby="measurement-heading">
    <div class="container">
      <div class="measure-inner">
        <span class="eyebrow">Revenue Accountability</span>
        <h2 id="measurement-heading" class="text-balance">
          Measure booked jobs, not just rankings.
        </h2>
        <p class="measure-body">
          Where reliable call, quote, booking, and revenue data are available, measurement can connect search activity with qualified inquiries and booked jobs — not just rankings or traffic.
        </p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       IDEAL CLIENT PROFILE
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="icp-heading">
    <div class="container">
      <div class="icp-card">
        <div class="icp-card__content">
          <span class="eyebrow">Partnership Profile</span>
          <h2 id="icp-heading" class="text-balance">
            Built for auto glass companies ready to scale.
          </h2>
          <p class="icp-card__desc">
            Auto Glass Search OS is designed for established, growth-oriented operators with meaningful shop, mobile-service, or internal marketing capacity.
          </p>
          <ul class="icp-card__list" role="list">
            <li class="check-item">Established regional or multi-location operator</li>
            <li class="check-item">Established team, shop, or mobile service capacity</li>
            <li class="check-item">In-shop facility and/or mobile service coverage</li>
            <li class="check-item">Actively competing against Safelite &amp; consolidators</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       FINAL CTA
       ════════════════════════════════════════════ -->
  <section class="section section--cta" aria-labelledby="final-cta-heading">
    <div class="container">
      <div class="final-cta">
        <span class="eyebrow">Opportunity Diagnostic</span>
        <h2 id="final-cta-heading" class="final-cta__heading text-balance">
          See where competitors are capturing jobs you're missing.
        </h2>
        <p class="final-cta__desc">
          Request a complimentary search and AI visibility analysis for your auto glass company. We inspect your Google Maps 3-Pack rank, organic visibility, AI search inclusion, and call conversion friction.
        </p>
        <a
          href="/visibility-analysis/"
          data-analytics-event="primary_cta_click"
          class="btn btn--primary btn--lg"
        >
          Get Your Search + AI Visibility Analysis
        </a>
        <p class="final-cta__note">
          Manually reviewed &middot; Confidential opportunity analysis
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────── */
  .hero {
    padding-top: 5rem;
    padding-bottom: 6rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background-color: var(--surface-00);
  }

  .hero__content {
    max-width: 56rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero__heading {
    font-size: clamp(2.5rem, 6vw + 0.5rem, 4.25rem);
    font-weight: 800;
    line-height: 1.0;
    letter-spacing: -0.025em;
    color: var(--text-primary);
  }

  .hero__heading-accent {
    color: var(--blue);
    display: block;
  }

  .hero__lead {
    font-size: clamp(1rem, 1.5vw + 0.5rem, 1.25rem);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 44rem;
  }

  .hero__sub {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    letter-spacing: 0.02em;
    max-width: 40rem;
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    padding-top: 0.5rem;
  }

  .hero__qualifier {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    letter-spacing: 0.04em;
    border-top: 1px solid rgba(255,255,255,0.07);
    padding-top: 1.5rem;
    margin-top: 0.5rem;
  }

  /* ── Section base ─────────────────────────────── */
  .section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background-color: var(--surface-00);
  }

  .section--alt {
    background-color: var(--surface-01);
  }

  .section--measure {
    background-color: var(--surface-01);
    text-align: center;
  }

  .section--cta {
    background-color: var(--surface-00);
    text-align: center;
  }

  .section__header {
    max-width: 48rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-bottom: 3.5rem;
  }

  .section__header--center {
    margin-inline: auto;
    text-align: center;
    align-items: center;
  }

  .section__lead {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .section__sub {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    letter-spacing: 0.02em;
  }

  /* ── Grids ────────────────────────────────────── */
  .grid-3 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .grid-3 { grid-template-columns: repeat(3, 1fr); }
  }

  .grid-4 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .grid-4 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .grid-4 { grid-template-columns: repeat(4, 1fr); }
  }

  /* ── Cards ────────────────────────────────────── */
  .card__title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .card__body {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* ── Surface grid ─────────────────────────────── */
  .surface-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    text-align: center;
  }

  @media (min-width: 640px) {
    .surface-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (min-width: 1024px) {
    .surface-grid { grid-template-columns: repeat(6, 1fr); }
  }

  .surface-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 1.25rem 0.75rem;
    background-color: var(--surface-02);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: var(--radius-lg);
  }

  .surface-tile--final {
    background-color: rgba(49, 130, 246, 0.08);
    border-color: rgba(49, 130, 246, 0.25);
  }

  .surface-tile__label {
    font-size: 0.6875rem;
  }

  .surface-tile__name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .surface-tile__name--accent {
    color: var(--blue);
  }

  .surface-tile__desc {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    line-height: 1.5;
  }

  .surface-tile__desc--success {
    color: var(--blue-hover);
    font-weight: 500;
  }

  /* ── Engagement Models ────────────────────────── */
  .models-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 60rem;
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .models-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .model-card {
    justify-content: space-between;
  }

  .model-card__header {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .model-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .model-card__mode {
    letter-spacing: 0.08em;
  }

  .model-card__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* ── Stage cards ──────────────────────────────── */
  .stage-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    padding-bottom: 0.875rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .stage-card__title {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-primary);
  }

  .stage-card__subtitle {
    font-size: 0.6875rem;
  }

  .stage-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius);
    background-color: rgba(49, 130, 246, 0.1);
    border: 1px solid rgba(49, 130, 246, 0.2);
    color: var(--blue);
    white-space: nowrap;
  }

  .stage-card__metrics {
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,0.06);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: auto;
  }

  .stage-card__metrics-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .stage-card__metrics-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  /* ── Intent matrix table ──────────────────────── */
  .table-scroll {
    overflow-x: auto;
    border-radius: var(--radius-xl);
  }

  .intent-cell--primary {
    font-weight: 600;
    color: var(--text-primary);
  }

  .intent-cell--query {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--blue);
  }

  .intent-cell--muted {
    color: var(--text-tertiary);
  }

  .intent-cell--value {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--blue-hover);
    font-weight: 500;
    white-space: nowrap;
  }

  /* ── Measurement section ──────────────────────── */
  .measure-inner {
    max-width: 44rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
  }

  .measure-body {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 36rem;
    text-align: center;
  }

  /* ── ICP card ─────────────────────────────────── */
  .icp-card {
    border-radius: var(--radius-2xl);
    border: 1px solid rgba(255,255,255,0.1);
    background-color: var(--surface-02);
    padding: 3rem;
  }

  @media (max-width: 639px) {
    .icp-card { padding: 2rem 1.5rem; }
  }

  .icp-card__content {
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .icp-card__desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .icp-card__list {
    list-style: none;
    padding: 0;
    margin: 0;
