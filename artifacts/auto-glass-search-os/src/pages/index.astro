---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConversionPaths from '../components/ConversionPaths.astro';
import PartnerCallout from '../components/PartnerCallout.astro';
import LeadForm from '../components/LeadForm.astro';
import { siteConfig, services } from '../data/siteData';
import { serviceSchema, faqSchema } from '../data/schema';

const pageTitle = "Auto Glass Marketing Agency | Websites, SEO & Leads";
const pageDescription = "Auto glass marketing, websites and lead generation for established auto glass companies. Turn more customer demand into qualified calls, quotes and booked jobs.";

// Three things an owner needs to understand in the first screen.
const outcomes = [
  { title: "Get found", body: "Show up in the top map results, on page one, in Google Ads and in AI answers when a driver in your area needs windshield repair, replacement, mobile service or ADAS calibration.", services: services.filter(x => ["01","02","03","06"].includes(x.num)) },
  { title: "Get chosen", body: "Give that driver a reason to pick you over the shop above or below you: a fast site, strong reviews, and clear answers on insurance and warranty.", services: services.filter(x => ["04"].includes(x.num)) },
  { title: "Get booked — and know what worked", body: "One tap to call, a short quote form, and every call and quote tracked back to the channel that produced it, so you know what's creating jobs.", services: services.filter(x => ["05","07"].includes(x.num)) },
];

// Where shops lose jobs — four points, in plain terms.
const leaks = [
  { tag: "They never see you", body: "A competitor holds the top three map results and page one for windshield replacement or ADAS calibration in your market. The driver calls them." },
  { tag: "They see you and pick someone else", body: "Fewer reviews, a slow or dated website, no clear answer on insurance or warranty. The decision takes thirty seconds." },
  { tag: "They want you but can't reach you", body: "Three taps to find a phone number, a long form, no hours or service area on the page. Or the call goes to voicemail and they move on." },
  { tag: "You can't tell what's working", body: "Money goes out to marketing every month, but nobody can say which channel produced the jobs on this week's schedule." },
];

// Homepage FAQ — the questions owners ask before they fill out the form.
const faqs = [
  { question: "What does an auto glass marketing agency do?", answer: "Auto Glass Growth is an auto glass marketing agency built for one industry — what some owners call auto glass digital marketing or internet marketing. We make your shop the one drivers find and choose: page-one rankings and the Google map pack, Google Ads for high-intent searches, Meta ads that reach drivers on Facebook and Instagram before they search, and visibility in AI Overviews and AI assistants, where more people now ask \"who should I call?\" We also run digital PR — earning mentions and recommendations on the sites, directories and local publications drivers already trust — so your shop shows up wherever someone is looking for a recommendation, not just on Google. Then we track every call and quote request back to the channel that produced it. We call that method the Auto Glass Growth OS — it's how we work, not software you have to learn." },
  { question: "How much does auto glass marketing cost?", answer: "We don't sell fixed packages, because a one-truck mobile operator in a small market and a three-location shop competing against national chains don't need the same work. Every engagement starts with the free Growth Analysis. We audit your market, identify the gaps between you and the shops outranking you, and work out what it would actually take to close them. From that, we put together tiers built around your market's demand, your competition and the jobs you want more of — replacements, ADAS calibration, insurance, fleet or mobile — so you're paying for what your shop needs, not a menu." },
  { question: "What happens after the free Growth Analysis?", answer: "Within 2–3 business days we send you a recorded video walkthrough of your market: who's winning the searches you should own, where you're losing drivers, and what we'd fix first. You can watch it on your own time, and there's no obligation. If what you see makes sense, the next step is a discovery call — a conversation about how your shop actually runs, which jobs you want more of, and where you want to be in a year. That's where we learn whether we're the right fit for each other. If we are, we come back with tiers scoped to your business." },
  { question: "Can you get my shop into the Google map pack?", answer: "Map pack positions can't be bought — Google decides them on relevance, distance and prominence — which is exactly why they're worth winning. Our approach targets all three. We audit the shops holding the top three spots to see what Google is rewarding them for, then close the gaps: a Google Business Profile that's complete and category-correct, service pages that match how drivers in your area search, a repeatable review process that builds prominence month after month, and consistent listings across the web. It's the same playbook every time; what changes is which gaps your market needs closed first." },
  { question: "Do you offer AI voice or call answering for auto glass shops?", answer: "Yes, through a dedicated partner we work with. Missed and after-hours calls are one of the biggest leaks we see in auto glass, so an AI voice agent that answers, quotes and books is often part of a shop's plan. We own the strategy — where it fits in your call flow, what it should say, how it hands off to your team — and our partner handles the implementation and support. You get one plan and one point of contact; the technology stays with the people who built it." },
  { question: "Does Auto Glass Growth sell auto glass leads?", answer: "No. We don't sell leads and we don't sell software. We build and run the marketing, website and conversion system that brings drivers to your business — your website, your Google listing, your ads. Every call and quote request is yours." },
];

const homeSchema = [
  serviceSchema({
    pagePath: "/",
    name: "Auto Glass Marketing, Websites & Lead Generation",
    serviceType: "Auto glass marketing agency services: SEO, Google Maps, Google Ads, website design, conversion optimization, AI search visibility, analytics and measurement",
    description: pageDescription,
    alternateName: ["Auto Glass Marketing Agency", "Auto Glass Digital Marketing", "Marketing for Auto Glass Companies"],
  }),
  faqSchema(faqs, "/"),
];
---

<BaseLayout title={pageTitle} description={pageDescription} extraSchema={homeSchema}>

  <!-- ════════════════════════════════════════════
       1. HERO
       ════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container">
      <div class="hero__layout">

        <div class="hero__content fade-up">
          <span class="hero__kicker">Marketing, websites and lead generation for auto glass shops</span>

          <h1 id="hero-heading" class="hero__heading text-balance">
            Auto Glass Marketing That Turns
            <span class="hero__heading-accent">More Customer Demand Into Booked Jobs.</span>
          </h1>

          <p class="hero__lead">
            We help auto glass shops show up when drivers need windshield repair, replacement, mobile service or ADAS calibration — and turn more of those searches into calls, quote requests and booked work.
          </p>

          <p class="hero__mechanism">
            We help you get found, make it easy for drivers to choose you, and turn more calls and quote requests into booked work. We call the system behind that the Auto Glass Growth OS — but it's how we work, not software you have to learn.
          </p>

          <div class="hero__actions fade-up fade-up--delay-1">
            <a href="#growth-analysis-form" data-analytics-event="primary_cta_click" class="btn btn--primary btn--lg">
              {siteConfig.primaryCta}
            </a>
            <a href="#how-it-works" data-analytics-event="secondary_cta_click" class="btn btn--secondary btn--lg">
              See How It Works
            </a>
          </div>

          <p class="hero__qualifier">
            Reviewed by our senior team. Specific to your shop. No cost, no obligation.
          </p>
        </div>

        <div class="hero__visual fade-up fade-up--delay-2">
          <div class="hero__form is-light" id="growth-analysis-form">
            <h2 class="hero__form-title">Request your free growth analysis</h2>
            <p class="hero__form-sub">Seven quick fields. A person reads every one — you get a recorded video walkthrough within 2–3 business days.</p>
            <LeadForm compact />
            <p class="hero__form-foot">No cost, no obligation. We don't sell leads — your analysis is yours.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       2. TRUST STRIP (three points)
       ════════════════════════════════════════════ -->
  <section class="cred" aria-label="Who this is for">
    <div class="container">
      <p class="cred__text">
        Built for independent shops, mobile operators and multi-location groups handling replacements, repairs, mobile service and ADAS calibration — not generic local businesses. We start with the jobs you can profitably serve — replacement, ADAS, insurance, fleet — your service area, and how your phone gets answered. And we don't sell leads or software: your website, your Maps listing, your ads and every call they produce belong to you.
      </p>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       3. THREE OUTCOMES
       ════════════════════════════════════════════ -->
  <section id="how-it-works" class="section" aria-labelledby="outcomes-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="kicker">How we work</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="outcomes-heading" class="section-heading text-balance">Auto glass marketing in three steps: get found, get chosen, get booked.</h2>
        <p class="section-lead">
          The demand in your market is already there. Drivers are searching today. Our job is to make sure more of them find you, pick you and reach you — and that you can see it happening.
        </p>
      </div>
      <ol class="outcomes" role="list">
        {outcomes.map((o, i) => (
          <li class="outcome" role="listitem">
            <h3 class="outcome__title">{o.title}</h3>
            <p class="outcome__body">{o.body}</p>
            <ul class="outcome__services" role="list" aria-label={`${o.title} services`}>
              {o.services.map((m) => (
                <li><a href={m.href} class="outcome__service" data-analytics-event="module_link_click">{m.title} &rarr;</a></li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
      <div class="outcomes__foot">
        <a href="/auto-glass-lead-generation/" data-analytics-event="leadgen_learn_more" class="btn btn--secondary">
          How it all works together as lead generation &rarr;
        </a>
        <a href="/auto-glass-digital-marketing/" data-analytics-event="channels_learn_more" class="outcomes__foot-link">
          Every auto glass digital marketing channel, ranked for shop owners &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       4. WHERE SHOPS LOSE JOBS
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="leaks-heading">
    <div class="container">
      <div class="leaks">
        <div class="leaks__intro">
          <span class="kicker">Where the jobs go</span>
          <span class="cyan-rule"></span>
          <h2 id="leaks-heading" class="section-heading text-balance">Where auto glass shops lose jobs.</h2>
          <p class="section-lead">
            A driver catches a rock on the highway at 7:40 a.m. In the parking lot at work she searches "windshield replacement near me." Three shops show up on the map. She taps the one with the most reviews and calls. If that isn't you, that job was gone before you knew it existed.
          </p>
          <p class="section-lead">
            Most shops lose jobs at one of four points. Usually more than one.
          </p>
          <a href="/visibility-analysis/" class="leaks__cta" data-analytics-event="leaks_cta_click">Find out which ones are costing you jobs &rarr;</a>
        </div>
        <ol class="leaks__grid" role="list">
          {leaks.map((l, i) => (
            <li class="leak" role="listitem">
              <span class="leak__tag">{l.tag}</span>
              <p class="leak__body">{l.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       5. MID-PAGE CTA — what the analysis shows you
       ════════════════════════════════════════════ -->
  <section class="section section--midcta" aria-labelledby="midcta-heading">
    <div class="container">
      <div class="midcta">
        <div class="midcta__copy">
          <span class="kicker">Free Growth Analysis</span>
          <span class="cyan-rule"></span>
          <h2 id="midcta-heading" class="section-heading text-balance">See where you're losing jobs — and what to fix first.</h2>
          <p class="section-lead">We look at your market by hand and send you a recorded video walkthrough of what we found. No sales call required to get it.</p>
        </div>
        <div class="midcta__panel">
          <ul class="midcta__list" role="list" aria-label="What the analysis tells you">
            <li class="check-item">Which competitors show up instead of you, and for which searches</li>
            <li class="check-item">Where drivers drop off before calling or requesting a quote</li>
            <li class="check-item">The three or four fixes most likely to create more booked jobs</li>
          </ul>
          <a href="/visibility-analysis/" data-analytics-event="primary_cta_click" class="btn btn--primary btn--lg btn--full">
            {siteConfig.primaryCta}
          </a>
          <p class="midcta__note">Manually reviewed &middot; Confidential &middot; No obligation &middot; <a href="/visibility-analysis/#scope">See everything we review</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       8. CLICK OR CALL — how it turns into work
       ════════════════════════════════════════════ -->
  <section class="section section--paths" aria-labelledby="paths-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="kicker">How it turns into work for your shop</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="paths-heading" class="section-heading text-balance">Whether they click or call, give them a clear path to book.</h2>
        <p class="section-lead">
          Showing up is wasted if the driver hits a dead end. We build both paths — the page they land on, the call button, the short quote form — and track each one to a booked job. Your team and the systems you choose handle the response and scheduling.
        </p>
      </div>
      <ConversionPaths />
      <div class="paths-partner">
        <PartnerCallout compact />
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       9. ENGAGEMENT MODELS
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="engagement-models-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="kicker">Two ways to work together</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="engagement-models-heading" class="section-heading text-balance">Two ways to work with Auto Glass Growth.</h2>
        <p class="section-lead">The goal isn't maximum traffic. It's the right demand your operation can profitably serve.</p>
      </div>
      <div class="models-grid">
        <article class="card model-card model-card--primary">
          <header class="model-card__header">
            <div class="model-card__header-top">
              <h3 class="model-card__title">Fully Managed Growth</h3>
              <span class="model-card__badge">Recommended</span>
            </div>
            <span class="model-card__mode">We run it for you.</span>
          </header>
          <p class="model-card__body">
            We run your search, Maps, ads, website, conversion and reporting as your outside marketing team. Your people stay focused on answering the phone and booking jobs.
          </p>
          <ul class="model-card__list" role="list">
            <li class="arrow-item">Strategy, execution and quality control</li>
            <li class="arrow-item">Reporting on qualified leads, appointments and booked jobs</li>
          </ul>
          <a href="/visibility-analysis/" data-analytics-event="managed_search_os_interest" class="btn btn--primary">
            {siteConfig.primaryCta} &rarr;
          </a>
        </article>

        <article class="card model-card">
          <header class="model-card__header">
            <div class="model-card__header-top">
              <h3 class="model-card__title">Growth OS + Your Team</h3>
            </div>
            <span class="model-card__mode">We build it with your team.</span>
          </header>
          <p class="model-card__body">
            Have someone in-house who handles marketing? We set up the system with them, then stay on for strategy, quality control and support as you add markets.
          </p>
          <ul class="model-card__list" role="list">
            <li class="arrow-item">Search systems and reusable workflows your team operates</li>
            <li class="arrow-item">The same measurement model, run internally</li>
          </ul>
          <a href="/visibility-analysis/" data-analytics-event="search_os_team_interest" class="btn btn--secondary">
            Start With an Analysis &rarr;
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       11. FAQ
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="home-faq-heading">
    <div class="container">
      <div class="section-header">
        <span class="kicker">Common questions</span>
        <span class="cyan-rule"></span>
        <h2 id="home-faq-heading" class="section-heading text-balance">Questions owners ask before they fill out the form.</h2>
      </div>
      <div class="home-faq__layout">
        <div class="home-faq">
          {faqs.map((f) => (
            <details class="home-faq__item">
              <summary class="home-faq__q">{f.question}</summary>
              <p class="home-faq__a">{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       12. FINAL CTA
       ════════════════════════════════════════════ -->
  <section class="section section--cta" aria-labelledby="final-cta-heading">
    <div class="container">
      <div class="final-cta">
        <span class="kicker">Free Growth Analysis</span>
        <span class="cyan-rule" style="margin: 0 auto;"></span>
        <h2 id="final-cta-heading" class="final-cta__heading text-balance">
          See where you're losing jobs — and how to win them back.
        </h2>
        <p class="final-cta__desc">
          We review your market by hand: who's winning the searches you should own, where drivers who find you don't become jobs, and what to fix first. You get a recorded video walkthrough within 2–3 business days. No sales call required.
        </p>
        <a href="/visibility-analysis/" data-analytics-event="primary_cta_click" class="btn btn--primary btn--lg">
          {siteConfig.primaryCta}
        </a>
        <p class="final-cta__note">
          Manually reviewed &middot; Confidential &middot; No obligation &middot; <a href="/visibility-analysis/#scope">See everything we review</a>
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Shared section scaffolding ─────────────── */
  .section {
    padding-top: 5.5rem;
    padding-bottom: 5.5rem;
    border-bottom: 1px solid var(--line);
    background-color: var(--obsidian);
  }

  .section--alt {
    background-color: var(--carbon-slate);
  }

  .section--journey {
    background-color: var(--obsidian);
  }

  .section--paths {
    background-color: var(--obsidian);
  }

  .section--cta {
    background-color: var(--obsidian);
    text-align: center;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
    max-width: 46rem;
  }

  .section-header--wide { max-width: 52rem; }

  .section-header--center {
    margin-inline: auto;
    text-align: center;
    align-items: center;
  }

  .section-heading {
    font-size: clamp(1.75rem, 2.8vw + 0.5rem, 2.625rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 0;
  }

  .section-lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* ── 1. Hero ─────────────────────────────────── */
  .hero {
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
    border-bottom: 1px solid var(--laser-cyan-dim);
    background-color: var(--obsidian);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 60%;
    height: 100%;
    pointer-events: none;
  }

  .hero__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
    position: relative;
  }

  @media (min-width: 1024px) {
    .hero__layout {
      grid-template-columns: 56fr 44fr;
      gap: 4rem;
    }
  }

  .hero__layout > * {
    min-width: 0;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 44rem;
  }

  .hero__heading {
    font-size: clamp(2.1rem, 3.6vw + 0.5rem, 3.25rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0;
  }

  .hero__heading-accent {
    color: var(--laser-cyan);
    display: block;
    text-shadow: none;
  }

  .hero__lead {
    font-size: clamp(1rem, 1.25vw + 0.5rem, 1.1875rem);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .hero__mechanism {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--laser-cyan);
    background: var(--laser-cyan-dim);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .hero__kicker {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--laser-cyan);
  }

  .kicker {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--laser-cyan);
    margin-bottom: 0.25rem;
  }


  .hero__form {
    padding: 2rem;
    background: var(--surface-00);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    scroll-margin-top: 6rem;
    box-shadow: var(--card-shadow);
  }

  .hero__form-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
  }

  .hero__form-sub {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }

  .hero__form-foot {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    text-align: center;
  }

  .hero__mechanism strong { color: var(--text-primary); }

  @media (max-width: 767px) {
    .hero__mechanism { display: none; }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .hero__qualifier {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    margin: 0;
    line-height: 1.6;
  }

  .hero__visual {
    position: relative;
  }

  /* ── 2. Who this is for ──────────────────────── */
  .cred {
    background-color: var(--carbon-slate);
    border-bottom: 1px solid var(--line);
    padding: 1.75rem 0;
  }

  .cred__text {
    margin: 0;
    max-width: 62rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  /* ── 3. Leaks ────────────────────────────────── */
  .leaks {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .leaks {
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .leaks__intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 1024px) {
    .leaks__intro { position: sticky; top: 6rem; }
  }

  .leaks__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .leaks__grid { grid-template-columns: repeat(2, 1fr); }
  }

  .leak {
    position: relative;
    padding: 1.5rem;
    background: var(--surface-00);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    box-shadow: var(--card-shadow);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .leak:hover {
    transform: translateY(-2px);
    box-shadow: var(--card-shadow-hover);
  }

  .leak::after {
    content: '';
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--fleet-amber);
