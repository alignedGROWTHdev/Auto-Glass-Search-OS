---
/**
 * BrandMark — the Auto Glass Growth "AG" mark from the brand kit.
 * variant "dark" (default) is the white-A version for dark backgrounds;
 * variant "light" is the navy-A original for light backgrounds.
 * Referenced as a file (not inlined) so the gradient id never collides
 * when the mark appears more than once on a page.
 */
interface Props {
  size?: number;
  class?: string;
  variant?: "dark" | "light";
}
const { size = 28, class: cls = '', variant = "dark" } = Astro.props;
const src = variant === "light" ? "/brand/auto-glass-growth-mark.svg" : "/brand/auto-glass-growth-mark-dark.svg";
---
<img src={src} width={size} height={size} alt="" aria-hidden="true" decoding="async" class={cls} style="display:block" />
