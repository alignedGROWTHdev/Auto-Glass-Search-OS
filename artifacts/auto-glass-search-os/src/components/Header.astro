---
import { siteConfig } from '../data/siteData';
const pathname = Astro.url.pathname;
---

<header class="agos-header" role="banner">
  <!-- System bar -->
  <div class="agos-header__bar" aria-hidden="true">
    <div class="agos-header__bar-inner container">
      <span class="agos-header__bar-label">
        <span class="status-dot"></span>
        <span>Specialized search for established auto glass companies</span>
      </span>
      <span class="agos-header__bar-meta">An Aligned Growth Digital Company</span>
    </div>
  </div>

  <!-- Primary navigation -->
  <div class="agos-header__primary">
    <div class="agos-header__inner container">

      <!-- Wordmark -->
      <a href="/" class="agos-wordmark" aria-label={`${siteConfig.name} — Home`}>
        <span class="ag-monogram" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <!-- A -->
            <path d="M2 20 L7 6 L12 20" stroke="var(--blue)" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" fill="none"/>
            <line x1="4.5" y1="15.5" x2="9.5" y2="15.5" stroke="var(--blue)" stroke-width="1.6" stroke-linecap="square"/>
            <!-- G -->
            <path d="M22 8.5 A5.8 5.8 0 1 0 22 17.5" stroke="var(--text-primary)" stroke-width="1.7" stroke-linecap="square" fill="none"/>
            <line x1="17.5" y1="13" x2="22" y2="13" stroke="var(--text-primary)" stroke-width="1.7" stroke-linecap="square"/>
            <line x1="22" y1="13" x2="22" y2="17.5" stroke="var(--text-primary)" stroke-width="1.7" stroke-linecap="square"/>
          </svg>
        </span>
        <span class="agos-wordmark__text">
          <span class="agos-wordmark__primary">AUTO GLASS</span>
          <span class="agos-wordmark__accent"> SEARCH OS</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="agos-nav" aria-label="Primary navigation">
        {siteConfig.navLinks.map((item) => {
          const isActive = pathname === item.href || (item.href !== "/" && pathname.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`nav-link ${isActive ? 'nav-link--active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- CTA -->
      <div class="agos-header__cta">
        <a
          href="/visibility-analysis/"
          data-analytics-event="primary_cta_click"
          class="btn btn--primary btn--sm"
        >
          Get Visibility Analysis
        </a>
      </div>

      <!-- Mobile CTA -->
      <div class="agos-header__mobile-cta">
        <a
          href="/visibility-analysis/"
          data-analytics-event="primary_cta_click"
          class="btn btn--primary btn--sm"
          aria-label="Get Visibility Analysis"
        >
          Analysis
        </a>
      </div>

    </div>
  </div>
</header>

<style>
  /* ── Header shell ─────────────────────────────────────── */
  .agos-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background-color: rgba(7, 17, 28, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  /* ── System bar ───────────────────────────────────────── */
  .agos-header__bar {
    display: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    background-color: rgba(11, 31, 48, 0.5);
  }

  @media (min-width: 768px) {
    .agos-header__bar { display: block; }
  }

  .agos-header__bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.375rem;
    padding-bottom: 0.375rem;
  }

  .agos-header__bar-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--text-tertiary);
  }

  .agos-header__bar-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--text-tertiary);
  }

  /* ── Primary nav row ──────────────────────────────────── */
  .agos-header__primary {
    /* nothing extra */
  }

  .agos-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.5rem;
  }

  /* ── Wordmark ─────────────────────────────────────────── */
  .agos-wordmark {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity var(--transition-fast);
  }

  .agos-wordmark:hover {
    opacity: 0.85;
  }

  .agos-wordmark__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
    gap: 0.125rem;
  }

  .agos-wordmark__primary {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-primary);
  }

  .agos-wordmark__accent {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--blue);
  }

  /* ── Desktop nav ──────────────────────────────────────── */
  .agos-nav {
    display: none;
    align-items: center;
    gap: 0.125rem;
    flex: 1;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .agos-nav { display: flex; }
  }

  /* ── Desktop CTA ──────────────────────────────────────── */
  .agos-header__cta {
    display: none;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .agos-header__cta { display: flex; }
  }

  /* ── Mobile CTA ───────────────────────────────────────── */
  .agos-header__mobile-cta {
    display: flex;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .agos-header__mobile-cta { display: none; }
  }
</style>
