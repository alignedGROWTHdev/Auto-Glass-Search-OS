---
import { siteConfig } from '../data/siteData';
const pathname = Astro.url.pathname;
---

<header class="agos-header" role="banner">
  <!-- System bar -->
  <div class="agos-header__bar" aria-hidden="true">
    <div class="agos-header__bar-inner container">
      <span class="agos-header__bar-label">
        <span class="status-dot"></span>
        <span>Auto glass marketing, websites &amp; lead generation &middot; SEO &middot; Google Maps &middot; Google Ads &middot; Websites &middot; CRO &middot; AI Search</span>
      </span>
    </div>
  </div>

  <!-- Primary navigation -->
  <div class="agos-header__primary">
    <div class="agos-header__inner container">

      <!-- Official brand-kit logo lockup -->
      <a href="/" class="agos-wordmark" aria-label={`${siteConfig.name} — Home`}>
        <img
          src="/brand/auto-glass-growth-logo-white.svg"
          width="1320"
          height="320"
          alt=""
          aria-hidden="true"
          class="agos-wordmark__logo"
          decoding="async"
        />
      </a>

      <!-- Desktop nav -->
      <nav class="agos-nav" aria-label="Primary navigation">
        {siteConfig.navLinks.map((item) => {
          const isActive = pathname === item.href || (item.href !== "/" && pathname.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`nav-link ${isActive ? 'nav-link--active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- CTA -->
      <div class="agos-header__cta">
        <a
          href="/visibility-analysis/"
          data-analytics-event="primary_cta_click"
          class="btn btn--primary btn--sm"
        >
          See Where You're Losing Jobs
        </a>
      </div>

      <!-- Mobile CTA -->
      <div class="agos-header__mobile-cta">
        <a
          href="/visibility-analysis/"
          data-analytics-event="primary_cta_click"
          class="btn btn--primary btn--sm"
          aria-label="Get Visibility Analysis"
        >
          Analysis
        </a>
      </div>

    </div>
  </div>
</header>

<style>
  /* ── Header shell ─────────────────────────────────────── */
  .agos-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background-color: rgba(11, 15, 25, 0.92);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid rgba(0, 210, 255, 0.1);
  }

  /* ── System bar ───────────────────────────────────────── */
  .agos-header__bar {
    display: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    background-color: rgba(19, 27, 46, 0.6);
  }

  @media (min-width: 768px) {
    .agos-header__bar { display: block; }
  }

  .agos-header__bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.3125rem;
    padding-bottom: 0.3125rem;
  }

  .agos-header__bar-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
  }

  /* ── Primary nav row ──────────────────────────────────── */
  .agos-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }

  /* ── Wordmark ─────────────────────────────────────────── */
  .agos-wordmark {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity var(--transition-fast);
  }

  .agos-wordmark:hover {
    opacity: 0.85;
  }

  .agos-wordmark__logo {
    display: block;
    width: auto;
    height: 2.25rem;
  }

  /* ── Desktop nav ──────────────────────────────────────── */
  .agos-nav {
    display: none;
    align-items: center;
    gap: 0.125rem;
    flex: 1;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .agos-nav { display: flex; flex-wrap: nowrap; white-space: nowrap; }
  }

  /* Seven links: tighten spacing below 1200px so the nav stays on one line */
  @media (min-width: 1024px) and (max-width: 1199px) {
    .agos-nav :global(.nav-link) { padding: 0.375rem 0.5rem; font-size: 0.75rem; }
  }

  /* ── Desktop CTA ──────────────────────────────────────── */
  .agos-header__cta {
    display: none;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .agos-header__cta { display: flex; }
  }

  /* ── Mobile CTA ───────────────────────────────────────── */
  .agos-header__mobile-cta {
    display: flex;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .agos-header__mobile-cta { display: none; }
  }
</style>
