---
import { siteConfig } from '../data/siteData';
import BrandMark from './BrandMark.astro';
const pathname = Astro.url.pathname;
---

<header class="agos-header" role="banner">
  <!-- Primary navigation -->
  <div class="agos-header__primary">
    <div class="agos-header__inner container">

      <!-- Windshield Growth identity lockup -->
      <a href="/" class="agos-wordmark" aria-label={`${siteConfig.name} — Home`}>
        <BrandMark size={38} />
        <span class="agos-wordmark__text" aria-hidden="true">
          <span class="agos-wordmark__primary">AUTO GLASS</span>
          <span class="agos-wordmark__accent">GROWTH</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="agos-nav" aria-label="Primary navigation">
        {siteConfig.navLinks.map((item) => {
          const isActive = pathname === item.href || (item.href !== "/" && pathname.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`nav-link ${isActive ? 'nav-link--active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- Mobile / tablet navigation -->
      <details class="agos-menu">
        <summary class="agos-menu__toggle">
          <span class="agos-menu__icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span>Menu</span>
        </summary>
        <div class="agos-menu__panel">
          <nav class="agos-menu__nav" aria-label="Mobile navigation">
            {siteConfig.navLinks.map((item) => {
              const isActive = pathname === item.href || (item.href !== "/" && pathname.startsWith(item.href));
              return (
                <a
                  href={item.href}
                  class={`agos-menu__link ${isActive ? 'agos-menu__link--active' : ''}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span>{item.name}</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              );
            })}
          </nav>
          <a
            href="/visibility-analysis/"
            data-analytics-event="primary_cta_click"
            class="btn btn--primary agos-menu__cta"
          >
            {siteConfig.primaryCta}
          </a>
        </div>
      </details>

      <!-- CTA -->
      <div class="agos-header__cta">
        <a
          href="/visibility-analysis/"
          data-analytics-event="primary_cta_click"
          class="btn btn--primary btn--sm"
        >
          {siteConfig.primaryCta}
        </a>
      </div>

    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const menu = document.querySelector('.agos-menu');
    if (!(menu instanceof HTMLDetailsElement)) return;

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.removeAttribute('open'));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.removeAttribute('open');
        menu.querySelector('summary')?.focus();
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) menu.removeAttribute('open');
    });
  })();
</script>

<style>
  /* ── Header shell ─────────────────────────────────────── */
  .agos-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background-color: rgba(11, 15, 25, 0.92);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid rgba(0, 210, 255, 0.1);
  }

  /* ── Primary nav row ──────────────────────────────────── */
  .agos-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }

  /* ── Wordmark ─────────────────────────────────────────── */
  .agos-wordmark {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity var(--transition-fast);
  }

  .agos-wordmark:hover {
    opacity: 0.85;
  }

  .agos-wordmark__text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    line-height: 1;
  }

  .agos-wordmark__primary,
  .agos-wordmark__accent {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.075em;
  }

  .agos-wordmark__primary {
    color: var(--text-primary);
  }

  .agos-wordmark__accent {
    color: var(--brand-blue);
  }

  /* ── Desktop nav ──────────────────────────────────────── */
  .agos-nav {
    display: none;
    align-items: center;
    gap: 0.125rem;
    flex: 1;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .agos-nav { display: flex; flex-wrap: nowrap; white-space: nowrap; }
  }

  /* Seven links: tighten spacing below 1200px so the nav stays on one line */
  @media (min-width: 1024px) and (max-width: 1199px) {
    .agos-nav :global(.nav-link) { padding: 0.375rem 0.5rem; font-size: 0.75rem; }
  }

  /* ── Mobile / tablet menu ─────────────────────────────── */
  .agos-menu {
    margin-left: auto;
  }

  .agos-menu__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid rgba(0, 210, 255, 0.24);
    border-radius: var(--radius-lg);
    background: rgba(19, 27, 46, 0.8);
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .agos-menu__toggle::-webkit-details-marker {
    display: none;
  }

  .agos-menu__toggle:hover,
  .agos-menu__toggle:focus-visible,
  .agos-menu[open] .agos-menu__toggle {
    border-color: var(--laser-cyan);
    background: var(--surface-02);
    outline: none;
  }

  .agos-menu__icon {
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    width: 1rem;
  }

  .agos-menu__icon span {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--laser-cyan);
    transition:
      transform var(--transition-fast),
      opacity var(--transition-fast);
  }

  .agos-menu[open] .agos-menu__icon span:first-child {
    transform: translateY(0.275rem) rotate(45deg);
  }

  .agos-menu[open] .agos-menu__icon span:nth-child(2) {
    opacity: 0;
  }

  .agos-menu[open] .agos-menu__icon span:last-child {
    transform: translateY(-0.275rem) rotate(-45deg);
  }

  .agos-menu__panel {
    position: absolute;
    top: calc(100% + 0.625rem);
    left: 0;
    right: 0;
    max-height: calc(100vh - 5.5rem);
    overflow-y: auto;
    padding: 0.75rem;
    border: 1px solid rgba(0, 210, 255, 0.2);
    border-radius: var(--radius-xl);
    background: rgba(11, 15, 25, 0.98);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
  }

  .agos-menu__nav {
    display: grid;
    grid-template-columns: 1fr;
  }

  .agos-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .agos-menu__link:hover,
  .agos-menu__link:focus-visible,
  .agos-menu__link--active {
    color: var(--laser-cyan);
    outline: none;
  }

  .agos-menu__cta {
    width: 100%;
    margin-top: 0.75rem;
  }

  @media (min-width: 640px) {
    .agos-menu__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .agos-menu {
      display: none;
    }
  }

  /* ── Desktop CTA ──────────────────────────────────────── */
  .agos-header__cta {
    display: none;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .agos-header__cta { display: flex; }
  }

  @media (max-width: 639px) {
    .agos-header__cta {
      display: none;
    }
  }
</style>
