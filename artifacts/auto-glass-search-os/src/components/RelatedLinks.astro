---
/**
 * RelatedLinks — contextual cross-links between the lead generation hub
 * and the acquisition-channel pages.
 */
interface LinkItem {
  href: string;
  title: string;
  description: string;
}

interface Props {
  id?: string;
  heading: string;
  eyebrow?: string;
  links: LinkItem[];
  alt?: boolean;
}

const { id = "related", heading, eyebrow = "Part of the system", links, alt = false } = Astro.props;
---

<section class:list={["related", { "related--alt": alt }]} aria-labelledby={`${id}-heading`}>
  <div class="container">
    <header class="related__header">
      <span class="eyebrow">{eyebrow}</span>
      <span class="cyan-rule"></span>
      <h2 id={`${id}-heading`} class="related__heading text-balance">{heading}</h2>
    </header>
    <div class="related__grid">
      {links.map((link) => (
        <a href={link.href} class="related__card" data-analytics-event="related_link_click">
          <span class="related__title">{link.title}</span>
          <span class="related__desc">{link.description}</span>
          <span class="related__arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .related {
    padding-top: 4rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--line);
    background-color: var(--surface-00);
  }

  .related--alt {
    background-color: var(--surface-01);
  }

  .related__header {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-bottom: 1.75rem;
    max-width: 52rem;
  }

  .related__heading {
    font-size: clamp(1.375rem, 2vw + 0.5rem, 1.875rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0;
  }

  .related__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .related__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .related__grid { grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  }

  .related__card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.375rem 1.5rem;
    background-color: var(--surface-02);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition: border-color 200ms, transform 200ms;
    position: relative;
  }

  .related__card:hover {
    border-color: var(--laser-cyan-border);
    transform: translateY(-2px);
  }

  .related__title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    padding-right: 1.5rem;
  }

  .related__desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .related__arrow {
    position: absolute;
    top: 1.25rem;
    right: 1.375rem;
    color: var(--laser-cyan);
    font-size: 1rem;
  }
</style>
