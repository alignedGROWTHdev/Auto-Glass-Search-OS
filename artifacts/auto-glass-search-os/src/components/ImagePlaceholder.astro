---
/**
 * ImagePlaceholder — a clearly labeled frame for an image asset that does not
 * exist in the repository yet. Replace with a real <img> once the asset is supplied.
 * Never ships copyrighted or generic stock imagery by default.
 */
interface Props {
  label: string;          // e.g. "Founder headshot — Valentina Borda"
  spec?: string;          // e.g. "Square, 800×800, neutral background"
  aspect?: string;        // CSS aspect-ratio, e.g. "4 / 5"
  rounded?: "lg" | "xl" | "full";
  class?: string;
}

const { label, spec, aspect = "4 / 3", rounded = "xl", class: className = "" } = Astro.props;
---

<figure class:list={["img-ph", `img-ph--${rounded}`, className]} style={`aspect-ratio: ${aspect};`} role="img" aria-label={`Image placeholder: ${label}`}>
  <div class="img-ph__inner">
    <span class="img-ph__tag">Image needed</span>
    <span class="img-ph__label">{label}</span>
    {spec && <span class="img-ph__spec">{spec}</span>}
  </div>
</figure>

<style>
  .img-ph {
    margin: 0;
    width: 100%;
    background:
      repeating-linear-gradient(135deg, var(--tint) 0 10px, transparent 10px 20px),
      linear-gradient(180deg, var(--carbon-slate-2), var(--carbon-slate));
    border: 1px dashed var(--laser-cyan-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .img-ph--lg { border-radius: var(--radius-lg); }
  .img-ph--xl { border-radius: var(--radius-xl); }
  .img-ph--full { border-radius: 50%; }

  .img-ph__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.375rem;
    padding: 1rem;
    max-width: 18rem;
  }

  .img-ph__tag {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--laser-cyan);
  }

  .img-ph__label {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .img-ph__spec {
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    line-height: 1.4;
  }
</style>
