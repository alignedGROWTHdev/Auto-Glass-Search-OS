---
import { siteConfig, isConfigured } from '../data/siteData';
import BrandMark from './BrandMark.astro';
---

<footer class="agos-footer" role="contentinfo">
  <div class="agos-footer__inner container">

    <!-- Main grid -->
    <div class="agos-footer__grid">

      <!-- Col 1: Entity -->
      <div class="agos-footer__entity">
        <a href="/" class="agos-footer__wordmark" aria-label={`${siteConfig.name} — Home`}>
          <span class="agos-brandmark agos-brandmark--sm" aria-hidden="true">
            <BrandMark size={18} />
          </span>
          <span class="agos-footer__wordmark-text">
            AUTO GLASS <span class="agos-footer__wordmark-accent">SEARCH OS</span>
          </span>
        </a>

        <p class="agos-footer__desc">
          Auto glass marketing and lead generation for established auto glass companies. We help operators capture more of the customer demand already happening in their markets and turn it into qualified calls, quote requests, and booked jobs.
        </p>
        <p class="agos-footer__desc agos-footer__desc--mono">
          {siteConfig.channelDescriptor}
        </p>

        <div class="agos-footer__meta">
          {isConfigured(siteConfig.placeholders.phone) && (
            <p>
              <a href={`tel:${siteConfig.placeholders.phone.replace(/[^\d+]/g, '')}`} data-analytics-event="phone_click" class="agos-footer__contact-link">
                PHONE: {siteConfig.placeholders.phone}
              </a>
            </p>
          )}
        </div>
      </div>

      <!-- Col 2: Capabilities -->
      <div class="agos-footer__col">
        <p class="agos-footer__col-heading" aria-label="Capabilities">Capabilities</p>
        <ul class="agos-footer__link-list" role="list">
          <li><a href="/auto-glass-lead-generation/" class="agos-footer__link">Auto Glass Lead Generation</a></li>
          <li><a href="/auto-glass-seo/" class="agos-footer__link">Auto Glass SEO</a></li>
          <li><a href="/auto-glass-local-seo/" class="agos-footer__link">Local SEO &amp; Google Maps</a></li>
          <li><a href="/google-ads/" class="agos-footer__link">Google Ads for Auto Glass</a></li>
          <li><a href="/ai-search-optimization/" class="agos-footer__link">AI Search Optimization</a></li>
        </ul>
      </div>

      <!-- Col 3: How we work -->
      <div class="agos-footer__col">
        <p class="agos-footer__col-heading">How We Work</p>
        <ul class="agos-footer__stage-list" role="list">
          <li class="agos-footer__stage-item">
            <span class="agos-footer__stage-num">01.</span>
            <span>Found — Capture high-intent demand</span>
          </li>
          <li class="agos-footer__stage-item">
            <span class="agos-footer__stage-num">02.</span>
            <span>Trusted — Reasons to choose you</span>
          </li>
          <li class="agos-footer__stage-item">
            <span class="agos-footer__stage-num">03.</span>
            <span>Chosen — Qualified calls &amp; quotes</span>
          </li>
          <li class="agos-footer__stage-item">
            <span class="agos-footer__stage-num">04.</span>
            <span>Measured — Booked jobs &amp; cost</span>
          </li>
        </ul>
      </div>

      <!-- Col 4: Visibility Analysis -->
      <div class="agos-footer__col">
        <p class="agos-footer__col-heading">Opportunity Analysis</p>
        <p class="agos-footer__col-desc">
          See where competitors are capturing auto glass leads you're missing.
        </p>
        <a
          href="/visibility-analysis/"
          data-analytics-event="primary_cta_click"
          class="agos-footer__cta-link"
        >
          See Where You're Losing Jobs
        </a>
        <div class="agos-footer__secondary-links">
          <a href="/about/" class="agos-footer__link">About Valentina Borda &amp; Auto Glass Search OS</a>
          <a href="/privacy/" class="agos-footer__link">Privacy Policy</a>
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="agos-footer__bottom">
      <p class="agos-footer__legal">
        &copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved. {siteConfig.name} is a specialized auto glass offering of {siteConfig.entity.parentOrganizationName}.
      </p>
      <p class="agos-footer__tagline">
        Search strategy &middot; AI-enabled systems &middot; Human expertise
      </p>
    </div>

  </div>
</footer>

<style>
  .agos-footer {
    background-color: var(--obsidian);
    border-top: 1px solid rgba(0, 210, 255, 0.1);
    padding-top: 4rem;
    padding-bottom: 3rem;
    color: var(--text-tertiary);
  }

  .agos-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  @media (min-width: 640px) {
    .agos-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .agos-footer__grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 3rem;
    }
  }

  /* Entity col */
  .agos-footer__entity {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .agos-footer__wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .agos-footer__wordmark:hover { opacity: 0.8; }

  .agos-brandmark--sm {
    width: 2rem;
    height: 2rem;
  }

  .agos-footer__wordmark-text {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-primary);
  }

  .agos-footer__wordmark-accent {
    color: var(--laser-cyan);
  }

  .agos-footer__desc {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    line-height: 1.65;
    max-width: 22rem;
  }

  .agos-footer__desc--mono {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .agos-footer__meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    text-transform: uppercase;
  }

  .agos-footer__contact-link {
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .agos-footer__contact-link:hover {
    color: var(--laser-cyan);
  }

  /* Cols */
  .agos-footer__col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .agos-footer__col-heading {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
    margin: 0;
  }

  .agos-footer__link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .agos-footer__link {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .agos-footer__link:hover {
    color: var(--laser-cyan);
  }

  .agos-footer__stage-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .agos-footer__stage-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .agos-footer__stage-num {
    color: var(--laser-cyan);
    flex-shrink: 0;
    font-weight: 500;
  }

  .agos-footer__col-desc {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    line-height: 1.6;
    margin: 0;
  }

  .agos-footer__cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--laser-cyan);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .agos-footer__cta-link::after {
    content: '→';
  }

  .agos-footer__cta-link:hover {
    color: var(--blue-hover);
    text-decoration: underline;
  }

  .agos-footer__secondary-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    margin-top: 0.5rem;
  }

  /* Bottom bar */
  .agos-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 2rem;
  }

  @media (min-width: 768px) {
    .agos-footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .agos-footer__legal {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  .agos-footer__tagline {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin: 0;
  }
</style>
