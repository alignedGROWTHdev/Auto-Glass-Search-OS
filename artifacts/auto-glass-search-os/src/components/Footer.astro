---
import { siteConfig, isConfigured } from '../data/siteData';
---

<footer class="bg-[#05080E] border-t border-white/10 text-slate-400 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-white/10">
      
      <!-- Entity col -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-8 h-8 rounded bg-blue-600/20 border border-blue-500/40 flex items-center justify-center text-blue-400 font-heading font-bold text-sm">
            OS
          </div>
          <span class="text-base font-bold tracking-tight text-white font-heading">
            AUTO GLASS <span class="text-blue-500">SEARCH OS</span>
          </span>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          The specialized search operating system designed specifically for established auto glass businesses to capture high-intent windshield replacements and ADAS calibrations.
        </p>
        <div class="pt-2 text-xs font-mono text-slate-400 space-y-1">
          <p>OPERATING ENTITY: {siteConfig.legalParent}</p>
          <p>FOUNDER: {siteConfig.founder}</p>
          <p>STANDARDS: Clean HTML-First Crawlability · Zero Client-Only Data Walls</p>
          {isConfigured(siteConfig.placeholders.phone) && (
            <p><a href={`tel:${siteConfig.placeholders.phone.replace(/[^\d+]/g, '')}`} data-analytics-event="phone_click" class="hover:text-blue-400">PHONE: {siteConfig.placeholders.phone}</a></p>
          )}
          {isConfigured(siteConfig.placeholders.email) && (
            <p><a href={`mailto:${siteConfig.placeholders.email}`} data-analytics-event="email_click" class="hover:text-blue-400">EMAIL: {siteConfig.placeholders.email}</a></p>
          )}
        </div>
      </div>

      <!-- Col 3: Core Capabilities -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-white font-semibold mb-4">
          Capabilities
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/auto-glass-seo/" class="hover:text-blue-400 transition-colors">Auto Glass SEO</a></li>
          <li><a href="/auto-glass-local-seo/" class="hover:text-blue-400 transition-colors">Local Maps & 3-Pack</a></li>
          <li><a href="/ai-search-optimization/" class="hover:text-blue-400 transition-colors">AI Search & AEO</a></li>
          <li><a href="/google-ads/" class="hover:text-blue-400 transition-colors">High-Intent Google Ads</a></li>
        </ul>
      </div>

      <!-- Col 4: Search OS Framework -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-white font-semibold mb-4">
          Search OS Architecture
        </h4>
        <ul class="space-y-2 text-sm font-mono text-xs">
          <li class="text-slate-300">01. Found (Multi-Surface)</li>
          <li class="text-slate-300">02. Trusted (Reputation & Proof)</li>
          <li class="text-slate-300">03. Chosen (Call Conversion)</li>
          <li class="text-slate-300">04. Measured (Booked Job Tickets)</li>
        </ul>
      </div>

      <!-- Col 5: Governance -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-white font-semibold mb-4">
          Growth Diagnostics
        </h4>
        <p class="text-xs text-slate-400 mb-3 leading-relaxed">
          See which competitors are capturing emergency windshield replacements in your territory.
        </p>
        <a
          href="/visibility-analysis/"
          data-analytics-event="primary_cta_click"
          class="inline-block text-xs font-medium text-blue-400 hover:underline font-mono"
        >
          REQUEST VISIBILITY ANALYSIS →
        </a>
        <div class="mt-6 pt-4 border-t border-white/5 space-y-1.5 text-xs">
          <a href="/about/" class="block hover:text-white">About Valentina Borda</a>
          <a href="/privacy/" class="block hover:text-white">Privacy Policy</a>
        </div>
      </div>

    </div>

    <!-- Bottom Legal Notice -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <p>
        © {new Date().getFullYear()} Auto Glass Search OS. All rights reserved. Auto Glass Search OS is an Aligned Growth Digital company.
      </p>
      <p class="font-mono text-[11px] text-slate-400">
        Search Growth + AI Systems · Human Expertise + Governance
      </p>
    </div>
  </div>
</footer>
