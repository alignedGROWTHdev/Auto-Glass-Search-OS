---
import { siteConfig, isConfigured } from '../data/siteData';
---

<footer class="agos-footer" role="contentinfo">
  <div class="agos-footer__inner container">

    <!-- Main grid -->
    <div class="agos-footer__grid">

      <!-- Col 1: Entity -->
      <div class="agos-footer__entity">
        <a href="/" class="agos-footer__wordmark" aria-label={`${siteConfig.name} — Home`}>
          <span class="ag-monogram" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M2 20 L7 6 L12 20" stroke="var(--blue)" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" fill="none"/>
              <line x1="4.5" y1="15.5" x2="9.5" y2="15.5" stroke="var(--blue)" stroke-width="1.6" stroke-linecap="square"/>
              <path d="M22 8.5 A5.8 5.8 0 1 0 22 17.5" stroke="var(--text-primary)" stroke-width="1.7" stroke-linecap="square" fill="none"/>
              <line x1="17.5" y1="13" x2="22" y2="13" stroke="var(--text-primary)" stroke-width="1.7" stroke-linecap="square"/>
              <line x1="22" y1="13" x2="22" y2="17.5" stroke="var(--text-primary)" stroke-width="1.7" stroke-linecap="square"/>
            </svg>
          </span>
          <span class="agos-footer__wordmark-text">
            AUTO GLASS <span class="agos-footer__wordmark-accent">SEARCH OS</span>
          </span>
        </a>

        <p class="agos-footer__desc">
          Search visibility and customer acquisition for established auto glass companies across Google Search, Google Maps, AI search, paid search, and website conversion.
        </p>

        <div class="agos-footer__meta">
          <p>OPERATING ENTITY: {siteConfig.legalParent}</p>
          <p>FOUNDER: {siteConfig.founder}</p>
          {isConfigured(siteConfig.placeholders.phone) && (
            <p>
              <a href={`tel:${siteConfig.placeholders.phone.replace(/[^\d+]/g, '')}`} data-analytics-event="phone_click" class="agos-footer__contact-link">
                PHONE: {siteConfig.placeholders.phone}
              </a>
            </p>
          )}
          {isConfigured(siteConfig.placeholders.email) && (
            <p>
              <a href={`mailto:${siteConfig.placeholders.email}`} data-analytics-event="email_click" class="agos-footer__contact-link">
                EMAIL: {siteConfig.placeholders.email}
              </a>
            </p>
          )}
        </div>
      </div>

      <!-- Col 2: Capabilities -->
      <div class="agos-footer__col">
        <p class="agos-footer__col-heading" aria-label="Capabilities">Capabilities</p>
        <ul class="agos-footer__link-list" role="list">
          <li><a href="/auto-glass-seo/" class="agos-footer__link">Auto Glass SEO</a></li>
          <li><a href="/auto-glass-local-seo/" class="agos-footer__link">Local Maps &amp; 3-Pack</a></li>
          <li><a href="/ai-search-optimization/" class="agos-footer__link">AI Search &amp; AEO</a></li>
          <li><a href="/google-ads/" class="agos-footer__link">High-Intent Google Ads</a></li>
        </ul>
      </div>

      <!-- Col 3: How we work -->
      <div class="agos-footer__col">
        <p class="agos-footer__col-heading">How We Work</p>
        <ul class="agos-footer__stage-list" role="list">
          <li class="agos-footer__stage-item">
            <span class="agos-footer__stage-num">01.</span>
            <span>Found — Easier to find</span>
          </li>
          <li class="agos-footer__stage-item">
            <span class="agos-footer__stage-num">02.</span>
            <span>Trusted — Reasons to trust</span>
          </li>
          <li class="agos-footer__stage-item">
            <span class="agos-footer__stage-num">03.</span>
            <span>Chosen — Easy to contact</span>
          </li>
          <li class="agos-footer__stage-item">
            <span class="agos-footer__stage-num">04.</span>
            <span>Measured — Trackable outcomes</span>
          </li>
        </ul>
      </div>

      <!-- Col 4: Visibility Analysis -->
      <div class="agos-footer__col">
        <p class="agos-footer__col-heading">Visibility Analysis</p>
        <p class="agos-footer__col-desc">
          See where competitors are more visible in your auto glass market.
        </p>
        <a
          href="/visibility-analysis/"
          data-analytics-event="primary_cta_click"
          class="agos-footer__cta-link"
        >
          Request Visibility Analysis
        </a>
        <div class="agos-footer__secondary-links">
          <a href="/about/" class="agos-footer__link">About Valentina Borda</a>
          <a href="/privacy/" class="agos-footer__link">Privacy Policy</a>
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="agos-footer__bottom">
      <p class="agos-footer__legal">
        &copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved. {siteConfig.name} is an Aligned Growth Digital company.
      </p>
      <p class="agos-footer__tagline">
        Search strategy &middot; AI-enabled systems &middot; Human expertise
      </p>
    </div>

  </div>
</footer>

<style>
  .agos-footer {
    background-color: var(--surface-00);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding-top: 4rem;
    padding-bottom: 3rem;
    color: var(--text-tertiary);
  }

  .agos-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  @media (min-width: 640px) {
    .agos-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .agos-footer__grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 3rem;
    }
  }

  /* Entity col */
  .agos-footer__entity {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .agos-footer__wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .agos-footer__wordmark:hover { opacity: 0.8; }

  .agos-footer__wordmark-text {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-primary);
  }

  .agos-footer__wordmark-accent {
    color: var(--blue);
  }

  .agos-footer__desc {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    line-height: 1.65;
    max-width: 22rem;
  }

  .agos-footer__meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--text-tertiary);
    text-transform: uppercase;
  }

  .agos-footer__contact-link {
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .agos-footer__contact-link:hover {
    color: var(--blue);
  }

  /* Cols */
  .agos-footer__col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .agos-footer__col-heading {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-primary);
    margin: 0;
  }

  .agos-footer__link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .agos-footer__link {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .agos-footer__link:hover {
    color: var(--blue);
  }

  .agos-footer__stage-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .agos-footer__stage-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .agos-footer__stage-num {
    color: var(--blue);
    flex-shrink: 0;
    font-weight: 500;
  }

  .agos-footer__col-desc {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    line-height: 1.6;
    margin: 0;
  }

  .agos-footer__cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .agos-footer__cta-link::after {
    content: '→';
  }

  .agos-footer__cta-link:hover {
    color: var(--blue-hover);
    text-decoration: underline;
  }

  .agos-footer__secondary-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 0.5rem;
  }

  /* Bottom bar */
  .agos-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 2rem;
  }

  @media (min-width: 768px) {
    .agos-footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .agos-footer__legal {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  .agos-footer__tagline {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    margin: 0;
  }
</style>
