---
interface Props {
  minimal?: boolean;
  /** Paid-landing-page mode: fewer fields, budget required, UTM capture. */
  compact?: boolean;
}

const { minimal = false, compact = false } = Astro.props;
---

<!--
  FormSubmit static delivery:
  - method POST → configured FormSubmit delivery endpoint
  - _next set at runtime via progressive-enhancement script (fallback: FormSubmit default page)
  - First submission may require recipient email activation via FormSubmit's confirmation email
  - _captcha=false disables FormSubmit CAPTCHA (suitable for lead forms with manual review)
-->
<form
  method="POST"
  action="https://formsubmit.co/info@autoglassgrowth.com"
  class="agos-form"
  data-lead-form
  data-analytics-event="visibility_analysis_form"
  enctype="application/x-www-form-urlencoded"
>
  <!-- FormSubmit control fields -->
  <input type="hidden" name="_subject" value="Auto Glass Growth — Search + Customer Acquisition Analysis Request" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <!-- _next is set at runtime by the progressive-enhancement script below.
       If JS is unavailable, FormSubmit delivers to its own success page. -->
  <input type="hidden" name="_next" id="form-next-field" value="" />

  <!-- Honeypot (anti-spam) -->
  <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

  <!-- Attribution: filled at runtime from the URL so every lead carries its campaign -->
  <input type="hidden" name="Source" data-utm="utm_source" value="" />
  <input type="hidden" name="Medium" data-utm="utm_medium" value="" />
  <input type="hidden" name="Campaign" data-utm="utm_campaign" value="" />
  <input type="hidden" name="Ad Group / Term" data-utm="utm_term" value="" />
  <input type="hidden" name="GCLID" data-utm="gclid" value="" />
  <input type="hidden" name="Landing Page" data-landing value="" />

  <!-- Step 1: Contact & Company Profile -->
  <div class="agos-form__row">
    <div class="agos-form__field">
      <label for="fullName" class="form-label">
        Your Name <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="text"
        id="fullName"
        name="Name"
        required
        autocomplete="name"
        placeholder="e.g. Marcus Vance"
        class="form-input"
        aria-required="true"
      />
    </div>
    <div class="agos-form__field">
      <label for="companyName" class="form-label">
        Company Name <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="text"
        id="companyName"
        name="Company"
        required
        autocomplete="organization"
        placeholder="e.g. Apex Auto Glass &amp; ADAS"
        class="form-input"
        aria-required="true"
      />
    </div>
  </div>

  <div class="agos-form__row">
    <div class="agos-form__field">
      <label for="phone" class="form-label">
        Direct Phone <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="Phone"
        required
        autocomplete="tel"
        placeholder="(555) 000-0000"
        class="form-input"
        aria-required="true"
      />
    </div>
    <div class="agos-form__field">
      <label for="email" class="form-label">
        Business Email <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="Email"
        required
        autocomplete="email"
        placeholder="owner@yourglasscompany.com"
        class="form-input"
        aria-required="true"
      />
    </div>
  </div>

  <div class="agos-form__row">
    {!compact && (
    <div class="agos-form__field">
      <label for="fleetScale" class="form-label">
        Locations / Shop Scale
      </label>
      <select
        id="fleetScale"
        name="Fleet Scale"
        class="form-select"
      >
        <option value="1 location / mobile base">1 Location or Mobile Base</option>
        <option value="2-3 locations">2 – 3 Locations</option>
        <option value="4-10 locations">4 – 10 Locations</option>
        <option value="10+ regional group">10+ Regional Group</option>
      </select>
    </div>
    )}
    <div class="agos-form__field">
      <label for="website" class="form-label">
        Website <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="text"
        id="website"
        name="Website"
        autocomplete="url"
        inputmode="url"
        required
        placeholder="yourglasscompany.com"
        class="form-input"
        aria-required="true"
      />
    </div>
  </div>

  {!minimal && (
    <div class="agos-form__field">
      <label for="markets" class="form-label">
        {compact ? "Your City / Main Service Area" : "Primary Markets / Service Areas"} <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="text"
        id="markets"
        name="Primary Markets"
        required
        placeholder={compact ? "e.g. Phoenix, AZ" : "e.g. Phoenix Metro, Scottsdale, Mesa, Chandler"}
        class="form-input"
        aria-required="true"
      />
    </div>
  )}

  <div class="agos-form__row">
    <div class="agos-form__field">
      <label for="investment" class="form-label">
        Monthly Marketing Investment {compact && <span class="required" aria-label="required">*</span>}
      </label>
      <select
        id="investment"
        name="Monthly Investment"
        class="form-select"
        required={compact}
        aria-required={compact ? "true" : undefined}
      >
        <option value="" selected>{compact ? "Select a range" : "Select a range (optional)"}</option>
        <option value="Under $3,000">Under $3,000 / month</option>
        <option value="$3,000-$5,000">$3,000 – $5,000 / month</option>
        <option value="$5,000-$10,000">$5,000 – $10,000 / month</option>
        <option value="$10,000-$25,000">$10,000 – $25,000 / month</option>
        <option value="$25,000+">$25,000+ / month</option>
      </select>
    </div>
  </div>

  <div class="agos-form__submit">
    <button
      type="submit"
      data-analytics-event="visibility_analysis_submit"
      class="btn btn--primary btn--full btn--lg"
    >
      Send Me My Free Growth Analysis
    </button>
    <p class="agos-form__delivery-note">
      Submissions are securely delivered to our CRM and email team. Your information is used only to conduct and deliver your analysis.
    </p>
    <p class="agos-form__status" data-form-status role="status" aria-live="polite" hidden></p>
  </div>
</form>

<style>
  .agos-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .agos-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 560px) {
    .agos-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .agos-form__field {
    display: flex;
    flex-direction: column;
  }

  .agos-form__submit {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding-top: 0.5rem;
  }

  .agos-form__delivery-note {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
    padding: 1rem;
    background: transparent;
    border: 1px solid var(--border-dark);
    border-radius: 0;
  }

  .agos-form__status {
    margin: 0;
    padding: 0.875rem 1rem;
    border: 1px solid var(--fleet-amber);
    color: var(--text-primary);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
    text-align: center;
  }
</style>

<!-- Progressive enhancement: deliver to HubSpot, then preserve FormSubmit email delivery. -->
<script>
  (function() {
    const nextField = document.getElementById('form-next-field');
    if (nextField) {
      nextField.value = window.location.origin + '/thank-you/';
    }
    // Attribution capture: URL params first, then anything stored from an earlier page view.
    try {
      const params = new URLSearchParams(window.location.search);
      const keys = ['utm_source','utm_medium','utm_campaign','utm_term','gclid'];
      const store = JSON.parse(sessionStorage.getItem('agg_attr') || '{}');
      keys.forEach((k) => { const v = params.get(k); if (v) store[k] = v; });
      sessionStorage.setItem('agg_attr', JSON.stringify(store));
      document.querySelectorAll('[data-utm]').forEach((el) => {
        const k = el.getAttribute('data-utm'); if (store[k]) el.value = store[k];
      });
      document.querySelectorAll('[data-landing]').forEach((el) => { el.value = window.location.pathname; });
    } catch (e) {}

    document.querySelectorAll('[data-lead-form]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const submitButton = form.querySelector('button[type="submit"]');
        const status = form.querySelector('[data-form-status]');
        const formData = new FormData(form);

        if (submitButton) {
          submitButton.disabled = true;
          submitButton.setAttribute('aria-busy', 'true');
        }
        if (status) {
          status.hidden = true;
          status.textContent = '';
        }

        try {
          const response = await fetch('/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: formData.get('Name'),
              company: formData.get('Company'),
              phone: formData.get('Phone'),
              email: formData.get('Email'),
              website: formData.get('Website'),
              fleetScale: formData.get('Fleet Scale') || undefined,
              primaryMarkets: formData.get('Primary Markets') || undefined,
              monthlyInvestment: formData.get('Monthly Investment') || undefined,
              source: formData.get('Source') || undefined,
              medium: formData.get('Medium') || undefined,
              campaign: formData.get('Campaign') || undefined,
              term: formData.get('Ad Group / Term') || undefined,
              gclid: formData.get('GCLID') || undefined,
              landingPage: formData.get('Landing Page') || window.location.pathname,
              honey: formData.get('_honey') || undefined,
            }),
          });

          if (!response.ok) {
            throw new Error('HubSpot delivery failed');
          }

          // Native submit bypasses this listener and retains the existing
          // FormSubmit email notification and thank-you redirect.
          form.submit();
        } catch (error) {
          if (status) {
            status.textContent = 'We could not send your request. Please try again, or call (720) 600-2985.';
            status.hidden = false;
          }
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.removeAttribute('aria-busy');
          }
        }
      });
    });
  })();
</script>
