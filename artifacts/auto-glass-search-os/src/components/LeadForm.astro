---
interface Props {
  minimal?: boolean;
}

const { minimal = false } = Astro.props;
---

<form
  method="POST"
  action="/visibility-analysis/"
  class="space-y-6 text-left"
  data-lead-form
  data-analytics-event="visibility_analysis_form"
>
  <!-- Step 1: Contact & Company Profile -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label for="fullName" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-1.5">
        Your Name <span class="text-blue-400">*</span>
      </label>
      <input
        type="text"
        id="fullName"
        name="fullName"
        required
        placeholder="e.g. Marcus Vance"
        class="w-full bg-[#0D1424] border border-white/10 rounded px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500 transition-colors"
      />
    </div>
    <div>
      <label for="companyName" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-1.5">
        Company Name <span class="text-blue-400">*</span>
      </label>
      <input
        type="text"
        id="companyName"
        name="companyName"
        required
        placeholder="e.g. Apex Auto Glass & ADAS"
        class="w-full bg-[#0D1424] border border-white/10 rounded px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500 transition-colors"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label for="website" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-1.5">
        Website URL <span class="text-blue-400">*</span>
      </label>
      <input
        type="url"
        id="website"
        name="website"
        required
        placeholder="https://yourglasscompany.com"
        class="w-full bg-[#0D1424] border border-white/10 rounded px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500 transition-colors"
      />
    </div>
    <div>
      <label for="email" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-1.5">
        Business Email <span class="text-blue-400">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder="owner@yourglasscompany.com"
        class="w-full bg-[#0D1424] border border-white/10 rounded px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500 transition-colors"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label for="phone" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-1.5">
        Direct Phone <span class="text-blue-400">*</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        placeholder="(555) 000-0000"
        class="w-full bg-[#0D1424] border border-white/10 rounded px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500 transition-colors"
      />
    </div>
    <div>
      <label for="locations" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-1.5">
        Number of Locations / Mobile Bases
      </label>
      <select
        id="locations"
        name="locations"
        class="w-full bg-[#0D1424] border border-white/10 rounded px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500 transition-colors"
      >
        <option value="1">1 Facility / Mobile Hub</option>
        <option value="2-3">2 - 3 Locations</option>
        <option value="4-10">4 - 10 Locations</option>
        <option value="10+">10+ Regional Group</option>
      </select>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label for="interest" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-1.5">
        Engagement Interest
      </label>
      <select
        id="interest"
        name="interest"
        class="w-full bg-[#0D1424] border border-white/10 rounded px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500 transition-colors"
      >
        <option value="Managed Search OS">Managed Search OS (We run it for you)</option>
        <option value="Search OS + Team">Search OS + Team (We build it with your team)</option>
        <option value="Not sure">Not sure yet</option>
      </select>
    </div>
    <div>
      <label for="investment" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-1.5">
        Monthly Marketing Budget
      </label>
      <select
        id="investment"
        name="investment"
        class="w-full bg-[#0D1424] border border-white/10 rounded px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500 transition-colors"
      >
        <option value="Under $3,000">Under $3,000 / month</option>
        <option value="$3,000-$5,000" selected>$3,000 - $5,000 / month</option>
        <option value="$5,000-$10,000">$5,000 - $10,000 / month</option>
        <option value="$10,000-$25,000">$10,000 - $25,000 / month</option>
        <option value="$25,000+">$25,000+ / month</option>
      </select>
    </div>
  </div>

  <!-- Step 3: Priority Services -->
  {!minimal && (
    <div>
      <label for="markets" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-1.5">
        Primary Service Areas / Metro Markets <span class="text-blue-400">*</span>
      </label>
      <input
        type="text"
        id="markets"
        name="markets"
        required
        placeholder="e.g. Phoenix Metro, Scottsdale, Mesa, Chandler"
        class="w-full bg-[#0D1424] border border-white/10 rounded px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500 transition-colors"
      />
    </div>
  )}

  <div class="pt-2">
    <button
      type="submit"
      data-analytics-event="visibility_analysis_submit"
      class="w-full py-3.5 px-6 rounded bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-500 hover:to-blue-600 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-blue-600/25 border border-blue-400/30 transition-all flex items-center justify-center gap-2"
    >
      <span>Get Complimentary Visibility Analysis</span>
      <span>→</span>
    </button>
    <div class="text-center mt-3 text-xs text-slate-400 font-mono">
      Manually reviewed · Confidential opportunity analysis
    </div>
    <p class="hidden text-center mt-3 text-xs text-amber-300" role="alert" tabindex="-1" data-integration-message>
      Online delivery is not configured yet. Please email <a class="underline" href="mailto:valentina@alignedgrowthdigital.com?subject=Search%20%2B%20AI%20Visibility%20Analysis">valentina@alignedgrowthdigital.com</a> to request your analysis.
    </p>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-lead-form]');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const message = form.querySelector<HTMLElement>('[data-integration-message]');
    message?.classList.remove('hidden');
    message?.focus();
  });
</script>
