---
interface Props {
  minimal?: boolean;
}

const { minimal = false } = Astro.props;
---

<!--
  FormSubmit static delivery:
  - method POST → configured FormSubmit delivery endpoint
  - _next set at runtime via progressive-enhancement script (fallback: FormSubmit default page)
  - First submission may require recipient email activation via FormSubmit's confirmation email
  - _captcha=false disables FormSubmit CAPTCHA (suitable for lead forms with manual review)
-->
<form
  method="POST"
  action="https://formsubmit.co/valentina@alignedgrowthdigital.com"
  class="agos-form"
  data-lead-form
  data-analytics-event="visibility_analysis_form"
  enctype="application/x-www-form-urlencoded"
>
  <!-- FormSubmit control fields -->
  <input type="hidden" name="_subject" value="Auto Glass Visibility Analysis Request" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <!-- _next is set at runtime by the progressive-enhancement script below.
       If JS is unavailable, FormSubmit delivers to its own success page. -->
  <input type="hidden" name="_next" id="form-next-field" value="" />

  <!-- Honeypot (anti-spam) -->
  <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

  <!-- Step 1: Contact & Company Profile -->
  <div class="agos-form__row">
    <div class="agos-form__field">
      <label for="fullName" class="form-label">
        Your Name <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="text"
        id="fullName"
        name="Name"
        required
        autocomplete="name"
        placeholder="e.g. Marcus Vance"
        class="form-input"
        aria-required="true"
      />
    </div>
    <div class="agos-form__field">
      <label for="companyName" class="form-label">
        Company Name <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="text"
        id="companyName"
        name="Company"
        required
        autocomplete="organization"
        placeholder="e.g. Apex Auto Glass &amp; ADAS"
        class="form-input"
        aria-required="true"
      />
    </div>
  </div>

  <div class="agos-form__row">
    <div class="agos-form__field">
      <label for="phone" class="form-label">
        Direct Phone <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="Phone"
        required
        autocomplete="tel"
        placeholder="(555) 000-0000"
        class="form-input"
        aria-required="true"
      />
    </div>
    <div class="agos-form__field">
      <label for="email" class="form-label">
        Business Email <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="Email"
        required
        autocomplete="email"
        placeholder="owner@yourglasscompany.com"
        class="form-input"
        aria-required="true"
      />
    </div>
  </div>

  <div class="agos-form__row">
    <div class="agos-form__field">
      <label for="fleetScale" class="form-label">
        Fleet / Shop Scale
      </label>
      <select
        id="fleetScale"
        name="Fleet Scale"
        class="form-select"
      >
        <option value="1 location / mobile base">1 Location or Mobile Base</option>
        <option value="2-3 locations">2 – 3 Locations</option>
        <option value="4-10 locations">4 – 10 Locations</option>
        <option value="10+ regional group">10+ Regional Group</option>
      </select>
    </div>
    <div class="agos-form__field">
      <label for="adasSetup" class="form-label">
        ADAS Calibration Setup
      </label>
      <select
        id="adasSetup"
        name="ADAS Setup"
        class="form-select"
      >
        <option value="In-house calibration bay">In-house calibration bay</option>
        <option value="Third-party ADAS partner">Third-party ADAS partner</option>
        <option value="Planning to add ADAS">Planning to add ADAS</option>
        <option value="No ADAS currently">No ADAS currently</option>
      </select>
    </div>
  </div>

  {!minimal && (
    <div class="agos-form__field">
      <label for="markets" class="form-label">
        Primary Markets / Service Areas <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="text"
        id="markets"
        name="Primary Markets"
        required
        placeholder="e.g. Phoenix Metro, Scottsdale, Mesa, Chandler"
        class="form-input"
        aria-required="true"
      />
    </div>
  )}

  <div class="agos-form__row">
    <div class="agos-form__field">
      <label for="interest" class="form-label">
        Engagement Interest
      </label>
      <select
        id="interest"
        name="Engagement Interest"
        class="form-select"
      >
        <option value="Managed Search OS — We run it for you">Managed Search OS — We run it for you</option>
        <option value="Search OS + Team — We build it with your team">Search OS + Team — We build it with your team</option>
        <option value="Not sure yet">Not sure yet</option>
      </select>
    </div>
    <div class="agos-form__field">
      <label for="investment" class="form-label">
        Monthly Marketing Investment
      </label>
      <select
        id="investment"
        name="Monthly Investment"
        class="form-select"
      >
        <option value="Under $3,000">Under $3,000 / month</option>
        <option value="$3,000-$5,000" selected>$3,000 – $5,000 / month</option>
        <option value="$5,000-$10,000">$5,000 – $10,000 / month</option>
        <option value="$10,000-$25,000">$10,000 – $25,000 / month</option>
        <option value="$25,000+">$25,000+ / month</option>
      </select>
    </div>
  </div>

  <div class="agos-form__submit">
    <button
      type="submit"
      data-analytics-event="visibility_analysis_submit"
      class="btn btn--primary btn--full btn--lg"
    >
      Request Complimentary Visibility Analysis
    </button>
    <p class="agos-form__delivery-note">
      Submissions are securely delivered by FormSubmit, a trusted third-party form delivery provider. Your information is used only to conduct and deliver your analysis.
    </p>
    <p class="agos-form__note">
      Manually reviewed &middot; Confidential opportunity analysis &middot; No obligation
    </p>
  </div>
</form>

<style>
  .agos-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .agos-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 560px) {
    .agos-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .agos-form__field {
    display: flex;
    flex-direction: column;
  }

  .agos-form__submit {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding-top: 0.5rem;
  }

  .agos-form__delivery-note {
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    line-height: 1.6;
    margin: 0;
    padding: 0.75rem 1rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: var(--radius-md);
  }

  .agos-form__note {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--text-tertiary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }
</style>

<!-- Progressive enhancement: set _next to origin + /thank-you/ at runtime -->
<script>
  (function() {
    const nextField = document.getElementById('form-next-field');
    if (nextField) {
      nextField.value = window.location.origin + '/thank-you/';
    }
  })();
</script>
