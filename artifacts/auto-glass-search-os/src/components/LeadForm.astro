---
interface Props {
  minimal?: boolean;
}

const { minimal = false } = Astro.props;
---

<form
  method="POST"
  action="/visibility-analysis/"
  class="agos-form"
  data-lead-form
  data-analytics-event="visibility_analysis_form"
  novalidate
>
  <!-- Step 1: Contact & Company Profile -->
  <div class="agos-form__row">
    <div class="agos-form__field">
      <label for="fullName" class="form-label">
        Your Name <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="text"
        id="fullName"
        name="fullName"
        required
        autocomplete="name"
        placeholder="e.g. Marcus Vance"
        class="form-input"
        aria-required="true"
      />
    </div>
    <div class="agos-form__field">
      <label for="companyName" class="form-label">
        Company Name <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="text"
        id="companyName"
        name="companyName"
        required
        autocomplete="organization"
        placeholder="e.g. Apex Auto Glass &amp; ADAS"
        class="form-input"
        aria-required="true"
      />
    </div>
  </div>

  <div class="agos-form__row">
    <div class="agos-form__field">
      <label for="website" class="form-label">
        Website URL <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="url"
        id="website"
        name="website"
        required
        autocomplete="url"
        placeholder="https://yourglasscompany.com"
        class="form-input"
        aria-required="true"
      />
    </div>
    <div class="agos-form__field">
      <label for="email" class="form-label">
        Business Email <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder="owner@yourglasscompany.com"
        class="form-input"
        aria-required="true"
      />
    </div>
  </div>

  <div class="agos-form__row">
    <div class="agos-form__field">
      <label for="phone" class="form-label">
        Direct Phone <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        autocomplete="tel"
        placeholder="(555) 000-0000"
        class="form-input"
        aria-required="true"
      />
    </div>
    <div class="agos-form__field">
      <label for="locations" class="form-label">
        Number of Locations / Mobile Bases
      </label>
      <select
        id="locations"
        name="locations"
        class="form-select"
      >
        <option value="1">1 Facility / Mobile Hub</option>
        <option value="2-3">2 - 3 Locations</option>
        <option value="4-10">4 - 10 Locations</option>
        <option value="10+">10+ Regional Group</option>
      </select>
    </div>
  </div>

  <div class="agos-form__row">
    <div class="agos-form__field">
      <label for="interest" class="form-label">
        Engagement Interest
      </label>
      <select
        id="interest"
        name="interest"
        class="form-select"
      >
        <option value="Managed Search OS">Managed Search OS — We run it for you</option>
        <option value="Search OS + Team">Search OS + Team — We build it with your team</option>
        <option value="Not sure">Not sure yet</option>
      </select>
    </div>
    <div class="agos-form__field">
      <label for="investment" class="form-label">
        Monthly Marketing Budget
      </label>
      <select
        id="investment"
        name="investment"
        class="form-select"
      >
        <option value="Under $3,000">Under $3,000 / month</option>
        <option value="$3,000-$5,000" selected>$3,000 – $5,000 / month</option>
        <option value="$5,000-$10,000">$5,000 – $10,000 / month</option>
        <option value="$10,000-$25,000">$10,000 – $25,000 / month</option>
        <option value="$25,000+">$25,000+ / month</option>
      </select>
    </div>
  </div>

  {!minimal && (
    <div class="agos-form__field">
      <label for="markets" class="form-label">
        Primary Service Areas / Metro Markets <span class="required" aria-label="required">*</span>
      </label>
      <input
        type="text"
        id="markets"
        name="markets"
        required
        placeholder="e.g. Phoenix Metro, Scottsdale, Mesa, Chandler"
        class="form-input"
        aria-required="true"
      />
    </div>
  )}

  <div class="agos-form__submit">
    <button
      type="submit"
      data-analytics-event="visibility_analysis_submit"
      class="btn btn--primary btn--full btn--lg"
    >
      Get Complimentary Visibility Analysis
    </button>
    <p class="agos-form__note">
      Manually reviewed &middot; Confidential opportunity analysis
    </p>
    <p
      class="agos-form__integration-msg"
      role="alert"
      tabindex="-1"
      data-integration-message
      hidden
    >
      Online delivery is not configured yet. Please email
      <a href="mailto:valentina@alignedgrowthdigital.com?subject=Search%20%2B%20AI%20Visibility%20Analysis">
        valentina@alignedgrowthdigital.com
      </a>
      to request your analysis.
    </p>
  </div>
</form>

<style>
  .agos-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .agos-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 560px) {
    .agos-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .agos-form__field {
    display: flex;
    flex-direction: column;
  }

  .agos-form__submit {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }

  .agos-form__note {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    letter-spacing: 0.04em;
    margin: 0;
  }

  .agos-form__integration-msg {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--blue-light);
    line-height: 1.6;
    margin: 0;
  }

  .agos-form__integration-msg[hidden] {
    display: none;
  }

  .agos-form__integration-msg a {
    color: var(--blue-hover);
    text-decoration: underline;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-lead-form]');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const message = form.querySelector<HTMLElement>('[data-integration-message]');
    if (message) {
      message.hidden = false;
      message.focus();
    }
  });
</script>
