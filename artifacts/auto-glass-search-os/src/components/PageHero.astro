---
/**
 * PageHero — shared hero for interior service pages (single H1 per page).
 */
interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  lead: string;
  ctaLabel: string;
  ctaHref?: string;
  ctaEvent?: string;
  supportLine?: string;
}

const {
  id,
  eyebrow,
  heading,
  lead,
  ctaLabel,
  ctaHref = "/visibility-analysis/",
  ctaEvent = "primary_cta_click",
  supportLine
} = Astro.props;
---

<section class="page-hero" aria-labelledby={`${id}-heading`}>
  <div class="container">
    <div class="page-hero__content">
      <span class="eyebrow">{eyebrow}</span>
      <h1 id={`${id}-heading`} class="page-hero__heading text-balance">{heading}</h1>
      <p class="page-hero__lead">{lead}</p>
      <slot />
      <div class="page-hero__cta">
        <a href={ctaHref} data-analytics-event={ctaEvent} class="btn btn--primary btn--lg">{ctaLabel}</a>
        {supportLine && <p class="page-hero__support">{supportLine}</p>}
      </div>
    </div>
  </div>
</section>

<style>
  .page-hero {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background-color: var(--surface-00);
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background: radial-gradient(ellipse at 80% 30%, rgba(30,64,175,0.1) 0%, transparent 65%);
    pointer-events: none;
  }

  .page-hero__content {
    position: relative;
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-hero__heading {
    font-size: clamp(2rem, 4vw + 0.5rem, 3.25rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 0;
  }

  .page-hero__lead {
    font-size: clamp(1rem, 1.5vw + 0.25rem, 1.1875rem);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 44rem;
    margin: 0;
  }

  .page-hero__cta {
    padding-top: 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .page-hero__support {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0;
  }
</style>
