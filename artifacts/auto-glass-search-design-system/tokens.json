  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "system-ui", "sans-serif"],
        "$description": "Primary face for headings, body, navigation, controls, and forms."
      },
      "serif": {
        "$value": ["Georgia", "serif"],
        "$description": "Reserved fallback; not part of the core brand expression."
      },
      "mono": {
        "$value": ["IBM Plex Mono", "ui-monospace", "monospace"],
        "$description": "Sparse technical accent for eyebrow labels, methodology numbers, and annotations."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.375rem",
      "$description": "Restrained six-pixel base radius for precise B2B interfaces."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Eight-pixel base spacing unit."
    }
  }
}