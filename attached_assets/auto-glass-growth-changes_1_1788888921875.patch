+  {
+    key: "digital",
+    label: "Path A · Digital",
+    icon: "click",
+    steps: ["Search", "Landing page", "Online quote", "Availability", "Book"],
+  },
+  {
+    key: "phone",
+    label: "Path B · Phone",
+    icon: "phone",
+    steps: ["Search", "Call", "Human or AI-assisted response", "Schedule", "Book"],
+  },
+];
+---
+
+<div class:list={["paths", { "paths--compact": compact }]}>
+  {paths.map((p) => (
+    <div class:list={["path", `path--${p.key}`]}>
+      <div class="path__label">
+        <span class="path__icon" aria-hidden="true">
+          {p.icon === "phone" ? (
+            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 1h3l1.5 3.5-2 1.5A8 8 0 0 0 9 9.5l1.5-2L14 9v3a1 1 0 0 1-1 1A11 11 0 0 1 2 2a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
+          ) : (
+            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 2l8 4-3.5 1L6 10.5 3 2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
+          )}
+        </span>
+        <span>{p.label}</span>
+      </div>
+      <ol class="path__steps" aria-label={p.label}>
+        {p.steps.map((s, i) => (
+          <li class:list={["path__step", { "path__step--final": i === p.steps.length - 1 }]}>
+            <span class="path__step-text">{s}</span>
+          </li>
+        ))}
+      </ol>
+    </div>
+  ))}
+  <p class="paths__disclosure">
+    Specialized quoting, scheduling and AI Voice capabilities available through our auto glass technology partner. Auto Glass Search OS owns the strategy, conversion analysis, implementation coordination and measurement; the partner provides the underlying technology, where supported and depending on implementation.
