+---
+/**
+ * HeroSystemVisual — a product-style visualization of the Search OS journey:
+ * customer search → FOUND → TRUSTED → CHOSEN (call / quote → book) → MEASURED.
+ * Pure CSS/HTML, no performance numbers, works stacked on mobile.
+ */
+---
+
+<div class="sysvis" aria-label="How the Auto Glass Search OS turns a customer search into a booked job">
+  <div class="sysvis__chrome" aria-hidden="true">
+    <span class="sysvis__chrome-dot"></span>
+    <span class="sysvis__chrome-label">Auto Glass Search OS</span>
+    <span class="sysvis__chrome-status"><span class="sysvis__pulse"></span>Journey view</span>
+  </div>
+
+  <!-- Customer search -->
+  <div class="sysvis__search">
+    <span class="sysvis__search-icon" aria-hidden="true">
+      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M9.5 9.5L13 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
+    </span>
+    <span class="sysvis__search-text">windshield replacement near me</span>
+    <span class="sysvis__search-loc">Your market</span>
+  </div>
+
+  <ol class="sysvis__stages">
+    <li class="sysvis__stage">
+      <div class="sysvis__stage-head">
+        <span class="sysvis__stage-num">01</span>
+        <span class="sysvis__stage-name">Found</span>
+      </div>
+      <ul class="sysvis__chips" aria-label="Where the customer finds you">
+        <li>Google</li><li>Maps</li><li>Ads</li><li>AI search</li>
+      </ul>
+    </li>
+
+    <li class="sysvis__stage">
+      <div class="sysvis__stage-head">
+        <span class="sysvis__stage-num">02</span>
+        <span class="sysvis__stage-name">Trusted</span>
+      </div>
+      <ul class="sysvis__chips" aria-label="Why the customer chooses you">
+        <li>Reviews</li><li>Insurance</li><li>Warranty</li><li>ADAS</li>
+      </ul>
+    </li>
+
+    <li class="sysvis__stage sysvis__stage--chosen">
+      <div class="sysvis__stage-head">
+        <span class="sysvis__stage-num">03</span>
+        <span class="sysvis__stage-name">Chosen</span>
+      </div>
+      <div class="sysvis__paths">
+        <div class="sysvis__path">
+          <span class="sysvis__path-btn sysvis__path-btn--call">
+            <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 1h3l1.5 3.5-2 1.5A8 8 0 0 0 9 9.5l1.5-2L14 9v3a1 1 0 0 1-1 1A11 11 0 0 1 2 2a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
+            Call
+          </span>
+          <span class="sysvis__path-steps"><span>Answered</span><span>Scheduled</span></span>
+        </div>
+        <span class="sysvis__path-or" aria-hidden="true">or</span>
+        <div class="sysvis__path">
+          <span class="sysvis__path-btn">Get quote</span>
+          <span class="sysvis__path-steps"><span>Estimate</span><span>Available times</span><span>Book</span></span>
+        </div>
+      </div>
+    </li>
+
+    <li class="sysvis__stage sysvis__stage--measured">
+      <div class="sysvis__stage-head">
+        <span class="sysvis__stage-num">04</span>
