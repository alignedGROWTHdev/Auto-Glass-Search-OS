+    border-left: 3px solid var(--laser-cyan);
+    border-radius: var(--radius-lg);
+    padding: 1.25rem 1.5rem;
+    margin: 1.5rem 0;
+  }
+
+  .prose :global(.callout p) {
+    margin: 0;
